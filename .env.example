# Neon pooled connection used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?sslmode=require"

# Neon direct connection used only by Drizzle migrations.
DATABASE_URL_DIRECT="postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require"

# Server-only bearer token required by POST /api/radar/collect.
RADAR_COLLECTOR_SECRET="replace-with-a-long-random-secret"

# Server-only Gemini configuration for editorial evaluation.
GEMINI_API_KEY="replace-with-a-google-ai-studio-key"
GEMINI_MODEL="gemini-3.7-flash"
CREATIVE_GEMINI_MODEL="gemini-3.7-flash"

# Creative Studio uses Gemini by default. Set to "groq" to bypass Gemini and
# use Groq directly; with the default, Groq is an automatic fallback for a
# Gemini request failure (including 400, quota/rate, or token/context limits).
# When configured, Workers AI is the final fallback after Groq.
CREATIVE_TEXT_PROVIDER="gemini"
# Optional fallback for Creative Studio only.
GROQ_API_KEY=""
CREATIVE_GROQ_MODEL="openai/gpt-oss-20b"
# Optional final fallback. Use a token scoped to Account > Workers AI.
CLOUDFLARE_AI_ACCOUNT_ID=""
CLOUDFLARE_AI_API_TOKEN=""
CLOUDFLARE_AI_MODEL="@cf/zai-org/glm-4.7-flash"
CREATIVE_MAX_RUNS_PER_DAY="20"
CREATIVE_MAX_CONTENT_CHARACTERS="15000"

# Server-only fal.ai configuration for creative assets. Carousel slides export at 1080x1350.
FAL_KEY="replace-with-a-fal-key"
FAL_IMAGE_MODEL="openai/gpt-image-2"

# Server-only Cloudflare R2 object storage. Create an R2 API token with
# Object Read & Write scoped to this bucket; never prefix these with NEXT_PUBLIC_.
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_BUCKET=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
# Copy the S3 API endpoint shown by Cloudflare, without a bucket path.
# Example: https://ACCOUNT_ID.eu.r2.cloudflarestorage.com
CLOUDFLARE_R2_ENDPOINT=""
# Use default unless the bucket was created in a specific jurisdiction: eu, fedramp, or us.
CLOUDFLARE_R2_JURISDICTION="default"
CLOUDFLARE_R2_OBJECT_PREFIX="story-radar"

# Application-enforced daily AI budget (resets at 00:00 UTC).
AI_MAX_RUNS_PER_DAY="6"
AI_MAX_STORIES_PER_RUN="10"
AI_MAX_STORIES_PER_DAY="60"
AI_MAX_CONTENT_CHARS="500"
AI_CANDIDATE_MAX_AGE_HOURS="72"
AI_MIN_LOCAL_SCORE="35"

# Optional selected-story fallback. Enabled by default; set false to avoid
# sending blocked public article URLs to Jina Reader. A key raises its rate limit.
ARTICLE_READER_FALLBACK_ENABLED="true"
JINA_API_KEY=""
