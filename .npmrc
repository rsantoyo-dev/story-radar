# better-auth declares optional peers (SvelteKit, Vue, Solid, ...) that npm 10
# still tries to resolve; SvelteKit's transitive Vite 8 requirement conflicts
# with the Vite 7 peer of vite-plugin-uxdsl. This Next.js app uses neither, so
# legacy peer resolution is safe and keeps `npm ci` on Vercel identical to local.
legacy-peer-deps=true
