# Production models and options. Copy to .env.vercel and edit that file.
# npm run env:vercel:check   checks against the last verified sync
# npm run env:vercel:sync    saves these values to Vercel Production
# npm run deploy:vercel     syncs first, then deploys the current code
# Next.js does not load .env.vercel; .env.local remains local development.
# Keep credentials, database URLs, RADAR_APP_URL and worker URLs in Vercel.
# Production RADAR_APP_URL is https://story-radar.vercel.app, never a tunnel.

# Worker secrets configured separately in Vercel Production.
# Reference only: the sync script does not manage these variables.
# AUTO_COLLECTION_WORKER_SECRET="<set in Vercel Production and GitHub Actions secrets>"
# INSTAGRAM_METRICS_WORKER_SECRET="<set in Vercel Production and GitHub Actions secrets>"
# INSTAGRAM_PUBLISH_WORKER_SECRET="<set in Vercel Production and GitHub Actions secrets>"

# Active single-shot pipeline: independent Gemini critic, Luna repair loop.
CREATIVE_SINGLE_SHOT_ENABLED="true"
CREATIVE_CAROUSEL_WRITER_MODEL="gpt-6.1-sol"
CREATIVE_SINGLE_SHOT_REPAIR_MODEL="gpt-6-luna"
CREATIVE_TEXT_PROVIDER="gemini"
GEMINI_MODEL="gemini-3.8-flash"
CREATIVE_GROQ_MODEL="openai/gpt-oss-20b"
CLOUDFLARE_AI_MODEL="@cf/zai-org/glm-4.7-flash"

# Draft 2 (second pipeline, built step by step): Claude is its independent
# evaluator. ANTHROPIC_API_KEY stays in Vercel; only the model syncs.
CREATIVE_ANTHROPIC_MODEL="claude-sonnet-5-5"

# Legacy multi-step pipeline; inactive while single-shot is enabled.
CREATIVE_CRITIC_MODEL="gpt-6.1-sol"
CREATIVE_MINOR_REPAIR_MODEL="gpt-6.1-sol"
CREATIVE_STRUCTURAL_REPAIR_MODEL="gpt-6.1-sol"
CREATIVE_SEVERE_REPAIR_MODEL="gpt-6-luna"

# Add other supported non-secret options as needed; see docs/vercel-environment.md.
