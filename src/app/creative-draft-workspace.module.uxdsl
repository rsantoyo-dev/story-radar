.backdrop {
  position: fixed;
  z-index: 80;
  inset: 0;
  display: grid;
  place-items: center;
  padding: xs(density(3)) md(density(6));
  background: palette(dark-main, 0.66);
  backdrop-filter: blur(8px);
}

.workspace {
  @ds-surface (card);
  display: flex;
  overflow: hidden;
  flex-direction: column;
  width: min(1180px, 100%);
  max-height: xs(calc(100svh - 20px)) md(calc(100svh - 48px));
  border-radius: radius(4);
  box-shadow: shadow(overlay);
}

.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: density(6);
  padding: xs(density(5)) md(density(6));
  border-bottom: border(subtle);
  background: palette(light-light);
}

.header p,
.sectionHeading span,
.recommendation span,
.briefCopy span {
  margin: 0 0 space(2);
  color: palette(tertiary-main);
  @ds-typo (badge);
}

.header h2 {
  max-width: 900px;
  margin: 0;
  color: palette(dark-main);
  @ds-typo (title-lg);
}

.header > button {
  @ds-button (secondary);
  width: 36px;
  height: 36px;
  border: border(subtle);
  border-radius: radius(circle);
  @ds-typo (icon-lg);
}

.body {
  overflow: auto;
  padding: xs(density(5)) md(density(6));
}

.loading {
  min-height: 260px;
  padding: density(8);
  color: palette(tertiary-main);
}

.progress {
  display: flex;
  align-items: xs(stretch) sm(center);
  flex-direction: xs(column) sm(row);
  gap: density(3);
  margin-bottom: density(5);
}

.progressStep {
  @ds-surface (card);
  display: flex;
  align-items: center;
  gap: density(3);
  padding: density(3) density(4);
  border-radius: radius(pill);
  color: palette(tertiary-main);
  @ds-typo (meta-strong);
}

.progressStep span {
  display: grid;
  width: 20px;
  height: 20px;
  place-items: center;
  border-radius: radius(circle);
  background: palette(light-light);
  @ds-typo (fine);
}

.progressActive {
  border-color: palette(primary-main);
  color: palette(primary-dark);
}

.progressComplete span {
  background: palette(surface-light);
  color: palette(primary-dark);
}

.notice,
.error,
.warning {
  margin: 0 0 space(5);
  padding: density(4) density(5);
  border-radius: radius(3);
  @ds-typo (caption);
}

.notice {
  border: border(primary-soft);
  background: palette(light-light);
  color: palette(primary-dark);
}

.error {
  border: border(error);
  background: palette(light-light);
  color: palette(error-dark);
}

.error strong,
.error p {
  margin: 0;
}

.error p {
  margin-top: density(1);
}

.warning {
  border: border(warning);
  background: palette(light-light);
  color: palette(warning-dark);
}

.profilePanel {
  @ds-surface (panel);
  border-radius: radius(3);
}

.profilePanel summary {
  @ds-button (link);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: density(5);
  padding: density(4) density(5);
  @ds-typo (compact-strong);
  list-style: none;
}

.profilePanel summary::-webkit-details-marker {
  display: none;
}

.profilePanel summary > span:first-child {
  display: flex;
  flex-direction: column;
  gap: density(1);
}

.profilePanel summary small {
  color: palette(tertiary-main);
  @ds-typo (fine);
}

.profileSummaryHead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: density(5);
  padding: density(5);
}

.profileSummaryHead > div {
  display: flex;
  flex-direction: column;
  gap: density(1);
}

.profileSummaryHead strong {
  @ds-typo (eyebrow);
  color: palette(primary-dark);
}

.profileSummaryHead small {
  @ds-typo (fine);
  color: palette(tertiary-main);
}

.profileSummaryLink {
  @ds-surface (card);
  flex: 0 0 auto;
  padding: density(2) density(3);
  border-radius: radius(full);
  color: palette(primary-main);
  @ds-typo (meta-strong);
  text-decoration: none;
  white-space: nowrap;
}

.profileSummaryLink:hover,
.profileSummaryLink:focus-visible {
  border-color: palette(primary-main);
  outline: 0;
}

.profileSummaryGrid {
  display: grid;
  min-width: 0;
  grid-template-columns: xs(minmax(0, 1fr)) sm(repeat(2, minmax(0, 1fr)));
  gap: density(3) density(5);
  padding: 0 density(5) density(5);
}

.profileSummaryGrid > label,
.editorialDirectionPanel > label { min-width: 0; }
.profileSummaryGrid select,
.editorialDirectionPanel select { width: 100%; min-width: 0; max-width: 100%; }

.profileBody {
  display: grid;
  min-width: 0;
  gap: density(4);
  margin: 0;
  padding: density(5);
  border: 0;
  border-top: border(1);
}

/* Grouped creative-profile panel: a stack of disclosure cards, no fieldset chrome. */
.profileBodyPlain {
  display: grid;
  min-width: 0;
  gap: density(4);
  margin: 0;
  padding: 0;
  border: 0;
}

.profileSaveBar {
  position: sticky;
  bottom: 0;
  z-index: 2;
  min-width: 0;
  padding: density(3);
  border-top: border(control);
  background: palette(light-light);
  box-shadow: shadow(1);
}

.profileGuideHint {
  margin: calc(density(3) * -1) 0 0;
  color: palette(tertiary-main);
  @ds-typo (caption);
}

.carouselChromePanel {
  @ds-surface(flat neutral 4);
  border-radius: radius(3);
  box-shadow: shadow(1);
  display: grid;
  gap: density(4);
  padding: density(4);
  border: border(1);
  border-radius: radius(3);
  background: palette(surface-light);
  box-shadow: shadow(1);
}

.carouselChromeControls {
  display: grid;
  gap: density(4);
  margin: 0;
  padding: 0;
  border: 0;
}

.carouselChromeControls:disabled {
  opacity: 0.65;
}

.paletteGrid {
  display: grid;
  grid-template-columns: xs(1fr) md(repeat(2, minmax(0, 1fr)));
  gap: density(2);
}

.paletteColor {
  @ds-surface(flat light 2);
  display: grid;
  grid-template-columns: density(7) minmax(0, 1fr) auto;
  align-items: center;
  gap: density(2);
  padding: density(2);
  border: border(1);
  border-radius: radius(2);
  background: palette(light-light);
}

.paletteColor input[type="color"] {
  width: density(7);
  height: density(7);
  padding: 0;
  border: 0;
  border-radius: radius(1);
  cursor: pointer;
}

.paletteColor input:not([type="color"]) {
  @ds-input(outlined neutral 2);
  border-radius: radius(1);
  min-width: 0;
  padding: density(1) density(2);
  @ds-typo(caption);
}

.paletteRoleSelect {
  @ds-input(outlined neutral 2);
  border-radius: radius(1);
  grid-column: 2 / -1;
  min-width: 0;
  @ds-typo(caption);
}

.paletteColor code {
  color: palette(tertiary-dark);
  @ds-typo (fine);
}

.paletteRemove,
.paletteAdd {
  @ds-button(outlined neutral 2);
  border-radius: radius(1);
  width: max-content;
  min-height: density(6);
  @ds-typo (label);
}

.paletteRemove {
  grid-column: 2 / -1;
  justify-self: end;
}

.paletteAdd {
  justify-self: start;
}

.carouselChromeOptions {
  display: grid;
  grid-template-columns: xs(1fr) md(1.2fr repeat(3, minmax(0, 1fr)));
  align-items: end;
  gap: density(3);
}

.carouselChromeSelect {
  display: grid;
  gap: density(2);
  color: palette(primary-dark);
  @ds-typo (label);
}

.carouselChromeSelect select {
  @ds-input(outlined neutral 2);
  min-width: 0;
}

.carouselChromePreview {
  @ds-surface(flat light 3);
  border-radius: radius(2);
  display: grid;
  gap: density(2);
  justify-items: start;
  padding: density(3);
  border: border(1);
  border-radius: radius(2);
  background: palette(light-light);
}

.carouselChromePreview > span,
.carouselChromePreview p {
  margin: 0;
  color: palette(tertiary-dark);
  @ds-typo(caption);
}

.carouselChromePreviewImage {
  display: block;
  max-width: 100%;
  height: auto;
  border-radius: radius(1);
}

.carouselChromeStyleGrid {
  display: grid;
  grid-template-columns: xs(repeat(2, minmax(0, 1fr))) md(repeat(4, minmax(0, 1fr)));
  gap: density(2);
}

.carouselChromeStyleOption {
  @ds-button (secondary);
  display: grid;
  gap: density(1);
  justify-items: center;
  min-width: 0;
  padding: density(2);
  border: border(1);
  border-radius: radius(2);
  @ds-typo (label);
}

.carouselChromeStyleOption:hover {
  border-color: palette(primary-main);
}

.carouselChromeStyleSelected {
  border: border(2);
  background: palette(primary-light);
}

.brandUiPreview {
  display: grid;
  gap: density(2);
  margin-top: density(2);
}

.brandUiPreviewLabel {
  color: palette(tertiary-dark);
  @ds-typo (eyebrow);
}

.brandUiFrame {
  display: grid;
  grid-template-rows: auto 1fr;
  overflow: hidden;
  border: border(1);
  border-radius: radius(2);
  box-shadow: shadow(1);
}

.brandUiNav {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: density(3);
  padding: density(2) density(3);
  @ds-typo(caption);
}

.brandUiNav strong {
  @ds-typo (label);
}

.brandUiMain {
  padding: density(3);
}

.brandUiCard {
  display: grid;
  gap: density(1);
  padding: density(3);
  border: border(1);
  border-radius: radius(2);
}

.brandUiCard strong {
  @ds-typo (body-strong);
}

.brandUiCard p {
  margin: 0;
  @ds-typo(caption);
}

.brandUiRow {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: density(2);
  margin-top: density(2);
}

.brandUiButton {
  display: inline-flex;
  align-items: center;
  padding: density(1) density(3);
  border: border(1);
  border-radius: radius(1);
  @ds-typo (label);
}

.brandUiBadge {
  display: inline-flex;
  align-items: center;
  padding: density(1) density(2);
  border-radius: radius(full);
  @ds-typo (label);
}

.brandUiInput {
  display: block;
  margin-top: density(2);
  padding: density(1) density(2);
  border: border(1);
  border-radius: radius(1);
  @ds-typo(caption);
}

.brandUiChecks {
  display: flex;
  flex-wrap: wrap;
  gap: density(2);
  margin: 0;
  padding: 0;
  list-style: none;
}

.brandUiCheck {
  display: inline-flex;
  align-items: center;
  gap: density(1);
  padding: density(1) density(2);
  border: border(1);
  border-radius: radius(full);
  color: palette(tertiary-dark);
  @ds-typo(caption);
}

.brandUiCheck[data-pass="false"] {
  @ds-typo (emphasis);
  border-color: palette(secondary-main);
}

.brandUiCheck code {

  @ds-typo (fine);
}

.brandUiWarnings {
  @ds-surface (card);
  display: grid;
  gap: density(1);
  margin: 0;
  padding: density(2) density(3);
  border-left: border(2);
  border-radius: radius(1);
  color: palette(tertiary-dark);
  @ds-typo(caption);
}

.brandOverlayPanel {
  @ds-surface(flat neutral 4);
  border-radius: radius(3);
  box-shadow: shadow(1);
  display: grid;
  gap: density(4);
  padding: density(4);
  border: border(1);
  border-radius: radius(3);
  background: palette(surface-light);
  box-shadow: shadow(1);
}

.brandOverlayHeader {
  display: flex;
  align-items: xs(stretch) sm(center);
  justify-content: space-between;
  flex-direction: xs(column) sm(row);
  gap: density(3);
}

.brandOverlayHeader strong {
  display: block;
  color: palette(primary-dark);
  @ds-typo (label);
}

.brandOverlayHeader p {
  max-width: 660px;
  margin: density(1) 0 0;
  color: palette(tertiary-dark);
  @ds-typo(caption);
}

.brandEnabledToggle {
  @ds-surface(flat light 3);
  border-radius: radius(2);
  display: inline-flex;
  width: max-content;
  align-items: center;
  gap: density(2);
  padding: density(2) density(3);
  border: border(1);
  border-radius: radius(2);
  background: palette(light-light);
  color: palette(primary-dark);
  @ds-typo (label);
  cursor: pointer;
}

.brandEnabledToggle input,
.brandRange input {
  accent-color: palette(primary-main);
}

.brandEnabledToggle:has(input:disabled) {
  cursor: not-allowed;
  opacity: 0.55;
}

.brandOverlayGrid {
  display: grid;
  grid-template-columns: xs(1fr) md(minmax(180px, 0.58fr) minmax(0, 1.42fr));
  gap: density(4);
  align-items: start;
}

/* A status, not an action: a tinted label with a dot, never a filled button shape. */
.metaStatusChip {
  @ds-surface (boxed);
  border: border(1);
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  gap: space(3);
  padding: space(2) space(4);
  border-radius: radius(full);
  color: palette(tertiary-dark);
  @ds-typo (meta-strong);
  white-space: nowrap;
}

.metaStatusChip::before {
  width: 6px;
  height: 6px;
  border-radius: radius(circle);
  background: currentColor;
  content: "";
}

.metaStatusConnected {
  border-color: palette(success-main, 0.35);
  background: palette(success-main, 0.08);
  color: palette(success-dark);
}

.metaStatusWarning {
  border-color: palette(warning-main, 0.45);
  background: palette(warning-main, 0.08);
  color: palette(warning-dark);
}

.metaStatusError {
  border-color: palette(error-main, 0.35);
  background: palette(error-main, 0.06);
  color: palette(error-dark);
}

.metaConnectionBody {
  display: grid;
  gap: density(3);
}

.metaConnectionDetails {
  display: grid;
  grid-template-columns: xs(1fr) sm(repeat(auto-fit, minmax(160px, 1fr)));
  gap: density(2) density(4);
  margin: 0;
}

.metaConnectionDetails > div {
  display: grid;
  gap: density(1);
}

.metaConnectionDetails dt {
  color: palette(tertiary-dark);
  @ds-typo (badge);
}

.metaConnectionDetails dd {
  margin: 0;
  color: palette(primary-dark);
  @ds-typo (label);
}

.metaConnectionActions {
  display: flex;
  flex-wrap: wrap;
  gap: density(2);
}

.metaAppFields {
  display: grid;
  grid-template-columns: xs(1fr) sm(repeat(2, minmax(0, 1fr)));
  gap: density(3);
}

.brandAssetCard {
  @ds-surface(flat light 3);
  border-radius: radius(2);
  display: grid;
  min-width: 0;
  gap: density(3);
  padding: density(3);
  border: border(1);
  border-radius: radius(2);
  background: palette(light-light);
}

.brandAssetPreview {
  @ds-surface (card);
  border: border(1);
  display: grid;
  min-height: density(14);
  overflow: hidden;
  place-items: center;
  padding: density(4);
  border-radius: radius(2);
  background:
    linear-gradient(45deg, palette(surface-light) 25%, transparent 25%),
    linear-gradient(-45deg, palette(surface-light) 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, palette(surface-light) 75%),
    linear-gradient(-45deg, transparent 75%, palette(surface-light) 75%),
    palette(light-light);
  background-position: 0 0, 0 density(2), density(2) calc(density(2) * -1), calc(density(2) * -1) 0;
  background-size: density(4) density(4);
}

.brandAssetPreview img {
  width: 100%;
  max-height: density(14);
  object-fit: contain;
}

.brandAssetPlaceholder {
  display: grid;
  min-height: density(10);
  place-items: center;
  color: palette(tertiary-main);
  @ds-typo(caption);
  text-align: center;
}

.brandAssetMeta {
  display: grid;
  min-width: 0;
  gap: density(1);
}

.brandAssetMeta strong {
  overflow: hidden;
  color: palette(primary-dark);
  @ds-typo(caption);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.brandAssetMeta span,
.brandAssetHint,
.brandEnableHint,
.brandBackdropHint {
  margin: 0;
  color: palette(tertiary-dark);
  @ds-typo(caption);
}

.brandAssetHint,
.brandEnableHint {

  @ds-typo (fine);
}

.brandUpload {
  @ds-button(outlined primary 3);
  border-radius: radius(2);
  display: inline-flex;
  width: max-content;
  max-width: 100%;
  min-height: density(7);
  align-items: center;
  justify-content: center;
  padding: 0 density(4);
  border-radius: radius(2);
  @ds-typo (label);
  cursor: pointer;
}

.brandUpload input {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
}

.brandUpload:focus-within {
  outline: border(focus);
  outline-offset: density(1);
}

.brandUploadDisabled {
  cursor: not-allowed;
  opacity: 0.55;
}

.brandControls {
  display: grid;
  min-width: 0;
  gap: density(4);
  margin: 0;
  padding: 0;
  border: 0;
}

.brandControls:disabled {
  opacity: 0.65;
}

.brandControlGroup,
.brandRange,
.brandColorControl {
  display: grid;
  gap: density(2);
}

.brandControlLabel,
.brandRange > span,
.brandColorControl > span:first-child {
  color: palette(primary-dark);
  @ds-typo (label);
}

.brandSegmented {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: density(2);
}

.brandOptionButton {
  @ds-button(outlined neutral 2);
  min-height: density(7);
  justify-content: center;
  padding: 0 density(3);
  border-radius: radius(2);
  @ds-typo (label);
  cursor: pointer;
}

.brandOptionSelected {
  @ds-button(contained primary 2);
  border: border(1);
}

.brandPlacementGrid {
  display: grid;
  width: min(100%, 220px);
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: density(2);
}

.brandPlacementButton {
  @ds-button(outlined neutral 2);
  position: relative;
  min-height: density(7);
  padding: 0;
  border-radius: radius(2);
  cursor: pointer;
}

.brandPlacementButton::after {
  position: absolute;
  width: density(2);
  height: density(2);
  border-radius: radius(full);
  background: palette(tertiary-main);
  content: "";
}

.brandPlacementButton[data-placement^="top"]::after {
  top: density(2);
}

.brandPlacementButton[data-placement^="center"]::after {
  top: 50%;
  transform: translateY(-50%);
}

.brandPlacementButton[data-placement^="bottom"]::after {
  bottom: density(2);
}

.brandPlacementButton[data-placement$="left"]::after {
  left: density(2);
}

.brandPlacementButton[data-placement$="center"]::after {
  left: 50%;
  transform: translateX(-50%);
}

.brandPlacementButton[data-placement$="right"]::after {
  right: density(2);
}

.brandPlacementButton[data-placement="center"]::after {
  transform: translate(-50%, -50%);
}

.brandPlacementSelected {
  @ds-button(contained primary 2);
  border: border(1);
}

.brandPlacementSelected::after {
  background: palette(primary-contrast);
}

.brandRangeGrid,
.brandBackdropSettings {
  display: grid;
  grid-template-columns: xs(1fr) sm(repeat(2, minmax(0, 1fr)));
  gap: density(4);
}

.brandRange > span {
  display: flex;
  justify-content: space-between;
  gap: density(3);
}

.brandRange input {
  width: 100%;
}

.brandColorPicker {
  @ds-input(outlined neutral 2);
  display: flex;
  min-height: density(7);
  align-items: center;
  gap: density(3);
  padding: density(2) density(3);
  border-radius: radius(2);
  background: palette(light-light);
}

.brandColorPicker input {
  /* uxdsl-exception: a native control or a dismiss area, not an action a Button role styles */
  width: density(7);
  height: density(6);
  padding: 0;
  overflow: hidden;
  border: 0;
  border-radius: radius(1);
  background: transparent;
  cursor: pointer;
}

.brandColorPicker code {
  color: palette(dark-main);
  @ds-typo(code);
}

.brandBackdropHint {
  @ds-surface (boxed);
  border: border(1);
  padding: density(3);
  border-radius: radius(2);
}

.charactersSection {
  display: grid;
  gap: density(4);
  padding-top: density(4);
  border-top: border(subtle);
}

.charactersHeading,
.characterSlot > header,
.characterReferencesHeading,
.referenceItem figcaption {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: density(3);
}

.charactersHeading strong,
.characterSlot > header strong {
  color: palette(primary-dark);
  @ds-typo (meta);
}

.charactersHeading p,
.referenceEmpty {
  margin: density(1) 0 0;
  color: palette(tertiary-main);
  @ds-typo (fine);
}

.charactersHeading small,
.characterReferencesHeading small {
  color: palette(tertiary-main);
  @ds-typo (fine-strong);
}

.characterGrid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: density(4);
}

.characterSlot {
  @ds-surface (card);
  display: grid;
  align-content: start;
  gap: density(3);
  padding: density(4);
  border-radius: radius(2);
}

.characterSlot > header span,
.characterReferencesHeading > span {
  display: block;
  margin-bottom: density(1);
  color: palette(tertiary-main);
  @ds-typo (badge);
}

.characterRemoveButton,
.referenceItem button {
  @ds-button (link-danger);
  font: inherit;
  @ds-typo (fine-strong);
}

.characterRemoveButton:disabled,
.referenceItem button:disabled {
  cursor: not-allowed;
  opacity: 0.45;
}

.characterReferences {
  display: grid;
  gap: density(3);
}

.referenceGrid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: density(3);
}

.referenceItem {
  @ds-surface (card);
  min-width: 0;
  margin: 0;
  overflow: hidden;
  border-radius: radius(2);
}

.referenceItem img,
.referencePreviewPlaceholder {
  display: grid;
  width: 100%;
  aspect-ratio: 1;
  place-items: center;
  background: palette(light-light);
  color: palette(tertiary-main);
  @ds-typo (fine);
  object-fit: cover;
}

.referenceItem figcaption {
  padding: density(2) density(2);
  gap: density(2);
}

.referenceItem figcaption span {
  overflow: hidden;
  color: palette(tertiary-main);
  @ds-typo (fine);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.referenceItem figcaption button {
  flex: 0 0 auto;
  @ds-typo (fine);
}

.referenceUpload {
  @ds-button (secondary);
  display: inline-flex;
  width: max-content;
  max-width: 100%;
  min-height: 31px;
  align-items: center;
  padding: 0 space(4);
  border: border(dashed-primary);
  border-radius: radius(2);
  @ds-typo (fine-strong);
}

.referenceUpload input {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
}

.referenceUploadDisabled {
  cursor: not-allowed;
  opacity: 0.45;
}

.fieldGrid {
  display: grid;
  grid-template-columns: xs(1fr) md(repeat(2, minmax(0, 1fr)));
  gap: density(4);
}

.field {
  display: flex;
  flex-direction: column;
  gap: density(2);
}

.field > span,
.factPicker legend {
  color: palette(primary-dark);
  @ds-typo (fine-strong);
}

.field input,
.field textarea,
.field select,
.emojiRow input[type="number"] {
  @ds-input (field);
  width: 100%;
  /* surface-light sits too close to the page background to read as a field edge. */
  border-radius: radius(2);
  outline: none;
  color: palette(dark-main);
  font: inherit;
  @ds-typo (caption);
}

.field input,
.field select,
.emojiRow input[type="number"] {
  height: 38px;
  padding: 0 space(4);
}

.field input[type="checkbox"] {
  width: 18px;
  height: 18px;
  padding: 0;
  accent-color: palette(primary-main);
}

.field textarea {
  min-height: 66px;
  padding: density(3) density(4);
  resize: vertical;
}

.field input:focus,
.field textarea:focus,
.field select:focus {
  border-color: palette(primary-main);
  box-shadow: shadow(ring);
}

.sliders {
  display: grid;
  grid-template-columns: xs(1fr) sm(repeat(2, 1fr)) md(repeat(5, 1fr));
  gap: density(4);
  padding: density(4);
  border-radius: radius(3);
  background: palette(light-light);
}

.sliders label {
  display: flex;
  flex-direction: column;
  gap: density(2);
  color: palette(primary-main);
  @ds-typo (fine-strong);
}

.sliders label span {
  display: flex;
  justify-content: space-between;
}

.sliders input {
  accent-color: palette(primary-dark);
}

.emojiRow {
  display: flex;
  align-items: center;
  gap: density(6);
  color: palette(primary-dark);
  @ds-typo (meta-strong);
}

.emojiRow label {
  display: flex;
  align-items: center;
  gap: density(3);
}

.emojiRow input[type="number"] {
  width: 72px;
}

.section {
  @ds-surface (card);
  margin-top: density(5);
  padding: density(5);
  border-radius: radius(4);
}

.sectionHeading {
  display: flex;
  align-items: xs(flex-start) sm(center);
  flex-direction: xs(column) sm(row);
  justify-content: space-between;
  gap: density(5);
  margin-bottom: density(5);
}

.sectionHeading h3 {
  margin: 0;
  color: palette(dark-main);
  @ds-typo (title);
}

.budget,
.statusPill {
  padding: density(2) density(3);
  border-radius: radius(pill);
  background: palette(light-light);
  color: palette(primary-main);
  @ds-typo (fine-strong);
}

.statusApproved {
  background: palette(surface-light);
  color: palette(primary-dark);
}

.briefCallout,
.generateDraftCard {
  @ds-surface (dropzone);
  display: flex;
  align-items: xs(stretch) md(center);
  flex-direction: xs(column) md(row);
  justify-content: space-between;
  gap: density(6);
  padding: density(5);
  border-radius: radius(3);
}

.briefCallout strong,
.generateDraftCard strong {
  color: palette(primary-dark);
  @ds-typo (caption);
}

.briefCallout p,
.generateDraftCard p {
  margin: density(2) 0 0;
  color: palette(tertiary-main);
  @ds-typo (meta);
}

.editorialDirectionPanel {
  @ds-surface(flat neutral);
  border-radius: radius(3);
  display: grid;
  min-width: 0;
  gap: density(2);
  padding: density(4);
  border: border(1);
}

.editorialDirectionPanel > p {
  margin: 0;
  color: palette(tertiary-main);
  @ds-typo(caption);
}

.historyPanel {
  @ds-surface (card);
  margin-top: density(5);
  border-radius: radius(3);
}

.historyPanel summary {
  @ds-button (link);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: density(5);
  padding: density(4) density(5);
  list-style: none;
}

.historyPanel summary::-webkit-details-marker {
  display: none;
}

.historyPanel summary > span:first-child,
.historyList button > span:first-child {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: density(1);
}

.historyPanel summary strong,
.historyList button strong {
  @ds-typo (meta);
}

.historyPanel summary small,
.historyList button small {
  color: palette(tertiary-main);
  @ds-typo (fine-strong);
}

.historyPanel summary > span:last-child,
.historyList button > span:last-child {
  flex: 0 0 auto;
  color: palette(primary-main);
  @ds-typo (fine-strong);
}

.historyList {
  display: grid;
  gap: density(3);
  padding: 0 space(4) space(4);
}

.historyList button {
  @ds-button (secondary);
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: density(4);
  padding: density(4) density(4);
  border: border(subtle);
  border-radius: radius(2);
  text-align: left;
}

.historyList button strong,
.historyList button small {
  overflow-wrap: anywhere;
}

.historyList button:hover,
.historyList button:focus-visible,
.historyList button.historySelected {
  border-color: palette(primary-main);
  background: palette(light-light);
}

.historyCallout {
  @ds-surface (callout);
  display: flex;
  align-items: xs(stretch) md(center);
  flex-direction: xs(column) md(row);
  justify-content: space-between;
  gap: density(5);
  margin-bottom: density(5);
  padding: density(4) density(5);
  border-radius: radius(3);
}

.historyCallout strong {
  color: palette(primary-dark);
  @ds-typo (caption);
}

.historyCallout p {
  margin: density(2) 0 0;
  color: palette(primary-main);
  @ds-typo (fine);
}

.historyActions {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: density(3);
  width: xs(100%) md(auto);
}

.historyActions button {
  flex: xs(1) md(0 0 auto);
}

.historicalDraftDetails {
  @ds-surface (card);
  display: grid;
  gap: density(4);
  margin-bottom: density(5);
  padding: density(5);
  border-radius: radius(3);
}

.historicalDraftHeading {
  display: flex;
  flex-direction: xs(column) md(row);
  align-items: xs(stretch) md(flex-start);
  justify-content: space-between;
  gap: density(5);
}

.historicalDraftHeading strong {
  color: palette(primary-dark);
  @ds-typo (caption);
}

.historicalDraftHeading p {
  margin: density(2) 0 0;
  color: palette(tertiary-main);
  @ds-typo (fine);
}

.historicalDraftHeading small {
  flex: 0 0 auto;
  color: palette(primary-main);
  @ds-typo (fine-strong);
}

.historicalRegenerationAction {
  @ds-surface (contained primary 2);
  display: flex;
  flex-direction: xs(column) md(row);
  align-items: xs(stretch) md(center);
  justify-content: space-between;
  gap: density(4);
  padding: density(4);
}

.historicalRegenerationAction strong {
  color: palette(primary-contrast);
  @ds-typo (meta);
}

.historicalRegenerationAction p {
  margin: density(1) 0 0;
  color: palette(primary-contrast);
  @ds-typo (fine);
}

.historicalRegenerationAction button {
  @ds-button (contained light 3);
  border-radius: radius(2);
  flex: 0 0 auto;
}

.historicalRegenerationControls {
  display: grid;
  flex: 0 0 auto;
  gap: density(2);
}

.historicalRegenerationControls small {
  max-width: xs(none) md(320px);
  color: palette(error-light);
  @ds-typo (fine);
}

.historicalDraftFields {
  display: grid;
  grid-template-columns: xs(1fr) md(repeat(2, minmax(0, 1fr)));
  gap: density(4);
}

.readOnlyDraftField {
  display: grid;
  gap: density(2);
}

.readOnlyDraftField > span {
  color: palette(tertiary-main);
  @ds-typo (badge);
}

.readOnlyDraftField textarea {
  @ds-input (field);
  width: 100%;
  min-height: 0;
  resize: vertical;
  border: border(subtle);
  border-radius: radius(2);
  color: palette(dark-main);
  font: inherit;
  @ds-typo (meta);
}

.historicalUnits {
  @ds-surface (card);
  border-radius: radius(2);
}

.historicalUnits summary {
  @ds-button (link);
  padding: density(4) density(4);
  @ds-typo (fine-strong);
}

.historicalUnits > div {
  display: grid;
  gap: density(4);
  padding: 0 space(4) space(4);
}

.historicalUnits article {
  @ds-surface (card);
  display: grid;
  gap: density(3);
  padding: density(4);
  border-radius: radius(2);
}

.historicalUnits article > header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: density(4);
}

.historicalUnits article strong {
  color: palette(primary-dark);
  @ds-typo (meta);
}

.historicalUnits article small {
  color: palette(tertiary-main);
  @ds-typo (fine);
}

.completeScript {
  @ds-surface (flat primary);
  border-radius: radius(3);
  box-shadow: shadow(1);
  overflow: hidden;
}

.completeScript summary {
  @ds-button (link);
  padding: density(4);
  @ds-typo (label);
}

.completeScriptBody {
  display: grid;
  gap: density(3);
  padding: 0 density(4) density(4);
}

.completeScriptHeading {
  display: flex;
  flex-direction: xs(column) md(row);
  align-items: xs(stretch) md(center);
  justify-content: space-between;
  gap: density(3);
}

.completeScriptHeading strong {
  color: palette(primary-dark);
  @ds-typo (label);
}

.completeScriptHeading p {
  margin: density(1) 0 0;
  color: palette(tertiary-main);
  @ds-typo (fine);
}

.completeScript textarea {
  @ds-input (outlined neutral 3);
  border-radius: radius(2);
  width: 100%;
  resize: vertical;
  color: palette(dark-main);
  @ds-typo (fine);
}

.completeScript small {
  color: palette(error-main);
  @ds-typo (fine);
}

.primaryButton,
.secondaryButton,
.approveButton,
.unapproveButton {
  min-height: 38px;
  @ds-typo (button);
}

.primaryButton,
.approveButton {

  @ds-button (primary);
}

.secondaryButton {
  @ds-button (secondary);
  justify-self: start;
  border: border(control);
}

.unapproveButton {

  @ds-button (warning);
}

.primaryButton:disabled,
.secondaryButton:disabled,
.approveButton:disabled,
.unapproveButton:disabled,
.header button:disabled,
.unitActions button:disabled,
.unitsHeading button:disabled {
  cursor: not-allowed;
  opacity: 0.45;
}

.brief {
  display: grid;
  gap: density(5);
  margin-top: density(5);
}

.recommendation {
  display: grid;
  grid-template-columns: xs(1fr) md(0.42fr 1fr);
  gap: density(5);
  padding: density(5);
  border-radius: radius(3);
  background: linear-gradient(135deg, palette(light-light), palette(light-light));
}

.recommendation strong {
  display: block;
  color: palette(dark-main);
  @ds-typo (title-lg);
}

.recommendation small {
  color: palette(tertiary-main);
  @ds-typo (fine);
}

.recommendation p,
.briefCopy p {
  margin: 0;
  color: palette(primary-dark);
  @ds-typo (caption);
}

.briefCopyGrid {
  display: grid;
  grid-template-columns: xs(1fr) md(repeat(2, 1fr));
  gap: density(3);
}

.briefCopy {
  padding: density(4);
  border: border(subtle);
  border-radius: radius(2);
}

.editorialAngle {
  @ds-surface(flat light 3);
  display: grid;
  gap: density(3);
  border: border(subtle);
}

.editorialAngle header {
  display: grid;
  gap: density(1);
}

.editorialAngle header strong {
  @ds-typo(h5);
  color: palette(primary-dark);
}

.editorialAngle header small,
.editorialAngle details small {
  @ds-typo(small);
  color: palette(tertiary-main);
}

.editorialAngle [role="status"] {
  @ds-typo(small);
  margin: 0;
  color: palette(warning-dark);
}

.editorialAngleDefinition {
  @ds-typo(small);
  margin: 0;
  color: palette(tertiary-dark);
}

.editorialAngle details summary {
  @ds-button (link-accent);
  @ds-typo(small);
}

.editorialAngle details p {
  @ds-typo(body);
  margin: density(2) 0 0;
}

.carouselPlanSummary {
  @ds-surface (card);
  border: border(1);
  display: grid;
  gap: density(3);
  padding: density(4);
  border-radius: radius(2);
}

.carouselPlanSummary h4,
.carouselPlanSummary p {
  margin: 0;
}

.carouselPlanSummary h4 {
  color: palette(primary-dark);
  @ds-typo (meta-strong);
}

.carouselPlanSummary p {
  margin-top: density(1);
  color: palette(tertiary-main);
  @ds-typo (fine);
}

.carouselPlanSummary ol {
  display: grid;
  grid-template-columns: xs(1fr) md(repeat(2, minmax(0, 1fr)));
  gap: density(2);
  margin: 0;
  padding: 0;
  list-style: none;
}

.carouselPlanSummary li {
  display: grid;
  gap: density(1);
  padding: density(3);
  border-radius: radius(1);
  background: palette(surface-light);
}

.carouselPlanSummary strong,
.carouselPlanSummary span,
.carouselPlanSummary small {
  @ds-typo (caption);
}

.carouselPlanSummary strong {
  @ds-typo (fine);
  color: palette(primary-dark);
}

.carouselPlanSummary span,
.carouselPlanSummary small {
  @ds-typo (fine);
  color: palette(tertiary-main);
}

.formatOptions {
  display: grid;
  grid-template-columns: xs(1fr) md(repeat(2, 1fr));
  gap: density(3);
}

.formatOptions button {
  @ds-button (secondary);
  display: grid;
  grid-template-columns: 1fr auto;
  gap: density(2) density(5);
  padding: density(4);
  border: border(subtle);
  border-radius: radius(3);
  text-align: left;
}

.formatOptions button > span {
  @ds-typo (meta-strong);
}

.formatOptions button > strong {
  @ds-typo (title);
}

.formatOptions button > small {
  grid-column: 1 / -1;
  color: palette(tertiary-main);
  @ds-typo (fine);
}

.formatOptions .selectedFormat {
  border-color: palette(primary-main);
  background: palette(light-light);
  box-shadow: shadow(ring);
}

.draftSetup {
  @ds-surface (card);
  display: flex;
  align-items: xs(stretch) md(flex-end);
  flex-direction: xs(column) md(row);
  gap: density(5);
  margin-bottom: density(5);
  padding: density(4) density(4);
  border-radius: radius(3);
}

.aspectRatioField {
  flex: 0 0 210px;
  max-width: 100%;
}

.draftSetup p {
  margin: 0 0 space(2);
  color: palette(tertiary-main);
  @ds-typo (fine);
}

.imageQualitySetup {
  @ds-surface (card);
  display: flex;
  align-items: xs(stretch) md(flex-end);
  flex-direction: xs(column) md(row);
  gap: density(5);
  margin-bottom: density(5);
  padding: density(4) density(4);
  border-radius: radius(3);
}

.imageQualityField {
  flex: 0 0 230px;
  max-width: 100%;
}

.imageQualitySetup p {
  margin: 0 0 space(2);
  color: palette(tertiary-main);
  @ds-typo (fine);
}

.factsAndRisks {
  display: grid;
  grid-template-columns: xs(1fr) md(1fr 0.55fr);
  gap: density(4);
}

.factsAndRisks > div {
  padding: density(4);
  border-radius: radius(3);
  background: palette(light-light);
}

.factsAndRisks h4,
.unitsHeading h4 {
  margin: 0 0 space(3);
  color: palette(primary-dark);
  @ds-typo (meta-strong);
}

.factsAndRisks ul {
  display: grid;
  gap: density(2);
  margin: 0;
  padding: 0;
  list-style: none;
}

.factsAndRisks li,
.factsAndRisks p {
  margin: 0;
  color: palette(tertiary-main);
  @ds-typo (fine);
}

.factsAndRisks li small {
  display: block;
  margin-top: density(1);
  color: palette(tertiary-main);
  @ds-typo (fine);
}

.factsAndRisks li span {
  display: inline-block;
  margin-right: density(3);
  padding: density(1) density(2);
  border-radius: radius(1);
  background: palette(surface-light);
  color: palette(primary-dark);
  @ds-typo (fine-strong);
}

.editor {
  display: grid;
  gap: density(4);
}

.unitsHeading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: density(5);
  margin-top: density(2);
}

.unitsHeading h4 {
  margin-bottom: density(1);
}

.unitsHeading p {
  margin: 0;
  color: palette(tertiary-main);
  @ds-typo (fine);
}

.unitsHeading button,
.unitActions button {
  @ds-button (secondary);
  border: border(subtle);
  border-radius: radius(2);
  @ds-typo (fine-strong);
}

.unitsHeading button {
  height: 32px;
  padding: 0 space(4);
}

.units {
  display: grid;
  gap: density(4);
}

.narrativeReview {
  @ds-surface (card);
  padding: density(4);
  border: border(1);
  border-radius: radius(2);
  color: palette(warning-dark);
}

.narrativeReview strong {
  @ds-typo (label);
}

.narrativeReview ul {
  display: grid;
  gap: density(1);
  margin: density(2) 0 0;
  padding-left: density(5);
}

.narrativeReview li {
  @ds-typo (fine);
}

.unit {
  @ds-surface (card);
  display: grid;
  gap: density(4);
  padding: density(5);
  border-radius: radius(3);
}

.unit > header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: density(4);
}

.unit > header > div:first-child {
  display: flex;
  align-items: center;
  gap: density(3);
}

.unit > header span {
  padding: density(2) density(3);
  border-radius: radius(2);
  background: palette(surface-light);
  color: palette(primary-dark);
  @ds-typo (badge);
}

.unit > header strong {
  color: palette(primary-dark);
  @ds-typo (meta);
}

.unitActions {
  display: flex;
  gap: density(2);
}

.unitActions button {
  width: 28px;
  height: 28px;
}

.factPicker {
  display: flex;
  flex-wrap: wrap;
  gap: density(3);
  margin: 0;
  padding: density(3);
  border: border(subtle);
  border-radius: radius(2);
}

.factPicker legend {
  padding: 0 space(2);
}

.factPicker label {
  @ds-button (secondary);
  display: flex;
  align-items: center;
  gap: density(2);
  padding: density(2) density(3);
  border-radius: radius(2);
  @ds-typo (fine-strong);
}

.factPicker input {
  accent-color: palette(primary-dark);
}

.approvalBar {
  display: flex;
  align-items: xs(stretch) md(center);
  flex-direction: xs(column) md(row);
  justify-content: space-between;
  gap: density(6);
  margin-top: density(5);
  padding-top: density(5);
  border-top: border(subtle);
}

.approvalBar > div:first-child {
  display: flex;
  flex-direction: column;
  gap: density(1);
}

.approvalBar strong {
  color: palette(primary-dark);
  @ds-typo (meta);
}

.approvalBar small {
  color: palette(tertiary-main);
  @ds-typo (fine);
}

.approvalBar > div:last-child {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: density(3);
  width: xs(100%) md(auto);
}

.approvalBar button {
  flex: xs(1) md(0 0 auto);
}

.footer {
  display: flex;
  align-items: xs(stretch) md(center);
  flex-direction: xs(column) md(row);
  justify-content: space-between;
  gap: density(5);
  padding: density(5) density(1) 0;
  color: palette(tertiary-main);
  @ds-typo (fine);
}

.footer a {
  color: palette(primary-dark);
  @ds-typo (fine-strong);
  text-decoration: none;
}

.assetLoading {
  padding: density(6);
  border: border(dashed-subtle);
  border-radius: radius(3);
  color: palette(tertiary-main);
  @ds-typo (meta);
  text-align: center;
}

.generateDraftCard .assetVariantHint {
  color: palette(primary-main);
  @ds-typo (fine);
}

.assetWorkspace {
  display: grid;
  gap: density(5);
}

.assetBatchSummary {
  display: flex;
  align-items: xs(stretch) md(center);
  flex-direction: xs(column) md(row);
  justify-content: space-between;
  gap: density(5);
  padding: density(4) density(5);
  border-radius: radius(3);
  background: palette(light-light);
}

.assetBatchSummary strong {
  color: palette(primary-dark);
  @ds-typo (caption);
}

.assetBatchSummary p {
  margin: density(1) 0 0;
  color: palette(tertiary-main);
  @ds-typo (fine);
}

.assetBatchSummary small {
  flex: 0 0 auto;
  color: palette(tertiary-main);
  @ds-typo (fine-strong);
}

.assetGrid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: density(5);
}
.assetGrid > div { min-width: 0; max-width: 780px; }
.assetSelection { display: flex; gap: density(3); overflow-x: auto; padding: density(2); }
.assetSelectionItem { position: relative; flex: 0 0 112px; }
.assetSelectionThumb { @ds-button (secondary); display: grid; width: 100%; gap: density(2); padding: density(2); border: border(subtle); border-radius: radius(2); color: palette(dark-main); text-align: left; }
.assetSelectionThumb[aria-pressed="true"] { border: border(focus); box-shadow: shadow(1); }
.assetSelectionThumb > span:not(.assetSelectionImage):not(.assetSelectionPlaceholder) { @ds-typo (meta-strong); }
.assetSelectionThumb small { color: palette(tertiary-main); @ds-typo (fine); }
.assetSelectionApprove { @ds-button (overlay); position: absolute; top: density(3); right: density(3); display: grid; width: 28px; height: 28px; padding: 0; place-items: center; border-radius: radius(circle); background: palette(dark-main, 0.55); @ds-typo (small-strong); box-shadow: shadow(1); }
.assetSelectionApprove:hover:not(:disabled) { background: palette(success-dark); }
.assetSelectionApproved { background: palette(success-main); border-color: palette(light-light); color: palette(success-contrast); }
.assetSelectionApprove:disabled { opacity: 0.55; cursor: not-allowed; }
@media (pointer: coarse) { .assetSelectionApprove { width: 36px; height: 36px; } }
.assetSelectionImage, .assetSelectionPlaceholder { position: relative; display: grid; width: 100%; aspect-ratio: 4 / 5; place-items: center; overflow: hidden; border-radius: radius(1); background: palette(surface-light); }
.assetSelectionImage img { object-fit: cover; }

.assetActionFeedback { @ds-surface (notice-success); margin: 0; padding: density(2) density(3); border-radius: radius(2); color: palette(dark-main); @ds-typo(small); }
.assetActionFeedbackError { @ds-typo (emphasis); border-color: palette(error-main); background: color-mix(in srgb, palette(error-main) 10%, palette(light-light)); }

.editorFacts { display: grid; gap: density(3); margin-top: density(4); }
.editorFactList { display: grid; gap: density(2); margin: 0; padding: 0; list-style: none; }
.editorFactList li { @ds-surface (boxed); display: flex; align-items: flex-start; justify-content: space-between; gap: density(3); padding: density(3); border-radius: radius(2); }
.editorFactList li > div { display: grid; gap: density(1); min-width: 0; }
.editorFactList strong { color: palette(primary-dark); @ds-typo (label); }
.editorFactList p { margin: 0; color: palette(dark-main); @ds-typo(small); overflow-wrap: anywhere; }
.editorFactList a { color: palette(primary-dark); @ds-typo (label); }

.assetCard {
  @ds-surface (card);
  display: grid;
  align-content: start;
  gap: density(4);
  min-width: 0;
  padding: density(4);
  border-radius: radius(3);
}

.assetCard > header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: density(4);
}

.assetCard > header > div {
  display: flex;
  flex-direction: column;
  gap: density(1);
}

.assetCard > header strong {
  color: palette(dark-main);
  @ds-typo (caption);
}

.assetCard > header small {
  color: palette(tertiary-main);
  @ds-typo (fine);
}

.assetStatus {
  padding: density(2) density(3);
  border-radius: radius(pill);
  background: palette(light-light);
  color: palette(tertiary-main);
  @ds-typo (badge);
}

.assetApproved {
  background: palette(surface-light);
  color: palette(primary-dark);
}

.assetFailed {
  background: palette(error-light);
  color: palette(error-dark);
}

.assetPreview {
  @ds-surface (card);
  position: relative;
  overflow: hidden;
  width: 100%;
  border-radius: radius(3);
}
.assetPreviewActual { overflow: auto; }
.assetPreviewCanvas { position: relative; display: block; width: 100%; height: 100%; }

.assetPreview img {
  object-fit: contain;
}

.assetPlaceholder {
  display: grid;
  height: 100%;
  place-content: center;
  justify-items: center;
  gap: density(3);
  padding: density(6);
  color: palette(tertiary-main);
  text-align: center;
}

.assetPlaceholder strong {
  @ds-typo (meta);
}

.assetPlaceholder small {
  max-width: 300px;
  @ds-typo (fine);
}

.assetSpinner {
  width: 24px;
  height: 24px;
  border: border(subtle);
  border-top-color: palette(primary-dark);
  border-radius: radius(circle);
  animation: asset-spin 0.8s linear infinite;
}

@keyframes asset-spin {
  to {
    transform: rotate(360deg);
  }
}

.expectedText {
  @ds-surface (card);
  padding: density(3) density(4);
  border-radius: radius(2);
}

.expectedText span {
  color: palette(tertiary-main);
  @ds-typo (badge);
}

.expectedText p {
  margin: density(2) 0 0;
  color: palette(dark-main);
  @ds-typo (meta-strong);
  white-space: pre-wrap;
}

.assetSafety {
  @ds-surface (notice-error);
  padding: density(3) density(3);
  border-radius: radius(2);
  color: palette(error-dark);
  @ds-typo (fine);
}

.assetTextWarning {
  @ds-surface (notice-warning);
  padding: density(3) density(3);
  border-radius: radius(2);
  color: palette(warning-dark);
  @ds-typo (fine);
}
.inlineLink { @ds-button (link); @ds-typo (emphasis); padding: 0; font: inherit; text-decoration: underline; }

.assetPrompt {
  @ds-surface (card);
  border-radius: radius(2);
}

.assetPrompt summary {
  @ds-button (link);
  padding: density(3) density(4);
  @ds-typo (fine-strong);
}

.assetPrompt textarea {
  @ds-input (field);
  width: calc(100% - 20px);
  margin: 0 space(4) space(4);
  padding: density(3);
  border: border(subtle);
  border-radius: radius(2);
  outline: none;
  color: palette(dark-main);
  font: inherit;
  @ds-typo (fine);
  resize: vertical;
}

.assetActions {
  display: flex;
  align-items: xs(stretch) md(center);
  flex-direction: xs(column) md(row);
  justify-content: space-between;
  gap: density(4);
}

.assetActions > div:last-child button {
  flex: xs(1) md(0 0 auto);
}

.assetActions > div {
  display: flex;
  align-items: center;
  gap: density(3);
}

.assetActions a {
  color: palette(primary-dark);
  @ds-typo (fine-strong);
  text-decoration: none;
}

.assetActions small {
  color: palette(tertiary-main);
  @ds-typo (fine);
}

.assetActions button {
  min-height: 34px;
  padding: 0 space(4);
}


.documentaryPanel {
  @ds-surface(flat primary);
  border-radius: radius(3);
  @ds-typo(body);
  display: flex;
  flex-direction: column;
  gap: density(3);
  padding: density(5);
  color: palette(surface-contrast);
  background: palette(surface-main);
  border: border(1);
}

.documentaryPreview {
  display: block;
  width: xs(100%) md(432px);
  max-width: 100%;
  height: auto;
  border-radius: radius(2);
}

.documentaryActions {
  display: flex;
  flex-direction: xs(column) md(row);
  gap: density(3);
}

.documentaryCheck {
  display: flex;
  align-items: flex-start;
  gap: density(2);
}

.documentaryPanel button {
  @ds-button(outlined primary 2);
}

.documentaryPanel a {
  color: palette(primary-main);
  overflow-wrap: anywhere;
}

/* IG-03 — Instagram publications gallery */
.instagramGallery {
  @ds-surface(flat primary);
  border-radius: radius(3);
  @ds-typo(body);
  display: flex;
  flex-direction: column;
  gap: density(3);
  padding: density(5);
  color: palette(surface-contrast);
  background: palette(surface-main);
  border: border(1);
}

.instagramGalleryHeader {
  display: flex;
  flex-direction: xs(column) sm(row);
  align-items: xs(flex-start) sm(center);
  justify-content: space-between;
  gap: density(2);
}

.instagramFilters {
  display: grid;
  grid-template-columns: xs(repeat(2, minmax(0, 1fr))) md(repeat(4, minmax(0, 160px)) auto);
  align-items: end;
  gap: density(3);
}

.instagramFilters .field select,
.instagramFilters .field input {
  border-color: palette(dark-main, 0.16);
}

.instagramFilters > button {
  justify-self: start;
}

.instagramGrid {
  display: grid;
  grid-template-columns: xs(1fr) sm(repeat(2, minmax(0, 1fr))) md(repeat(3, minmax(0, 1fr)));
  gap: density(4);
  margin: 0;
  padding: 0;
  list-style: none;
}

.instagramCard {
  @ds-surface(flat light 2);
  box-shadow: shadow(1);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.instagramCardMuted {
  opacity: 0.6;
}

.instagramThumb {
  display: block;
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
  background: palette(surface-light);
}

.instagramThumbFallback {
  display: grid;
  place-items: center;
  width: 100%;
  aspect-ratio: 4 / 5;
  padding: density(3);
  text-align: center;
  color: palette(tertiary-main);
  background: palette(surface-light);
  @ds-typo(caption);
}

.instagramCardBody {
  display: flex;
  flex-direction: column;
  gap: density(2);
  padding: density(3);
}

.instagramCardMeta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: density(2);
}

.instagramBadge {
  @ds-typo (label);
  color: palette(primary-main);
}

.instagramCaption {
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  @ds-typo(caption);
  color: palette(surface-contrast);
}

.instagramLinkPill {
  @ds-typo(caption);
  padding: density(1) density(2);
  border-radius: radius(full);
  color: palette(tertiary-contrast);
  background: palette(tertiary-main);
}

.instagramLinkPillOn {
  color: palette(primary-contrast);
  background: palette(primary-main);
}

.instagramLink {
  @ds-button (link-accent);
  @ds-typo(caption);
  padding: 0;
  text-decoration: underline;
}

/* IG-04 — link a publication to its editorial story */
.instagramLinkChip {
  @ds-typo (label);
  color: palette(primary-main);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.instagramLinkForm {
  @ds-surface(flat light 2);
  display: flex;
  flex-direction: xs(column) sm(row);
  flex-wrap: wrap;
  align-items: xs(stretch) sm(flex-end);
  gap: density(2);
  padding: density(3);
}

.instagramLinkSuggested {
  @ds-typo(caption);
  color: palette(tertiary-main);
}

.instagramLinkActions {
  display: flex;
  align-items: center;
  gap: density(2);
}

/* IG-05 — per-publication metrics */
.instagramMetrics {
  display: flex;
  flex-direction: column;
  gap: density(2);
}

.instagramMetricsGrid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: density(2);
}

.instagramMetricCell {
  display: flex;
  flex-direction: column;
  gap: density(1);
}

.instagramMetricLabel {
  @ds-typo (fine);
  color: palette(tertiary-dark);
}

.instagramMetricValue {
  @ds-typo (label);
  color: palette(primary-dark);
}

.instagramMetricUnavailable {
  @ds-typo (label);
  color: palette(tertiary-main);
}

.instagramMetricError {
  @ds-typo (label);
  color: palette(warning-dark);
}

.instagramMetricRatios {
  margin: 0;
  @ds-typo (fine);
  color: palette(tertiary-dark);
}

.instagramMetricsHint {
  margin: 0;
  @ds-typo (fine);
  color: palette(tertiary-dark);
}

/* IG-06 — story Instagram results */
.storyInstagramResults {
  display: flex;
  flex-direction: column;
  gap: density(3);
}

.storyInstagramList {
  display: flex;
  flex-direction: column;
  gap: density(3);
  list-style: none;
  margin: 0;
  padding: 0;
}

.storyInstagramPost {
  @ds-surface(flat light 2);
  box-shadow: shadow(1);
  display: grid;
  grid-template-columns: xs(1fr) sm(96px 1fr);
  gap: density(3);
  padding: density(3);
}

.storyInstagramPostBody {
  display: flex;
  flex-direction: column;
  gap: density(2);
  min-width: 0;
}

.storyInstagramPostMeta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: density(2);
}

.storyInstagramVersionChip {
  @ds-typo (label);
  color: palette(primary-main);
  display: flex;
  align-items: center;
  gap: density(2);
}

.storyInstagramVersionMissing {
  @ds-typo(caption);
  color: palette(tertiary-main);
}

.storyInstagramPicker {
  @ds-surface(flat light 2);
  display: flex;
  flex-direction: column;
  gap: density(2);
  padding: density(3);
}

.storyInstagramPickerItem {
  display: grid;
  grid-template-columns: 56px 1fr auto;
  gap: density(2);
  align-items: center;
}

/* BRAND-01 — brand reference library */
.brandReferenceLibrary {
  @ds-surface(flat light 3);
  border-radius: radius(2);
  display: grid;
  gap: density(3);
  margin-top: density(4);
}

.brandReferenceForm {
  display: grid;
  gap: density(2);
}

.brandReferenceFormGrid {
  display: grid;
  grid-template-columns: xs(1fr) sm(repeat(2, minmax(0, 1fr)));
  gap: density(4);
}

.brandReferenceGrid {
  display: grid;
  grid-template-columns:
    xs(repeat(2, minmax(0, 1fr)))
    sm(repeat(3, minmax(0, 1fr)))
    md(repeat(4, minmax(0, 1fr)));
  gap: density(3);
  margin: 0;
}

.brandReferenceItem {
  @ds-surface (card);
  margin: 0;
  border-radius: radius(2);
  overflow: hidden;
  display: grid;
}

.brandReferenceItem img {
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
  background: palette(surface-light);
}

.brandReferenceInactive {
  opacity: 0.5;
}

.brandReferenceMeta {
  padding: density(2);
  display: grid;
  gap: density(1);
}

.brandReferenceBadge {
  @ds-typo (fine);
  color: palette(primary-main);
}

.brandReferencePill {
  display: flex;
  align-items: center;
  gap: density(1);
  @ds-typo (fine);
  color: palette(tertiary-dark);
}

.brandReferencePillOn {
  @ds-typo (emphasis);
  color: palette(primary-dark);
}

/* BRAND-02 — contribution + analysis */
.brandContributionChips {
  display: flex;
  flex-wrap: wrap;
  gap: density(2);
}

.brandContributionChip {
  @ds-button (chip);
  @ds-typo (fine-strong);
  padding: density(1) density(3);
  border: border(control);
  border-radius: radius(full);
  text-transform: capitalize;
}

.brandContributionChip:disabled {
  cursor: not-allowed;
  opacity: 0.45;
}

.brandContributionChipOn {
  border-color: palette(primary-main);
  background: palette(primary-main);
  color: palette(primary-contrast);
}

.brandAnalysis {
  @ds-surface (card);
  display: grid;
  gap: density(2);
  padding: density(3);
  border-radius: radius(2);
}

.brandAnalysisRow {
  display: grid;
  grid-template-columns: 84px 1fr auto;
  gap: density(2);
  align-items: start;
  @ds-typo (fine);
}

.brandAnalysisBadge {
  @ds-button (chip);
  @ds-typo (fine-strong);
  padding: density(1) density(2);
  border: border(control);
  border-radius: radius(full);
  white-space: nowrap;
}

.brandAnalysisBadge:disabled {
  cursor: not-allowed;
  opacity: 0.45;
}

.brandAnalysisBadgeLow {
  color: palette(tertiary-dark);
}

.brandAnalysisBadgeMedium {
  color: palette(warning-dark);
  border-color: palette(warning-main);
}

.brandAnalysisBadgeHigh {
  color: palette(success-dark);
  border-color: palette(success-main);
}

/* BRAND-03 — auto-selected brand references per unit (read-only) */
.brandUnitSelection {
  display: grid;
  gap: density(1);
  @ds-typo (fine);
  color: palette(tertiary-dark);
}

.brandUnitSelection > span {
  @ds-typo (emphasis);
  color: palette(primary-dark);
}

.brandUnitSelection ul {
  margin: 0;
  padding-left: density(4);
}

.brandUnitSelection code {
  @ds-typo (fine);
  color: palette(tertiary-main);
}


.brandImageEditor {
  @ds-surface(flat neutral 2);
  @ds-typo(body);
  padding: density(3);
  display: flex;
  flex-direction: column;
  gap: density(2);
  color: palette(primary-main);
}

.brandImageEditor details[open] {
  display: flex;
  flex-direction: column;
  gap: density(2);
}

.brandImageEditor summary {
  cursor: pointer;
}

.brandImageReference {
  display: flex;
  flex-direction: column;
  gap: density(1);
  padding: density(2);
  border: border(1);
  border-radius: radius(2);
}

.brandImageReference img {
  width: xs(100%) md(50%);
  height: auto;
  object-fit: contain;
}

.editRequestState {
  @ds-typo(caption);
  align-self: flex-start;
  padding: density(1) density(2);
  border: border(1);
  border-radius: radius(full);
  color: palette(primary-main);
}

.editRequestActions {
  display: flex;
  flex-wrap: wrap;
  gap: density(2);
}

.mapsPreviewPanel {
  @ds-surface(flat primary 2);
  @ds-typo(body);
  padding: density(3);
  border: border(1);
}

.mapsPreviewPanel summary { @ds-typo (emphasis); cursor: pointer; }
.mapsPreviewActions { display: flex; flex-wrap: wrap; gap: density(2); }
.mapsPreviewActions button { @ds-button(outlined primary 2); }
.mapsPreviewActions button:disabled { opacity: 0.5; cursor: not-allowed; }
.mapsPreviewResults { display: flex; flex-direction: column; gap: density(2); margin-top: density(3); }
.mapsPreviewGrid { display: grid; grid-template-columns: xs(1fr) lg(repeat(2, minmax(0, 1fr))); gap: density(3); }
.mapsPreviewComposition {
  @ds-surface(contained light 2);
  aspect-ratio: 4 / 5;
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding: density(3);
  gap: density(2);
  color: palette(primary-dark);
  border: border(1);
}
.mapsPreviewComposition h3 { @ds-typo(h6); margin: density(1) 0; }
.mapsPreviewComposition p { @ds-typo(caption); margin: density(1) 0; }
.mapsPreviewComposition footer { @ds-typo(caption); overflow-wrap: anywhere; }
/* Reserve the image's own height even when the card's text exceeds its target ratio.
   A shrinking flex area with percentage image heights can collapse or cover the footer. */
.mapsPreviewMedia { flex: 0 0 auto; width: 100%; display: grid; place-items: center; }
.mapsPreviewMedia img { display: block; width: 100%; height: auto; object-fit: contain; }
/* Provider-required text treatment; do not restyle the attribution as brand copy. */
.mapsAttribution { /* uxdsl-exception: the Google Maps attribution keeps the provider's own type and colors */ font: 400 14px Arial, sans-serif; color: #1f1f1f; background: #fff; white-space: nowrap; padding: density(1); }

.publicationCandidate {
  @ds-surface(flat primary);
  border-radius: radius(3);
  display: grid;
  gap: density(2);
  padding: xs(density(3)) md(density(4));
  box-shadow: shadow(1);
  color: palette(primary-main);
  @ds-typo(body);
}

.publicationCandidate h4 {
  @ds-typo(h5);
  color: palette(primary-main);
}

/* Inline "go to where this is fixed" action beside a publication blocker. */
.blockerAction {
  @ds-button(flat primary 1);
  @ds-typo (label);
  text-decoration: underline;
  text-underline-offset: 2px;
  cursor: pointer;
}

.publicationCaption {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.publicationPackage {
  display: grid;
  gap: density(2);
  border-top: border(control);
  padding-top: density(2);
}

.publicationPackageEntry {
  display: grid;
  gap: density(1);
  padding: density(2);
  border: border(control);
  border-radius: radius(2);
}

.publicationPackageSlide {
  display: grid;
  justify-items: start;
  gap: density(1);
  overflow-wrap: anywhere;
}

.publicationPreviewList { display: flex; flex-wrap: wrap; gap: density(3); margin: 0; padding: 0; list-style: none; }
.publicationPreviewList img { display: block; width: 108px; height: 135px; border-radius: radius(2); object-fit: contain; background: palette(surface-light); }
.publicationPreviewList span { color: palette(tertiary-dark); @ds-typo(caption); }
.publicationConfirm { @ds-surface (notice-warning); display: grid; gap: density(2); padding: density(3); border: border(warning-strong); border-radius: radius(2); color: palette(dark-main); }
.publicationConfirm p { margin: 0; @ds-typo(small); }

.publicationPackageActions {
  display: flex;
  flex-wrap: wrap;
  gap: density(2);
  align-items: center;
}

.publicationJob {
  @ds-surface (boxed);
  display: grid;
  gap: density(1);
  padding: density(2);
  border-radius: radius(2);
  background: palette(primary-contrast);
  color: palette(primary-main);
}

/* ---------------------------------------------------------------------------
 * Brand palette assistant (creative profile › Identity).
 * Reuses .brandOverlayHeader, .field, .secondaryButton, .paletteAdd, .warning
 * and .brandAssetHint; these classes add the block layout and the swatches.
 * ------------------------------------------------------------------------- */

.paletteAssistant {
  @ds-surface(flat neutral 4);
  display: grid;
  gap: density(4);
  padding: density(4);
  border: border(control);
  border-radius: radius(3);
  background: palette(surface-light);
  box-shadow: shadow(1);
}

.paletteAssistantForm {
  display: grid;
  gap: density(3);
}

/* Creative identity: one fieldset per branch, each with its own AI rewrite row. */
/* Content sits at the top: a shorter field must not stretch its rows to match its neighbour. */
.identityFields { display: grid; grid-template-columns: xs(1fr) lg(repeat(2, minmax(0, 1fr))); gap: density(4); align-items: start; }
.identityField { @ds-surface (boxed); display: grid; align-content: start; gap: density(2); min-width: 0; margin: 0; padding: density(3); border-radius: radius(2); }
.identityField legend { padding: 0 density(1); @ds-typo (label); color: palette(primary-dark); }
.identityField textarea, .identityField select, .paletteAssistantForm input, .identityFieldAssistant input { @ds-input(outlined neutral 2); width: 100%; }
.identityField small { @ds-typo(caption); color: palette(dark-main, 0.6); }
/* Folded per-field AI rewrite: a small, clearly attached disclosure under its field. */
.profilePanel .identityFieldAssistant { display: grid; gap: density(2); padding: density(1) density(2); border: 0; border-radius: radius(2); background: palette(primary-light, 0.12); box-shadow: none; }
.profilePanel .identityFieldAssistant summary { @ds-button (link); display: block; min-height: 0; padding: density(1) 0; @ds-typo (label); }
.profilePanel .identityFieldAssistant[open] { padding-bottom: density(2); }
.identityFieldAssistant button { justify-self: start; }
.identityAvoidAdd { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: density(2); align-items: center; }
.identityAvoidAdd input { @ds-input(outlined neutral 2); width: 100%; }
/* A branch that needs the full row (priority, avoid groups). */
.identityFieldWide { grid-column: 1 / -1; }
.identityField > input { @ds-input(outlined neutral 2); width: 100%; }
.identityAvoidGroups { display: grid; grid-template-columns: xs(1fr) lg(repeat(2, minmax(0, 1fr))); gap: density(3); align-items: start; }
.identityAvoidGroups > small, .identityAvoidGroups > button { grid-column: 1 / -1; }
.identityAvoidGroup { display: grid; gap: density(2); padding: density(2); border: border(warning-soft); border-radius: radius(2); }
.identityAvoidGroupHeader { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: density(2); align-items: center; }
.identityAvoidGroupHeader input { @ds-typo (emphasis); @ds-input(outlined neutral 2); width: 100%; }
.identityField select { @ds-typo (inherit); min-height: 42px; padding-block: 0; }
.identityField textarea::placeholder, .identityField input::placeholder, .paletteAssistantForm input::placeholder { color: palette(dark-main, 0.45); }
.identityAvoidList { display: flex; flex-wrap: wrap; gap: density(1); margin: 0; padding: 0; list-style: none; }
.identityAvoidList li { @ds-surface (card); display: inline-flex; align-items: center; gap: density(1); padding: density(1) density(2); border: border(warning-soft); border-radius: radius(pill); background: palette(warning-light, 0.4); @ds-typo(caption); color: palette(dark-main); }
.identityAvoidList button { @ds-button (link-warning); @ds-typo (emphasis); }

.paletteAssistantForm textarea {
  @ds-typo (multiline);
  @ds-input(outlined neutral 2);
  width: 100%;
  min-height: density(12);
  padding: density(3);
  resize: vertical;
  background: palette(light-light);
  color: palette(dark-main);
}

.paletteAssistantForm textarea:focus {
  border-color: palette(primary-main);
  box-shadow: shadow(ring);
  outline: none;
}

.paletteAssistantActions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: density(2);
}

.paletteAssistantResult {
  display: grid;
  gap: density(3);
}

.paletteAssistantSwatches {
  display: grid;
  grid-template-columns: xs(1fr) sm(repeat(2, minmax(0, 1fr))) lg(repeat(3, minmax(0, 1fr)));
  gap: density(2);
  margin: 0;
  padding: 0;
  list-style: none;
}

.paletteAssistantSwatch {
  @ds-surface(flat light 2);
  display: grid;
  grid-template-columns: density(7) minmax(0, 1fr);
  align-items: center;
  gap: density(2);
  padding: density(2);
  border: border(control);
  border-radius: radius(2);
  background: palette(light-light);
}

.paletteAssistantSwatch i {
  display: block;
  width: density(7);
  height: density(7);
  border: border(hairline);
  border-radius: radius(1);
}

.paletteAssistantSwatch span {
  display: grid;
  min-width: 0;
}

.paletteAssistantSwatch strong {
  overflow: hidden;
  color: palette(dark-main);
  @ds-typo (label);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.paletteAssistantSwatch small {
  color: palette(tertiary-dark);
  @ds-typo (fine);
}

/* Brand palette: optional usage intent and share per colour. */

.paletteUsageRow {
  display: grid;
  grid-column: 2 / -1;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: density(2);
  min-width: 0;
}

.paletteUsageRow input {
  @ds-input(outlined neutral 2);
  border-radius: radius(1);
  min-width: 0;
  padding: density(1) density(2);
  @ds-typo(caption);
}

.paletteShareField {
  display: inline-flex;
  align-items: center;
  gap: density(1);
  color: palette(tertiary-dark);
  @ds-typo(caption);
}

.paletteShareField input {
  width: 4.5rem;
  text-align: right;
}

.paletteShareSummary {
  display: grid;
  gap: density(2);
}

.paletteShareSummary small {
  color: palette(tertiary-dark);
  @ds-typo(caption);
}

.paletteShareOver {
  color: palette(error-dark);
}

.paletteShareBar {
  @ds-surface (boxed);
  display: flex;
  height: density(4);
  overflow: hidden;
  border-radius: radius(1);
}

.paletteShareBar span {
  display: block;
  min-width: 2px;
  height: 100%;
  flex-basis: 0;
}

.paletteShareFree {
  background: repeating-linear-gradient(
    135deg,
    palette(surface-dark, 0.35) 0 4px,
    transparent 4px 8px
  );
}

.workspace [hidden] { /* uxdsl-exception: the hidden attribute must win over any display a component sets */ display: none !important; }
.pageRoot { min-height: 100svh; padding: xs(density(3)) md(density(6)); background: palette(light-light); }
.pageWorkspace { width: min(1440px, 100%); max-height: none; margin-inline: auto; overflow: visible; border: 0; border-radius: 0; box-shadow: none; }
.pageWorkspace .body { overflow: visible; padding: xs(density(3)) md(density(6)); }
.pageWorkspace .header { position: sticky; top: 0; z-index: 5; padding-block: density(4); }
.workspaceTabs { display: flex; gap: density(2); margin-bottom: density(5); overflow-x: auto; border-bottom: border(subtle); }
.workspaceTabs button { @ds-button (tab); display: inline-flex; align-items: center; gap: density(2); min-height: 44px; padding: density(2) density(4); border-bottom: border(clear); @ds-typo (compact-strong); white-space: nowrap; }
.workspaceTabs button:hover, .workspaceTabs button:focus-visible { color: palette(primary-dark); }
.workspaceTabs button.workspaceTabActive { border-bottom-color: palette(primary-main); color: palette(primary-dark); }
.workspaceTabs button span { display: inline-grid; width: 16px; height: 16px; place-items: center; border-radius: radius(full); background: palette(success-light); color: palette(success-dark); @ds-typo (fine); }
.pageWorkspace .progress { display: none; }
.contentStage { @ds-surface (card); display: grid; gap: density(4); padding: density(7); border-radius: radius(3); }
.contentStage h3 { margin: 0; color: palette(dark-main); @ds-typo (title-lg); }
.contentStage p { max-width: 70ch; margin: 0; color: palette(tertiary-main); @ds-typo(body); }
.contentStage > span, .stageEyebrow { color: palette(primary-dark); @ds-typo (label); }
.contentStage button { justify-self: start; }
.contentStage a { color: palette(primary-dark); @ds-typo(small); }
.contentSummary { @ds-surface (card); display: grid; gap: density(3); padding: density(4); border-radius: radius(2); background: palette(surface-light, 0.2); }
.contentSummary h4 { margin: 0; color: palette(dark-main); @ds-typo (title-sm); }
.contentSummary > strong { color: palette(primary-dark); @ds-typo (caption); }
.contentSummary details { min-width: 0; }
.contentSummary summary { @ds-button (link); @ds-typo (emphasis); }
.contentSummary details p { max-height: 24rem; overflow: auto; margin-block: density(3); white-space: pre-wrap; overflow-wrap: anywhere; }
.textPreview { @ds-surface (card); margin-bottom: density(5); border-radius: radius(3); }
.textPreview > summary { @ds-button (link-dark); padding: density(4); @ds-typo (small-strong); }
.textPreviewGrid { display: flex; gap: density(3); padding: density(4); overflow-x: auto; }
.textPreviewPiece { @ds-button (tinted); display: flex; flex: 0 0 min(190px, 70vw); min-height: 235px; flex-direction: column; align-items: stretch; gap: density(3); padding: density(5); border: border(subtle); border-radius: radius(3); aspect-ratio: 4 / 5; background: palette(primary-light, 0.18); text-align: left; }
.textPreviewPieceSelected { border: border(focus); box-shadow: shadow(1); }
.textPreviewPiece > span, .textPreviewPiece small { color: palette(tertiary-main); @ds-typo (meta); }
.textPreviewPiece strong { color: palette(dark-main); @ds-typo (title-sm); }
.textPreviewPiece p { margin: 0; color: palette(primary-dark); @ds-typo (caption); }
.textPreviewPiece small { margin-top: auto; }
.textPreviewImage { position: relative; display: block; width: 100%; aspect-ratio: 4 / 5; overflow: hidden; border-radius: radius(1); }
.textPreviewImage img { object-fit: cover; }
.pieceSelector { display: flex; gap: density(2); overflow-x: auto; padding: density(2); }
.pieceSelector button { display: grid; flex: 0 0 min(150px, 60vw); gap: density(1); min-height: 54px; padding: density(3); @ds-button(outlined neutral 2); text-align: left; cursor: pointer; }
.pieceSelector button[aria-pressed="true"] { border: border(focus); background: palette(primary-light, 0.2); }
.pieceSelector button span { color: palette(tertiary-main); @ds-typo (meta); }
.pieceSelector button strong { overflow: hidden; color: palette(dark-main); @ds-typo (caption); text-overflow: ellipsis; white-space: nowrap; }
.routeShell { min-height: 100svh; background: palette(light-light); color: palette(dark-main); }
.routeTopbar { display: flex; align-items: center; justify-content: space-between; gap: density(4); min-height: 56px; padding-inline: xs(density(4)) md(density(7)); border-bottom: border(subtle); background: palette(light-light); }
.routeTopbar a { color: palette(primary-dark); @ds-typo (compact-strong); text-decoration: none; white-space: nowrap; }
.routeBrand { color: palette(dark-main); @ds-typo (compact-strong); white-space: nowrap; }
.routeTopbar a:hover, .routeTopbar a:focus-visible { text-decoration: underline; }
.routeBreadcrumb { overflow: hidden; color: palette(tertiary-main); @ds-typo (caption); text-overflow: ellipsis; white-space: nowrap; }
.routeBreadcrumb span { padding-inline: density(2); }
.routeError, .routeLoading { @ds-surface (card); width: min(700px, calc(100% - 2rem)); margin: density(9) auto; padding: density(7); border-radius: radius(3); @ds-typo(body); }
.routeError strong { @ds-typo(h3); }
.routeError a { color: palette(primary-dark); @ds-typo (small-strong); }
.routeRefresh { @ds-surface (card); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: density(3); width: min(1320px, calc(100% - 2rem)); margin: density(4) auto 0; padding: density(4); border: border(warning); border-radius: radius(2); background: palette(warning-light, 0.25); color: palette(warning-dark); @ds-typo (compact); }
.routeRefresh button { @ds-button(outlined warning 2); min-height: 34px; @ds-typo (label); cursor: pointer; }
@media (max-width: 639px) { .routeTopbar a span { display: none; } .routeBreadcrumb { flex: 1; } }
.helpContent { width: min(760px, calc(100% - 2rem)); margin: density(9) auto; }
.helpContent > p:first-child { margin: 0; color: palette(primary-dark); @ds-typo (eyebrow); }
.helpContent h1 { margin: density(2) 0 density(8); color: palette(dark-main); @ds-typo (display-lg); }
.helpContent ol { display: grid; gap: density(3); padding-left: density(7); }
.helpContent li, .helpContent p { color: palette(tertiary-main); @ds-typo(body); }
.helpContent li strong { color: palette(dark-main); }
.helpContent a { @ds-typo (emphasis); color: palette(primary-dark); }

.hookPanel { @ds-surface (callout); display: grid; gap: density(3); margin-bottom: density(5); padding: density(4) density(5); border-radius: radius(3); }
.hookPanelHeader { display: flex; flex-direction: xs(column) md(row); align-items: xs(stretch) md(center); justify-content: space-between; gap: density(3); }
.hookPanelHeader strong { color: palette(primary-dark); @ds-typo (caption); }
.hookPanelHeader p, .hookPanelNote { margin: density(1) 0 0; color: palette(primary-main); @ds-typo (meta); }
.hookOptions { display: grid; gap: density(2); margin: 0; padding: 0; list-style: none; }
.hookOption { @ds-surface (callout); display: grid; grid-template-columns: xs(1fr) md(minmax(0, 1fr) auto); gap: density(2) density(3); align-items: center; padding: density(3); border-radius: radius(2); }
.hookOptionChosen { border-color: palette(primary-main); box-shadow: shadow(inset-primary); }
.hookOptionText { display: grid; gap: density(1); min-width: 0; }
.hookOptionText strong { @ds-typo (body-strong); color: palette(dark-main); }
.hookOptionText span { @ds-typo(caption); color: palette(dark-main, 0.72); }
.hookSecond { padding-left: density(2); border-left: border(focus-soft); }
.hookOptionAction { display: flex; justify-content: xs(flex-start) md(flex-end); }
.hookOptionMeta { display: flex; flex-wrap: wrap; gap: density(1); grid-column: 1 / -1; }
.hookOptionMeta span { padding: space(1) density(2); border-radius: radius(pill); background: palette(primary-light, 0.45); @ds-typo (fine); color: palette(primary-dark); }
.hookScores { grid-column: 1 / -1; margin: 0; @ds-typo (meta); color: palette(dark-main, 0.72); }
.hookScores b { @ds-typo (compact); margin-right: density(1); color: palette(primary-dark); }
.hookScores em { font-style: normal; color: palette(dark-main, 0.6); }
.hookCurrent { @ds-typo (label); color: palette(success-dark); }
.hookAll summary { @ds-button (link-accent); @ds-typo(caption); }
.hookAll[open] summary { margin-bottom: density(2); }
