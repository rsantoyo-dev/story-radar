.backdrop {
  position: fixed;
  z-index: 80;
  inset: 0;
  display: grid;
  place-items: center;
  padding: density(6);
  background: palette(dark-main, 0.66);
  backdrop-filter: blur(8px);
}

.workspace {
  display: flex;
  overflow: hidden;
  flex-direction: column;
  width: min(1180px, 100%);
  max-height: calc(100svh - 48px);
  border: 1px solid palette(surface-light, 0.9);
  border-radius: 22px;
  background: palette(light-light);
  box-shadow: 0 28px 90px palette(dark-main, 0.3);
}

.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: space(6);
  padding: density(6) density(6);
  border-bottom: 1px solid palette(surface-light);
  background: palette(light-light);
}

.header p,
.sectionHeading span,
.recommendation span,
.briefCopy span {
  margin: 0 0 5px;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}

.header h2 {
  max-width: 900px;
  margin: 0;
  color: palette(dark-main);
  @ds-typo (h2);
  font-size: 21px;
  line-height: 1.25;
}

.header > button {
  width: 36px;
  height: 36px;
  border: 1px solid palette(surface-light);
  border-radius: 50%;
  background: palette(light-light);
  color: palette(primary-dark);
  @ds-typo (h3);
  font-size: 24px;
  cursor: pointer;
}

.body {
  overflow: auto;
  padding: density(6) density(6) density(6);
}

.loading {
  min-height: 260px;
  padding: density(8);
  color: palette(tertiary-main);
}

.progress {
  display: flex;
  align-items: center;
  gap: space(3);
  margin-bottom: space(5);
}

.progressStep {
  display: flex;
  align-items: center;
  gap: space(3);
  padding: density(3) density(4);
  border: 1px solid palette(surface-light);
  border-radius: 999px;
  background: palette(light-light);
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 11px;
  font-weight: 700;
}

.progressStep span {
  display: grid;
  width: 20px;
  height: 20px;
  place-items: center;
  border-radius: 50%;
  background: palette(light-light);
  @ds-typo (caption);
  font-size: 10px;
}

.progressActive {
  border-color: palette(primary-main);
  color: palette(primary-dark);
}

.progressComplete span {
  background: palette(surface-light);
  color: palette(primary-dark);
}

.notice,
.error,
.warning {
  margin: 0 0 16px;
  padding: density(4) density(5);
  border-radius: 12px;
  @ds-typo (caption);
  font-size: 12px;
  line-height: 1.5;
}

.notice {
  border: 1px solid palette(primary-light);
  background: palette(light-light);
  color: palette(primary-dark);
}

.error {
  border: 1px solid palette(error-light);
  background: palette(light-light);
  color: palette(error-dark);
}

.error strong,
.error p {
  margin: 0;
}

.error p {
  margin-top: space(1);
}

.warning {
  border: 1px solid palette(warning-light);
  background: palette(light-light);
  color: palette(warning-dark);
}

.profilePanel {
  margin-bottom: space(5);
  border: 1px solid palette(surface-light);
  border-radius: 15px;
  background: palette(light-light);
}

.profilePanel summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: space(5);
  padding: density(5) density(5);
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 11px;
  font-weight: 750;
  cursor: pointer;
  list-style: none;
}

.profilePanel summary::-webkit-details-marker {
  display: none;
}

.profilePanel summary > span:first-child {
  display: flex;
  flex-direction: column;
  gap: space(1);
}

.profilePanel summary small {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 10px;
  font-weight: 500;
}

.profileBody {
  display: grid;
  gap: space(4);
  padding: density(5);
  border-top: 1px solid palette(surface-light);
}

.profileGuideHint {
  margin: calc(space(3) * -1) 0 0;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 10px;
  line-height: 1.45;
}

.charactersSection {
  display: grid;
  gap: space(4);
  padding-top: density(4);
  border-top: 1px solid palette(surface-light);
}

.charactersHeading,
.characterSlot > header,
.characterReferencesHeading,
.referenceItem figcaption {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: space(3);
}

.charactersHeading strong,
.characterSlot > header strong {
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 11px;
}

.charactersHeading p,
.referenceEmpty {
  margin: space(1) 0 0;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 10px;
  line-height: 1.45;
}

.charactersHeading small,
.characterReferencesHeading small {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 9px;
  font-weight: 750;
}

.characterGrid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: space(4);
}

.characterSlot {
  display: grid;
  align-content: start;
  gap: space(3);
  padding: density(4);
  border: 1px solid palette(surface-light);
  border-radius: 8px;
  background: palette(light-light);
}

.characterSlot > header span,
.characterReferencesHeading > span {
  display: block;
  margin-bottom: space(1);
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.characterRemoveButton,
.referenceItem button {
  border: 0;
  background: transparent;
  color: palette(error-main);
  font: inherit;
  @ds-typo (caption);
  font-size: 9px;
  font-weight: 750;
  cursor: pointer;
}

.characterRemoveButton:disabled,
.referenceItem button:disabled {
  cursor: not-allowed;
  opacity: 0.45;
}

.characterReferences {
  display: grid;
  gap: space(3);
}

.referenceGrid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: space(3);
}

.referenceItem {
  min-width: 0;
  margin: 0;
  overflow: hidden;
  border: 1px solid palette(surface-light);
  border-radius: 7px;
  background: palette(light-light);
}

.referenceItem img,
.referencePreviewPlaceholder {
  display: grid;
  width: 100%;
  aspect-ratio: 1;
  place-items: center;
  background: palette(light-light);
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 8px;
  object-fit: cover;
}

.referenceItem figcaption {
  padding: density(2) density(2);
  gap: space(2);
}

.referenceItem figcaption span {
  overflow: hidden;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 7px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.referenceItem figcaption button {
  flex: 0 0 auto;
  @ds-typo (caption);
  font-size: 7px;
}

.referenceUpload {
  display: inline-flex;
  width: max-content;
  max-width: 100%;
  min-height: 31px;
  align-items: center;
  padding: 0 10px;
  border: 1px dashed palette(primary-main);
  border-radius: 7px;
  background: palette(light-light);
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 9px;
  font-weight: 750;
  cursor: pointer;
}

.referenceUpload input {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
}

.referenceUploadDisabled {
  cursor: not-allowed;
  opacity: 0.45;
}

.fieldGrid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: space(4);
}

.field {
  display: flex;
  flex-direction: column;
  gap: space(2);
}

.field > span,
.factPicker legend {
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 10px;
  font-weight: 750;
}

.field input,
.field textarea,
.field select,
.emojiRow input[type="number"] {
  width: 100%;
  border: 1px solid palette(surface-light);
  border-radius: 9px;
  outline: none;
  background: palette(light-light);
  color: palette(dark-main);
  font: inherit;
  @ds-typo (caption);
  font-size: 12px;
}

.field input,
.field select,
.emojiRow input[type="number"] {
  height: 38px;
  padding: 0 11px;
}

.field textarea {
  min-height: 66px;
  padding: density(3) density(4);
  line-height: 1.5;
  resize: vertical;
}

.field input:focus,
.field textarea:focus,
.field select:focus {
  border-color: palette(primary-main);
  box-shadow: 0 0 0 3px palette(primary-main, 0.12);
}

.sliders {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: space(4);
  padding: density(4);
  border-radius: 11px;
  background: palette(light-light);
}

.sliders label {
  display: flex;
  flex-direction: column;
  gap: space(2);
  color: palette(primary-main);
  @ds-typo (caption);
  font-size: 9px;
  font-weight: 700;
}

.sliders label span {
  display: flex;
  justify-content: space-between;
}

.sliders input {
  accent-color: palette(primary-dark);
}

.emojiRow {
  display: flex;
  align-items: center;
  gap: space(6);
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 11px;
  font-weight: 650;
}

.emojiRow label {
  display: flex;
  align-items: center;
  gap: space(3);
}

.emojiRow input[type="number"] {
  width: 72px;
}

.section {
  margin-top: space(5);
  padding: density(5);
  border: 1px solid palette(surface-light);
  border-radius: 17px;
  background: palette(light-light);
}

.sectionHeading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: space(5);
  margin-bottom: space(5);
}

.sectionHeading h3 {
  margin: 0;
  color: palette(dark-main);
  @ds-typo (h3);
  font-size: 17px;
}

.budget,
.statusPill {
  padding: density(2) density(3);
  border-radius: 999px;
  background: palette(light-light);
  color: palette(primary-main);
  @ds-typo (caption);
  font-size: 9px;
  font-weight: 750;
}

.statusApproved {
  background: palette(surface-light);
  color: palette(primary-dark);
}

.briefCallout,
.generateDraftCard {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: space(6);
  padding: density(5);
  border: 1px dashed palette(surface-dark);
  border-radius: 13px;
  background: palette(light-light);
}

.briefCallout strong,
.generateDraftCard strong {
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 12px;
}

.briefCallout p,
.generateDraftCard p {
  margin: space(2) 0 0;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 11px;
  line-height: 1.45;
}

.editorialDirectionPanel {
  @ds-surface(flat neutral radius(3));
  display: grid;
  gap: density(2);
  padding: density(4);
  border: border(1, palette(surface-light), solid);
}

.editorialDirectionPanel > p {
  margin: 0;
  color: palette(tertiary-main);
  @ds-typo(caption);
}

.historyPanel {
  margin-top: space(5);
  border: 1px solid palette(surface-light);
  border-radius: 13px;
  background: palette(light-light);
}

.historyPanel summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: space(5);
  padding: density(4) density(5);
  color: palette(primary-dark);
  cursor: pointer;
  list-style: none;
}

.historyPanel summary::-webkit-details-marker {
  display: none;
}

.historyPanel summary > span:first-child,
.historyList button > span:first-child {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: space(1);
}

.historyPanel summary strong,
.historyList button strong {
  @ds-typo (caption);
  font-size: 11px;
}

.historyPanel summary small,
.historyList button small {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 9px;
  font-weight: 600;
}

.historyPanel summary > span:last-child,
.historyList button > span:last-child {
  flex: 0 0 auto;
  color: palette(primary-main);
  @ds-typo (caption);
  font-size: 9px;
  font-weight: 800;
}

.historyList {
  display: grid;
  gap: space(3);
  padding: 0 12px 12px;
}

.historyList button {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: space(4);
  padding: density(4) density(4);
  border: 1px solid palette(surface-light);
  border-radius: 8px;
  background: palette(light-light);
  color: palette(primary-dark);
  text-align: left;
  cursor: pointer;
}

.historyList button strong,
.historyList button small {
  overflow-wrap: anywhere;
}

.historyList button:hover,
.historyList button:focus-visible,
.historySelected {
  border-color: palette(primary-main) !important;
  background: palette(light-light) !important;
}

.historyCallout {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: space(5);
  margin-bottom: space(5);
  padding: density(4) density(5);
  border: 1px solid palette(primary-light);
  border-radius: 12px;
  background: palette(light-light);
}

.historyCallout strong {
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 12px;
}

.historyCallout p {
  margin: space(2) 0 0;
  color: palette(primary-main);
  @ds-typo (caption);
  font-size: 10px;
  line-height: 1.45;
}

.historyActions {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: space(3);
}

.historicalDraftDetails {
  display: grid;
  gap: space(4);
  margin-bottom: space(5);
  padding: density(5);
  border: 1px solid palette(surface-light);
  border-radius: 12px;
  background: palette(light-light);
}

.historicalDraftHeading {
  display: flex;
  flex-direction: xs(column) md(row);
  align-items: xs(stretch) md(flex-start);
  justify-content: space-between;
  gap: space(5);
}

.historicalDraftHeading strong {
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 12px;
}

.historicalDraftHeading p {
  margin: space(2) 0 0;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 10px;
  line-height: 1.45;
}

.historicalDraftHeading small {
  flex: 0 0 auto;
  color: palette(primary-main);
  @ds-typo (caption);
  font-size: 9px;
  font-weight: 800;
}

.historicalRegenerationAction {
  @ds-surface (contained primary radius(2) shadow(1));
  display: flex;
  flex-direction: xs(column) md(row);
  align-items: xs(stretch) md(center);
  justify-content: space-between;
  gap: density(4);
  padding: density(4);
}

.historicalRegenerationAction strong {
  color: palette(primary-contrast);
  @ds-typo (caption);
  font-size: 11px;
}

.historicalRegenerationAction p {
  margin: density(1) 0 0;
  color: palette(primary-contrast);
  @ds-typo (caption);
  font-size: 9px;
  line-height: 1.45;
}

.historicalRegenerationAction button {
  @ds-button (contained light density(3) radius(2) shadow(1));
  flex: 0 0 auto;
}

.historicalRegenerationControls {
  display: grid;
  flex: 0 0 auto;
  gap: density(2);
}

.historicalRegenerationControls small {
  max-width: xs(none) md(320px);
  color: palette(error-light);
  @ds-typo (caption);
  font-size: 9px;
  line-height: 1.4;
}

.historicalDraftFields {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: space(4);
}

.readOnlyDraftField {
  display: grid;
  gap: space(2);
}

.readOnlyDraftField > span {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.readOnlyDraftField textarea {
  width: 100%;
  min-height: 0;
  resize: vertical;
  border: 1px solid palette(surface-light);
  border-radius: 8px;
  background: palette(light-light);
  color: palette(dark-main);
  font: inherit;
  @ds-typo (caption);
  font-size: 11px;
  line-height: 1.45;
}

.historicalUnits {
  border: 1px solid palette(surface-light);
  border-radius: 10px;
  background: palette(light-light);
}

.historicalUnits summary {
  padding: density(4) density(4);
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 10px;
  font-weight: 800;
  cursor: pointer;
}

.historicalUnits > div {
  display: grid;
  gap: space(4);
  padding: 0 12px 12px;
}

.historicalUnits article {
  display: grid;
  gap: space(3);
  padding: density(4);
  border: 1px solid palette(surface-light);
  border-radius: 9px;
  background: palette(light-light);
}

.historicalUnits article > header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: space(4);
}

.historicalUnits article strong {
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 11px;
}

.historicalUnits article small {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 9px;
}

.completeScript {
  @ds-surface (flat primary radius(3) shadow(1));
  overflow: hidden;
}

.completeScript summary {
  padding: density(4);
  color: palette(primary-dark);
  @ds-typo (caption);
  font-weight: 800;
  cursor: pointer;
}

.completeScriptBody {
  display: grid;
  gap: density(3);
  padding: 0 density(4) density(4);
}

.completeScriptHeading {
  display: flex;
  flex-direction: xs(column) md(row);
  align-items: xs(stretch) md(center);
  justify-content: space-between;
  gap: density(3);
}

.completeScriptHeading strong {
  color: palette(primary-dark);
  @ds-typo (caption);
  font-weight: 800;
}

.completeScriptHeading p {
  margin: density(1) 0 0;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 9px;
  line-height: 1.45;
}

.completeScript textarea {
  @ds-input (outlined neutral density(3) radius(2));
  width: 100%;
  resize: vertical;
  color: palette(dark-main);
  @ds-typo (caption);
  font-size: 10px;
  line-height: 1.5;
}

.completeScript small {
  color: palette(error-main);
  @ds-typo (caption);
  font-size: 9px;
}

.primaryButton,
.secondaryButton,
.approveButton,
.unapproveButton {
  min-height: 38px;
  padding: 0 15px;
  border-radius: 9px;
  @ds-typo (caption);
  font-size: 10px;
  font-weight: 800;
  cursor: pointer;
}

.primaryButton,
.approveButton {
  border: 1px solid palette(primary-dark);
  background: palette(primary-dark);
  color: palette(light-light);
}

.secondaryButton {
  justify-self: start;
  border: 1px solid palette(surface-dark);
  background: palette(light-light);
  color: palette(primary-dark);
}

.unapproveButton {
  border: 1px solid palette(warning-main);
  background: palette(warning-light);
  color: palette(warning-dark);
}

.primaryButton:disabled,
.secondaryButton:disabled,
.approveButton:disabled,
.unapproveButton:disabled,
.header button:disabled,
.unitActions button:disabled,
.unitsHeading button:disabled {
  cursor: not-allowed;
  opacity: 0.45;
}

.brief {
  display: grid;
  gap: space(5);
  margin-top: space(5);
}

.recommendation {
  display: grid;
  grid-template-columns: 0.42fr 1fr;
  gap: space(5);
  padding: density(5);
  border-radius: 13px;
  background: linear-gradient(135deg, palette(light-light), palette(light-light));
}

.recommendation strong {
  display: block;
  color: palette(dark-main);
  @ds-typo (h3);
  font-size: 21px;
}

.recommendation small {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 9px;
}

.recommendation p,
.briefCopy p {
  margin: 0;
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 12px;
  line-height: 1.55;
}

.briefCopyGrid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: space(3);
}

.briefCopy {
  padding: density(4);
  border: 1px solid palette(surface-light);
  border-radius: 10px;
}

.carouselPlanSummary {
  display: grid;
  gap: density(3);
  padding: density(4);
  border: border(1, palette(surface-light), solid);
  border-radius: radius(2);
  background: palette(light-light);
}

.carouselPlanSummary h4,
.carouselPlanSummary p {
  margin: 0;
}

.carouselPlanSummary h4 {
  color: palette(primary-dark);
  @ds-typo (h4);
  font-size: 11px;
}

.carouselPlanSummary p {
  margin-top: density(1);
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 10px;
  line-height: 1.45;
}

.carouselPlanSummary ol {
  display: grid;
  grid-template-columns: xs(1fr) md(repeat(2, minmax(0, 1fr)));
  gap: density(2);
  margin: 0;
  padding: 0;
  list-style: none;
}

.carouselPlanSummary li {
  display: grid;
  gap: density(1);
  padding: density(3);
  border-radius: radius(1);
  background: palette(surface-light);
}

.carouselPlanSummary strong,
.carouselPlanSummary span,
.carouselPlanSummary small {
  @ds-typo (caption);
}

.carouselPlanSummary strong {
  color: palette(primary-dark);
  font-size: 10px;
}

.carouselPlanSummary span,
.carouselPlanSummary small {
  color: palette(tertiary-main);
  font-size: 9px;
}

.formatOptions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: space(3);
}

.formatOptions button {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: space(2) space(5);
  padding: density(4);
  border: 1px solid palette(surface-light);
  border-radius: 12px;
  background: palette(light-light);
  color: palette(primary-dark);
  text-align: left;
  cursor: pointer;
}

.formatOptions button > span {
  @ds-typo (caption);
  font-size: 11px;
  font-weight: 800;
}

.formatOptions button > strong {
  @ds-typo (h4);
  font-size: 18px;
}

.formatOptions button > small {
  grid-column: 1 / -1;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 10px;
  line-height: 1.45;
}

.formatOptions .selectedFormat {
  border-color: palette(primary-main);
  background: palette(light-light);
  box-shadow: 0 0 0 2px palette(primary-dark, 0.1);
}

.draftSetup {
  display: flex;
  align-items: flex-end;
  gap: space(5);
  margin-bottom: space(5);
  padding: density(4) density(4);
  border: 1px solid palette(surface-light);
  border-radius: 12px;
  background: palette(light-light);
}

.aspectRatioField {
  flex: 0 0 210px;
  max-width: 100%;
}

.draftSetup p {
  margin: 0 0 4px;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 10px;
  line-height: 1.45;
}

.imageQualitySetup {
  display: flex;
  align-items: flex-end;
  gap: space(5);
  margin-bottom: space(5);
  padding: density(4) density(4);
  border: 1px solid palette(surface-light);
  border-radius: 12px;
  background: palette(light-light);
}

.imageQualityField {
  flex: 0 0 230px;
  max-width: 100%;
}

.imageQualitySetup p {
  margin: 0 0 4px;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 10px;
  line-height: 1.45;
}

.factsAndRisks {
  display: grid;
  grid-template-columns: 1fr 0.55fr;
  gap: space(4);
}

.factsAndRisks > div {
  padding: density(4);
  border-radius: 11px;
  background: palette(light-light);
}

.factsAndRisks h4,
.unitsHeading h4 {
  margin: 0 0 8px;
  color: palette(primary-dark);
  @ds-typo (h4);
  font-size: 11px;
}

.factsAndRisks ul {
  display: grid;
  gap: space(2);
  margin: 0;
  padding: 0;
  list-style: none;
}

.factsAndRisks li,
.factsAndRisks p {
  margin: 0;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 10px;
  line-height: 1.45;
}

.factsAndRisks li small {
  display: block;
  margin-top: density(1);
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 8px;
}

.factsAndRisks li span {
  display: inline-block;
  margin-right: space(3);
  padding: density(1) density(2);
  border-radius: 4px;
  background: palette(surface-light);
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 8px;
  font-weight: 800;
}

.editor {
  display: grid;
  gap: space(4);
}

.unitsHeading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: space(5);
  margin-top: space(2);
}

.unitsHeading h4 {
  margin-bottom: space(1);
}

.unitsHeading p {
  margin: 0;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 10px;
}

.unitsHeading button,
.unitActions button {
  border: 1px solid palette(surface-light);
  border-radius: 7px;
  background: palette(light-light);
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 10px;
  font-weight: 750;
  cursor: pointer;
}

.unitsHeading button {
  height: 32px;
  padding: 0 11px;
}

.units {
  display: grid;
  gap: space(4);
}

.narrativeReview {
  padding: density(4);
  border: border(1, palette(warning-light), solid);
  border-radius: radius(2);
  background: palette(light-light);
  color: palette(warning-dark);
}

.narrativeReview strong {
  @ds-typo (caption);
  font-weight: 800;
}

.narrativeReview ul {
  display: grid;
  gap: density(1);
  margin: density(2) 0 0;
  padding-left: density(5);
}

.narrativeReview li {
  @ds-typo (caption);
  font-size: 10px;
  line-height: 1.45;
}

.unit {
  display: grid;
  gap: space(4);
  padding: density(5);
  border: 1px solid palette(surface-light);
  border-radius: 13px;
  background: palette(light-light);
}

.unit > header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: space(4);
}

.unit > header > div:first-child {
  display: flex;
  align-items: center;
  gap: space(3);
}

.unit > header span {
  padding: density(2) density(3);
  border-radius: 6px;
  background: palette(surface-light);
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 8px;
  font-weight: 800;
  text-transform: uppercase;
}

.unit > header strong {
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 11px;
}

.unitActions {
  display: flex;
  gap: space(2);
}

.unitActions button {
  width: 28px;
  height: 28px;
}

.factPicker {
  display: flex;
  flex-wrap: wrap;
  gap: space(3);
  margin: 0;
  padding: density(3);
  border: 1px solid palette(surface-light);
  border-radius: 9px;
}

.factPicker legend {
  padding: 0 5px;
}

.factPicker label {
  display: flex;
  align-items: center;
  gap: space(2);
  padding: density(2) density(3);
  border-radius: 6px;
  background: palette(light-light);
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 9px;
  font-weight: 700;
  cursor: pointer;
}

.factPicker input {
  accent-color: palette(primary-dark);
}

.approvalBar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: space(6);
  margin-top: space(5);
  padding-top: density(5);
  border-top: 1px solid palette(surface-light);
}

.approvalBar > div:first-child {
  display: flex;
  flex-direction: column;
  gap: space(1);
}

.approvalBar strong {
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 11px;
}

.approvalBar small {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 9px;
}

.approvalBar > div:last-child {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: space(3);
}

.footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: space(5);
  padding: density(5) density(1) 0;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 9px;
}

.footer a {
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 10px;
  font-weight: 800;
  text-decoration: none;
}

.assetLoading {
  padding: density(6);
  border: 1px dashed palette(surface-light);
  border-radius: 12px;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 11px;
  text-align: center;
}

.generateDraftCard .assetVariantHint {
  color: palette(primary-main);
  @ds-typo (caption);
  font-size: 10px;
}

.assetWorkspace {
  display: grid;
  gap: space(5);
}

.assetBatchSummary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: space(5);
  padding: density(4) density(5);
  border-radius: 12px;
  background: palette(light-light);
}

.assetBatchSummary strong {
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 12px;
}

.assetBatchSummary p {
  margin: space(1) 0 0;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 10px;
  line-height: 1.45;
}

.assetBatchSummary small {
  flex: 0 0 auto;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 9px;
  font-weight: 750;
}

.assetGrid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: space(5);
}

.assetCard {
  display: grid;
  align-content: start;
  gap: space(4);
  min-width: 0;
  padding: density(4);
  border: 1px solid palette(surface-light);
  border-radius: 14px;
  background: palette(light-light);
}

.assetCard > header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: space(4);
}

.assetCard > header > div {
  display: flex;
  flex-direction: column;
  gap: space(1);
}

.assetCard > header strong {
  color: palette(dark-main);
  @ds-typo (caption);
  font-size: 12px;
}

.assetCard > header small {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 9px;
}

.assetStatus {
  padding: density(2) density(3);
  border-radius: 999px;
  background: palette(light-light);
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 8px;
  font-weight: 800;
  text-transform: uppercase;
}

.assetApproved {
  background: palette(surface-light);
  color: palette(primary-dark);
}

.assetFailed {
  background: palette(error-light);
  color: palette(error-dark);
}

.assetPreview {
  position: relative;
  overflow: hidden;
  width: 100%;
  border: 1px solid palette(surface-light);
  border-radius: 11px;
  background: palette(light-light);
}

.assetPreview img {
  object-fit: contain;
}

.assetPlaceholder {
  display: grid;
  height: 100%;
  place-content: center;
  justify-items: center;
  gap: space(3);
  padding: density(6);
  color: palette(tertiary-main);
  text-align: center;
}

.assetPlaceholder strong {
  @ds-typo (caption);
  font-size: 11px;
}

.assetPlaceholder small {
  max-width: 300px;
  @ds-typo (caption);
  font-size: 9px;
  line-height: 1.45;
}

.assetSpinner {
  width: 24px;
  height: 24px;
  border: 3px solid palette(surface-light);
  border-top-color: palette(primary-dark);
  border-radius: 50%;
  animation: asset-spin 0.8s linear infinite;
}

@keyframes asset-spin {
  to {
    transform: rotate(360deg);
  }
}

.expectedText {
  padding: density(3) density(4);
  border: 1px solid palette(surface-light);
  border-radius: 9px;
  background: palette(light-light);
}

.expectedText span {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.expectedText p {
  margin: space(2) 0 0;
  color: palette(dark-main);
  @ds-typo (caption);
  font-size: 11px;
  font-weight: 650;
  line-height: 1.45;
  white-space: pre-wrap;
}

.assetSafety {
  padding: density(3) density(3);
  border: 1px solid palette(error-light);
  border-radius: 8px;
  background: palette(light-light);
  color: palette(error-dark);
  @ds-typo (caption);
  font-size: 9px;
}

.assetTextWarning {
  padding: density(3) density(3);
  border: 1px solid palette(warning-light);
  border-radius: 8px;
  background: palette(warning-light);
  color: palette(warning-dark);
  @ds-typo (caption);
  font-size: 9px;
  line-height: 1.4;
}

.assetPrompt {
  border: 1px solid palette(surface-light);
  border-radius: 9px;
  background: palette(light-light);
}

.assetPrompt summary {
  padding: density(3) density(4);
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 9px;
  font-weight: 750;
  cursor: pointer;
}

.assetPrompt textarea {
  width: calc(100% - 20px);
  margin: 0 10px 10px;
  padding: density(3);
  border: 1px solid palette(surface-light);
  border-radius: 8px;
  outline: none;
  background: palette(light-light);
  color: palette(dark-main);
  font: inherit;
  @ds-typo (caption);
  font-size: 10px;
  line-height: 1.45;
  resize: vertical;
}

.assetActions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: space(4);
}

.assetActions > div {
  display: flex;
  align-items: center;
  gap: space(3);
}

.assetActions a {
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 9px;
  font-weight: 750;
  text-decoration: none;
}

.assetActions small {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 8px;
}

.assetActions button {
  min-height: 34px;
  padding: 0 11px;
}

@media (max-width: 800px) {
  .backdrop {
    padding: density(3);
  }

  .workspace {
    max-height: calc(100svh - 20px);
    border-radius: 16px;
  }

  .header,
  .body {
    padding: density(5);
  }

  .fieldGrid,
  .briefCopyGrid,
  .historicalDraftFields,
  .formatOptions,
  .factsAndRisks,
  .recommendation,
  .assetGrid {
    grid-template-columns: 1fr;
  }

  .sliders {
    grid-template-columns: repeat(2, 1fr);
  }

  .briefCallout,
  .generateDraftCard,
  .historyCallout,
  .draftSetup,
  .imageQualitySetup,
  .approvalBar,
  .assetBatchSummary,
  .footer {
    align-items: stretch;
    flex-direction: column;
  }

  .historyActions {
    width: 100%;
  }

  .historyActions button {
    flex: 1;
  }

  .approvalBar > div:last-child {
    width: 100%;
  }

  .approvalBar button {
    flex: 1;
  }

  .assetActions {
    align-items: stretch;
    flex-direction: column;
  }

  .assetActions > div:last-child button {
    flex: 1;
  }
}

@media (max-width: 520px) {
  .progress {
    align-items: stretch;
    flex-direction: column;
  }

  .section {
    padding: density(5);
  }

  .sectionHeading {
    align-items: flex-start;
    flex-direction: column;
  }

  .sliders {
    grid-template-columns: 1fr;
  }
}
