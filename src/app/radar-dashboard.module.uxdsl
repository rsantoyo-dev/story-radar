.appShell {
  display: flex;
  min-height: 100svh;
  background: palette(light-light);
}

.sidebar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  flex: 0 0 248px;
  width: 248px;
  height: 100svh;
  flex-direction: column;
  padding: space(6) space(5);
  overflow-y: auto;
  background: palette(dark-main);
  color: palette(light-light);
  box-shadow: shadow(3);
}

.sidebarHeader {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: space(4);
  padding: 0 space(3);
}

.sidebar .brand {
  gap: space(4);
}

.sidebar .brand h1 {
  color: palette(light-light);
  @ds-typo (h1);
  font-size: space(5);
}

.sidebar .eyebrow {
  color: palette(primary-main);
  @ds-typo (caption);
  font-size: 0.625rem;
}

.sidebar .logo {
  width: 36px;
  height: 36px;
  background: palette(dark-main);
  box-shadow: none;
}

.sidebar .logo::before {
  width: 21px;
  height: 21px;
}

.sidebar .logo::after {
  width: 12px;
  height: 12px;
}

.closeSidebarButton,
.menuButton {
  display: none;
  border: 0;
  background: transparent;
  color: inherit;
  cursor: pointer;
}

.closeSidebarButton {
  padding: 0 space(2);
  color: palette(primary-light);
  @ds-typo (body);
  font-size: space(6);
  line-height: 1;
}

.sidebarNav {
  display: grid;
  gap: density(1);
  margin-top: space(10);
}

.navLabel {
  margin: 0 space(3) space(3);
  color: palette(primary-main);
  @ds-typo (caption);
  font-size: 0.625rem;
  font-weight: 750;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.sidebarNav a {
  display: flex;
  align-items: center;
  gap: space(4);
  min-height: 2.75rem;
  padding: 0 space(4);
  border: 1px solid transparent;
  border-radius: radius(2);
  color: palette(primary-light);
  @ds-typo (small);
  font-size: 0.8125rem;
  font-weight: 620;
  text-decoration: none;
  transition: background 150ms ease, border-color 150ms ease, color 150ms ease;
}

.sidebarNav a:hover,
.sidebarNav a:focus-visible {
  border-color: palette(primary-light, 0.14);
  outline: 0;
  background: palette(primary-light, 0.11);
  color: palette(light-light);
}

.navIcon {
  display: grid;
  width: 19px;
  height: 19px;
  place-items: center;
  color: palette(primary-light);
  @ds-typo (body);
  font-size: space(5);
  line-height: 1;
}

.sidebarFooter {
  margin-top: auto;
  padding: space(5) space(3) 0;
  border-top: 1px solid palette(primary-light, 0.14);
}

.sidebarFooter .environment {
  border-color: palette(primary-light, 0.16);
  background: palette(light-light, 0.06);
  color: palette(primary-light);
}

.sidebarFooter p {
  margin: space(4) space(1) 0;
  color: palette(primary-main);
  @ds-typo (caption);
  font-size: 0.6875rem;
  line-height: 1.5;
}

.sidebarBackdrop {
  display: none;
}

.appMain {
  min-width: 0;
  flex: 1;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  min-height: 76px;
  align-items: center;
  justify-content: space-between;
  gap: space(7);
  padding-block: space(4);
  padding-inline: density(5);
  border-bottom: 1px solid palette(dark-main, 0.09);
  background: palette(light-light, 0.88);
  backdrop-filter: blur(18px);
}

.topbarLeft,
.currentTopic,
.topicSelectWrap,
.topbarTools {
  display: flex;
  align-items: center;
}

.topbarLeft {
  min-width: 0;
  gap: space(5);
}

.topbarTools {
  min-width: 0;
  justify-content: flex-end;
  gap: space(3);
}

.secretControl {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: space(3);
}

.secretField {
  display: flex;
  align-items: center;
  min-width: 16rem;
  gap: space(4);
}

.secretField > span {
  color: palette(tertiary-main);
  @ds-typo(caption);
  font-size: 0.625rem;
  font-weight: 750;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  white-space: nowrap;
}

.secretField input {
  @ds-input(outlined primary 2);
  box-sizing: border-box;
  min-width: 0;
  flex: 1;
  min-height: 40px;
  padding: density(1) density(3);
  border-color: palette(surface-dark);
  background: palette(light-light);
  color: palette(dark-main);
  @ds-typo(caption);
}

.secretField input:focus-visible {
  border-color: palette(primary-main);
  box-shadow: 0 0 0 4px palette(primary-main, 0.12);
}

.topbarStatus {
  flex: none;
  padding: density(1) density(2);
  white-space: nowrap;
}

.currentTopic {
  gap: space(4);
}

.topbarLabel {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 0.625rem;
  font-weight: 750;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  white-space: nowrap;
}

.topicSelectWrap {
  position: relative;
  min-width: min(260px, 42vw);
}

.topicSelectWrap::before {
  position: absolute;
  z-index: 1;
  top: 50%;
  left: space(3);
  width: 8px;
  height: 8px;
  border-radius: radius(5);
  background: palette(primary-main);
  box-shadow: 0 0 0 3px palette(primary-main, 0.14);
  content: "";
  pointer-events: none;
  transform: translateY(-50%);
}

.topicSelectWrap select {
  @ds-input(outlined primary 2);
  min-height: 40px;
  padding: 0 space(9) 0 space(7);
  border-color: palette(surface-dark);
  background: palette(light-light);
  color: palette(dark-main);
  @ds-typo (small);
  font-size: 0.8125rem;
  font-weight: 700;
  cursor: pointer;
}

.topicSelectWrap select:focus-visible {
  border-color: palette(primary-main);
  box-shadow: 0 0 0 4px palette(primary-main, 0.12);
}

.topicSelectWrap select:disabled {
  cursor: not-allowed;
  opacity: 0.58;
}

.topicSelectWrap > span {
  position: absolute;
  top: 50%;
  right: space(4);
  color: palette(primary-main);
  @ds-typo (h4);
  font-size: 16px;
  pointer-events: none;
  transform: translateY(-55%);
}

.topicLoadingIndicator {
  animation: topic-spin 700ms linear infinite;
}

@keyframes topic-spin {
  from { transform: translateY(-55%) rotate(0deg); }
  to { transform: translateY(-55%) rotate(360deg); }
}

.page {
  min-height: calc(100svh - 76px);
  padding-block: space(9) space(11);
  padding-inline: density(5);
  color: palette(dark-main);
  background:
    radial-gradient(circle at 8% 0%, palette(primary-light, 0.62), transparent 30rem),
    radial-gradient(circle at 94% 14%, palette(info-light, 0.68), transparent 34rem),
    palette(light-light);
}

.shell {
  width: min(1240px, 100%);
  margin: 0 auto;
  transition: opacity 160ms ease, filter 160ms ease;
}

.topicSwitching {
  filter: saturate(0.82);
  opacity: 0.58;
  pointer-events: none;
}

.anchorTarget {
  scroll-margin-top: space(10);
}

.anchorTarget + .anchorTarget {
  margin-top: density(3);
}

.brand,
.panelHeading,
.buttonRow,
.notice {
  display: flex;
  align-items: center;
}

.brand {
  gap: space(4);
}

.brand h1 {
  margin: space(1) 0 0;
  @ds-typo (h1);
  font-size: space(5);
  line-height: 1;
  letter-spacing: -0.04em;
}

.eyebrow,
.kicker,
.sectionNumber {
  margin: 0;
  color: palette(primary-main);
  @ds-typo (caption);
  font-size: 0.6875rem;
  font-weight: 750;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.logo {
  position: relative;
  display: grid;
  width: 42px;
  height: 42px;
  place-items: center;
  border-radius: 50%;
  background: palette(dark-main);
  box-shadow: shadow(3);
}

.logo::before,
.logo::after,
.logo span {
  position: absolute;
  border: 1.5px solid palette(primary-light);
  border-radius: 50%;
  content: "";
}

.logo::before {
  width: 24px;
  height: 24px;
  border-left-color: transparent;
}

.logo::after {
  width: 14px;
  height: 14px;
  border-bottom-color: transparent;
}

.logo span {
  width: 4px;
  height: 4px;
  border: 0;
  background: palette(primary-main);
}

.environment,
.online,
.idle {
  display: inline-flex;
  align-items: center;
  gap: space(3);
  padding: space(3) space(4);
  border: 1px solid palette(dark-main, 0.1);
  border-radius: radius(pill);
  background: palette(light-light, 0.58);
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 0.75rem;
  font-weight: 650;
  backdrop-filter: blur(10px);
}

.environment::before,
.online::before,
.idle::before {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: palette(primary-main);
  content: "";
  box-shadow: 0 0 0 3px palette(primary-main, 0.15);
}

.idle::before {
  background: palette(surface-dark);
  box-shadow: none;
}

.hero {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: space(10);
  align-items: end;
  margin-bottom: space(7);
}

.hero h2 {
  max-width: 43rem;
  margin: space(3) 0 space(4);
  color: palette(dark-main);
  @ds-typo (h2);
  font-size: clamp(38px, 6vw, 70px);
  font-weight: 620;
  line-height: 0.98;
  letter-spacing: -0.062em;
}

.hero > div > p:last-child {
  max-width: 39rem;
  margin: 0;
  color: palette(primary-main);
  @ds-typo (body);
  font-size: space(5);
  line-height: 1.65;
}

.heroMetric {
  min-width: 9.375rem;
  padding: 0 0 space(3) space(6);
  border-left: 1px solid palette(dark-main, 0.14);
}

.heroMetric span,
.heroMetric small {
  display: block;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 0.75rem;
}

.heroMetric strong {
  display: block;
  margin: space(2) 0;
  @ds-typo (body);
  font-size: space(8);
  font-weight: 600;
  letter-spacing: -0.06em;
}

.mainGrid {
  display: grid;
  grid-template-columns: minmax(0, 1.08fr) minmax(360px, 0.92fr);
  gap: density(3);
}

.panel {
  @ds-surface(contained surface 3);
  padding: density(6);
  border: 1px solid palette(dark-main, 0.1);
  background: palette(light-light, 0.8);
  box-shadow: shadow(4);
  backdrop-filter: blur(18px);
}

.panelHeading {
  justify-content: space-between;
  margin-bottom: space(6);
}

.panel h2 {
  margin: space(2) 0 0;
  @ds-typo (h2);
  font-size: space(5);
  font-weight: 650;
  letter-spacing: -0.03em;
}

.field {
  display: block;
  margin-top: space(5);
}

.field > span {
  display: block;
  margin-bottom: space(3);
  color: palette(primary-dark);
  @ds-typo (small);
  font-size: 0.8125rem;
  font-weight: 650;
}

.field input {
  @ds-input(outlined primary 2);
  height: 48px;
  padding: 0 space(4);
  border-color: palette(surface-dark);
  background: palette(light-light, 0.84);
  color: palette(dark-main);
  transition: border-color 160ms ease, box-shadow 160ms ease;
}

.field input:focus {
  border-color: palette(primary-main);
  box-shadow: 0 0 0 4px palette(primary-main, 0.12);
}

.field small {
  display: block;
  margin-top: space(3);
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 0.6875rem;
}

.inputSuffix {
  position: relative;
}

.inputSuffix input {
  padding-right: space(10);
}

.inputSuffix > span {
  position: absolute;
  top: 50%;
  right: space(4);
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 0.75rem;
  transform: translateY(-50%);
}

.buttonRow {
  gap: density(2);
  margin-top: space(6);
}

.buttonRow button {
  @ds-button(contained primary 2);
  min-height: 45px;
  padding: 0 space(5);
  @ds-typo (small);
  font-size: 0.8125rem;
  font-weight: 700;
  cursor: pointer;
  transition: transform 150ms ease, opacity 150ms ease, box-shadow 150ms ease;
}

.buttonRow button:hover:not(:disabled) {
  transform: translateY(-1px);
}

.buttonRow button:disabled {
  cursor: not-allowed;
  opacity: 0.42;
}

.primaryButton {
  @ds-button(contained dark 2);
  flex: 1;
  box-shadow: shadow(3);
}

.secondaryButton {
  @ds-button(outlined primary 2);
}

.statsGrid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: density(2);
}

.metric {
  @ds-surface(contained light 2);
  padding: space(5);
  border: 1px solid palette(dark-main, 0.08);
  background: palette(light-light);
}

.metric span,
.lastRun span {
  display: block;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 0.6875rem;
}

.metric strong {
  display: block;
  margin-top: space(3);
  @ds-typo (body);
  font-size: space(6);
  font-weight: 620;
  letter-spacing: -0.05em;
}

.statusList {
  margin-top: space(6);
}

.statusList > p {
  margin: 0 0 space(3);
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 0.6875rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.statusList > div:not(.emptyState) {
  display: flex;
  justify-content: space-between;
  padding: space(3) space(1);
  border-bottom: 1px solid palette(light-light);
  color: palette(primary-dark);
  @ds-typo (small);
  font-size: 0.8125rem;
}

.statusList strong {
  color: palette(dark-main);
}

.emptyState {
  padding: space(5) 0;
  color: palette(tertiary-main);
  @ds-typo (small);
  font-size: 0.8125rem;
}

.lastRun {
  @ds-surface(contained dark 2);
  margin-top: space(5);
  padding: space(4) space(5);
  color: palette(light-light);
}

.lastRun span,
.lastRun small {
  color: palette(surface-dark);
}

.lastRun strong,
.lastRun small {
  display: block;
  margin-top: space(2);
}

.lastRun strong {
  @ds-typo (small);
  font-size: 0.875rem;
}

.lastRun small {
  @ds-typo (caption);
  font-size: 0.6875rem;
}

.notice {
  @ds-surface(outlined surface 2);
  gap: space(4);
  margin-top: density(3);
  padding: space(5) space(6);
}

.notice > span {
  display: grid;
  flex: 0 0 space(6);
  width: space(6);
  height: space(6);
  place-items: center;
  border-radius: 50%;
  font-weight: 800;
}

.notice strong,
.notice p {
  display: block;
  margin: 0;
  @ds-typo (small);
  font-size: 0.8125rem;
}

.notice p {
  margin-top: space(1);
  opacity: 0.78;
}

.noticeSuccess {
  border-color: palette(primary-light);
  background: palette(light-light);
  color: palette(dark-main);
}

.noticeSuccess > span {
  background: palette(primary-light);
}

.noticeError {
  border-color: palette(error-light);
  background: palette(light-light);
  color: palette(error-dark);
}

.noticeError > span {
  background: palette(error-light);
}

.preferencesPanel {
  margin-top: density(3);
}

.savedBadge,
.unsavedBadge {
  padding: density(1) density(2);
  border: 1px solid;
  border-radius: 999px;
  @ds-typo (caption);
  font-size: 11px;
  font-weight: 700;
}

.savedBadge {
  border-color: palette(primary-light);
  background: palette(light-light);
  color: palette(primary-dark);
}

.unsavedBadge {
  border-color: palette(warning-light);
  background: palette(light-light);
  color: palette(warning-dark);
}

.preferencesIntro,
.preferencesFooter {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: space(5);
}

.preferencesIntro {
  margin: calc(space(3) * -1) 0 space(5);
}

.preferencesIntro p {
  max-width: 670px;
  margin: 0;
  color: palette(tertiary-main);
  @ds-typo (small);
  font-size: 13px;
  line-height: 1.55;
}

.preferencesIntro > span {
  flex: 0 0 auto;
  padding: density(1) density(2);
  border-radius: 8px;
  background: palette(light-light);
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 11px;
  font-weight: 750;
}

.preferencesGrid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: space(4);
}

.termField {
  @ds-surface(flat surface 4);
  display: block;
  padding: density(4);
  border: 1px solid palette(surface-light);
  border-radius: 15px;
  background: palette(light-light);
}

.termField > span {
  display: flex;
  align-items: center;
  gap: density(1);
  margin-bottom: space(3);
  color: palette(primary-dark);
  @ds-typo (small);
  font-size: 13px;
  font-weight: 700;
}

.termField > span::before {
  display: inline-grid;
  width: 20px;
  height: 20px;
  place-items: center;
  border-radius: 6px;
  @ds-typo (small);
  font-size: 13px;
  content: "+";
}

.favoredLabel::before {
  background: palette(primary-light);
  color: palette(primary-dark);
}

.termField > .unfavoredLabel::before {
  background: palette(error-light);
  color: palette(error-main);
  content: "−";
}

.termField textarea {
  @ds-input(outlined primary 3);
  width: 100%;
  min-height: 154px;
  padding: density(3);
  resize: vertical;
  border: 1px solid palette(surface-light);
  border-radius: 11px;
  outline: 0;
  background: palette(light-light);
  color: palette(dark-main);
  font: inherit;
  @ds-typo (small);
  font-size: 13px;
  line-height: 1.55;
  transition: border-color 160ms ease, box-shadow 160ms ease;
}

.termField textarea:focus {
  border-color: palette(primary-main);
  box-shadow: 0 0 0 4px palette(primary-main, 0.12);
}

.termField small {
  display: block;
  margin-top: space(3);
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 11px;
}

.preferencesFooter {
  margin-top: space(5);
}

.preferencesFooter > small {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 11px;
}

.savePreferencesButton {
  @ds-button(contained primary 3);
  min-height: 43px;
  padding: 0 density(4);
  border: 1px solid palette(primary-dark);
  border-radius: 11px;
  background: palette(primary-dark);
  color: palette(light-light);
  font: inherit;
  @ds-typo (small);
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 9px 22px palette(primary-dark, 0.14);
  transition: transform 150ms ease, opacity 150ms ease;
}

.savePreferencesButton:hover:not(:disabled) {
  transform: translateY(-1px);
}

.savePreferencesButton:disabled {
  cursor: not-allowed;
  opacity: 0.42;
}

.optimizationPanel {
  margin-top: space(5);
  overflow: hidden;
}

.runBadge {
  padding: density(1) density(2);
  border: 1px solid palette(surface-light);
  border-radius: 999px;
  background: palette(light-light);
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 11px;
  font-weight: 700;
}

.optimizationMetrics {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: space(3);
}

.optimizationMetric {
  min-width: 0;
  padding: density(4);
  border: 1px solid palette(dark-main, 0.08);
  border-radius: 14px;
  background: linear-gradient(145deg, palette(light-light), palette(light-light));
}

.optimizationMetric span,
.optimizationMetric small {
  display: block;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 11px;
}

.optimizationMetric strong {
  display: block;
  margin: space(2) 0 space(2);
  color: palette(dark-main);
  @ds-typo (h2);
  font-size: 28px;
  font-weight: 620;
  letter-spacing: -0.055em;
}

.optimizationMetric small {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.efficiencyGrid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: space(3);
  margin-top: space(4);
}

.efficiencyItem {
  padding: density(4);
  border-radius: 15px;
  background: palette(dark-main);
  color: palette(light-light);
}

.efficiencyItem > div:first-child {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: space(5);
}

.efficiencyItem span {
  color: palette(primary-light);
  @ds-typo (caption);
  font-size: 12px;
  font-weight: 650;
}

.efficiencyItem strong {
  color: palette(primary-main);
  @ds-typo (h3);
  font-size: 22px;
  font-weight: 650;
  letter-spacing: -0.04em;
}

.efficiencyItem small {
  display: block;
  margin-top: space(3);
  color: palette(primary-main);
  @ds-typo (caption);
  font-size: 11px;
}

.progressTrack {
  height: 6px;
  margin-top: space(4);
  overflow: hidden;
  border-radius: 99px;
  background: palette(light-light, 0.12);
}

.progressTrack span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, palette(primary-main), palette(primary-main));
  transition: width 500ms ease;
}

.relevanceStrip {
  display: flex;
  flex-wrap: wrap;
  gap: density(1);
  margin-top: space(4);
}

.relevanceStrip span {
  padding: density(1) density(2);
  border: 1px solid palette(surface-light);
  border-radius: 9px;
  background: palette(light-light);
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 11px;
}

.relevanceStrip strong {
  color: palette(dark-main);
  @ds-typo (caption);
  font-size: 12px;
}

.optimizationEmpty {
  padding: density(6) density(4);
  border: 1px dashed palette(surface-light);
  border-radius: 14px;
  color: palette(tertiary-main);
  text-align: center;
  @ds-typo (small);
  font-size: 13px;
}

.editorialPanel {
  margin-top: space(5);
}

.aiBadge {
  padding: density(1) density(2);
  border: 1px solid palette(info-light);
  border-radius: 999px;
  background: palette(light-light);
  color: palette(info-main);
  @ds-typo (caption);
  font-size: 11px;
  font-weight: 700;
}

.editorialIntro {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: space(6);
  margin: calc(space(3) * -1) 0 space(5);
}

.editorialIntro p,
.editorialIntro small {
  display: block;
  margin: 0;
  color: palette(tertiary-main);
  @ds-typo (small);
  font-size: 13px;
  line-height: 1.55;
}

.editorialIntro small {
  margin-top: space(2);
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 11px;
}

.evaluateButton {
  @ds-button(contained primary 3);
  flex: 0 0 auto;
  min-height: 44px;
  padding: 0 density(4);
  border: 1px solid palette(info-dark);
  border-radius: 11px;
  background: palette(info-dark);
  color: palette(light-light);
  font: inherit;
  @ds-typo (small);
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 9px 22px palette(info-dark, 0.18);
  transition: transform 150ms ease, opacity 150ms ease;
}

.evaluateButton:hover:not(:disabled) {
  transform: translateY(-1px);
}

.evaluateButton:disabled {
  cursor: not-allowed;
  opacity: 0.42;
}

.aiMetrics {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: space(3);
}

.aiRunSummary {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: density(2) space(5);
  margin-top: space(3);
  padding: density(3);
  border: 1px solid palette(surface-light);
  border-radius: 11px;
  background: palette(light-light);
  color: palette(info-main);
  @ds-typo (caption);
  font-size: 11px;
}

.aiRunSummary strong {
  color: palette(info-dark);
  text-transform: capitalize;
}

.reviewToolbar {
  display: flex;
  align-items: center;
  gap: density(3);
  margin-bottom: space(3);
  padding: density(3);
  border: 1px solid palette(surface-light);
  border-radius: 13px;
  background: palette(light-light);
}

.selectAllControl,
.reviewActions {
  display: flex;
  align-items: center;
}

.selectAllControl {
  gap: density(1);
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}

.selectAllControl input,
.storyCheckbox {
  width: 17px;
  height: 17px;
  accent-color: palette(primary-dark);
  cursor: pointer;
}

.selectionCount {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 11px;
}

.reviewActions {
  gap: density(1);
  margin-left: auto;
}

.reviewActions button {
  @ds-button(contained primary 2);
  min-height: 37px;
  padding: 0 density(3);
  border-radius: 9px;
  font: inherit;
  @ds-typo (caption);
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: transform 150ms ease, opacity 150ms ease;
}

.reviewActions button:hover:not(:disabled) {
  transform: translateY(-1px);
}

.reviewActions button:disabled {
  cursor: not-allowed;
  opacity: 0.42;
}

.rejectStoriesButton {
  border: 1px solid palette(error-light);
  background: palette(light-light);
  color: palette(error-main);
}

.approveStoriesButton {
  border: 1px solid palette(primary-dark);
  background: palette(primary-dark);
  color: palette(light-light);
  box-shadow: 0 7px 18px palette(primary-dark, 0.14);
}

.storyWorkspaceHeader,
.tableViewHeading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: space(5);
}

.storyWorkspaceHeader {
  margin-top: space(7);
  padding-top: space(6);
  border-top: 1px solid palette(surface-light);
}

.storyWorkspaceHeader h3,
.storyWorkspaceHeader p,
.tableViewHeading h3,
.tableViewHeading p {
  margin: 0;
}

.storyWorkspaceHeader h3,
.tableViewHeading h3 {
  color: palette(dark-main);
  @ds-typo (h3);
  font-size: 16px;
  letter-spacing: -0.025em;
}

.storyWorkspaceHeader p,
.tableViewHeading p {
  margin-top: space(2);
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 11px;
  line-height: 1.45;
}

.storyTabs {
  display: inline-flex;
  flex: 0 0 auto;
  gap: density(1);
  padding: density(1);
  border: 1px solid palette(surface-light);
  border-radius: 12px;
  background: palette(light-light);
}

.storyTabs button {
  display: inline-flex;
  align-items: center;
  gap: density(1);
  min-height: 36px;
  padding: 0 density(3);
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: palette(tertiary-main);
  font: inherit;
  @ds-typo (caption);
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}

.storyTabs button span {
  display: inline-grid;
  min-width: 21px;
  height: 21px;
  padding: 0 density(1);
  place-items: center;
  border-radius: 999px;
  background: palette(dark-main, 0.08);
  @ds-typo (caption);
  font-size: 10px;
}

.storyTabs .activeStoryTab {
  background: palette(light-light);
  color: palette(dark-main);
  box-shadow: 0 3px 10px palette(dark-main, 0.09);
}

.tableViewHeading {
  margin: space(5) 0 space(3);
}

.tableViewHeading > span {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 11px;
  font-weight: 700;
}

.storyFilterBar {
  display: flex;
  align-items: end;
  flex-wrap: wrap;
  gap: density(2);
  margin-bottom: space(3);
  padding: density(3);
  border: 1px solid palette(surface-light);
  border-radius: 13px;
  background: palette(light-light);
}

.storyFilterFields {
  display: flex;
  flex: 1 1 540px;
  flex-wrap: wrap;
  gap: density(2);
}

.storyFilterField {
  display: grid;
  min-width: 104px;
  gap: density(1);
}

.storyFilterField > span {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 10px;
  font-weight: 700;
}

.storyFilterField select,
.storyFilterField input {
  @ds-input(outlined primary 2);
  box-sizing: border-box;
  min-height: 34px;
  border: 1px solid palette(surface-light);
  border-radius: 8px;
  background: palette(light-light);
  color: palette(dark-main);
  font: inherit;
  @ds-typo (caption);
  font-size: 12px;
}

.storyFilterField select {
  min-width: 134px;
  padding: 0 density(2);
}

.storyFilterField input {
  width: 86px;
  padding: 0 density(2);
}

.storyFilterField select:focus,
.storyFilterField input:focus {
  outline: 2px solid palette(primary-dark, 0.23);
  outline-offset: 1px;
  border-color: palette(primary-main);
}

.topicFloorControl {
  display: inline-flex;
  align-items: center;
  gap: density(1);
  min-height: 34px;
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 11px;
  font-weight: 700;
  white-space: nowrap;
  cursor: pointer;
}

.topicFloorControl input {
  width: 16px;
  height: 16px;
  margin: 0;
  accent-color: palette(primary-dark);
  cursor: pointer;
}

.clearStoryFiltersButton {
  @ds-button(outlined primary 2);
  min-height: 34px;
  padding: 0 density(2);
  border: 1px solid palette(surface-light);
  border-radius: 8px;
  background: palette(light-light);
  color: palette(tertiary-main);
  font: inherit;
  @ds-typo (caption);
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
}

.clearStoryFiltersButton:hover {
  filter: brightness(0.98);
}

.storyFilterCount {
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 11px;
  font-weight: 750;
  white-space: nowrap;
}

.storyFilterHint {
  flex-basis: 100%;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 10px;
}

.storyTableShell {
  max-width: 100%;
  overflow: auto;
  border: 1px solid palette(surface-light);
  border-radius: 14px;
  background: palette(light-light);
  box-shadow: inset 0 1px 0 palette(light-light, 0.7);
}

.storyTable {
  width: 100%;
  min-width: 1710px;
  border-collapse: separate;
  border-spacing: 0;
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 11px;
}

.storyTable th {
  position: sticky;
  top: 0;
  z-index: 1;
  padding: 0;
  border-bottom: 1px solid palette(surface-light);
  background: palette(light-light);
  color: palette(tertiary-main);
  text-align: left;
  white-space: nowrap;
}

.tableHeaderLabel {
  display: flex;
  min-height: 43px;
  align-items: center;
  padding: 0 density(2);
  font-weight: 750;
}

.numericColumn .tableHeaderLabel {
  justify-content: flex-end;
}

.storyTable td {
  max-width: 180px;
  padding: density(3) density(2);
  border-bottom: 1px solid palette(light-light);
  background: palette(light-light);
  vertical-align: top;
}

.storyTable tbody tr:last-child td {
  border-bottom: 0;
}

.storyTable tbody tr:hover td {
  background: palette(light-light);
}

.storyTable .selectedTableRow td {
  background: palette(light-light);
}

.selectionColumn {
  width: 42px;
  min-width: 42px;
  text-align: center;
}

.unavailableSelection {
  color: palette(surface-dark);
}

.dateCell {
  width: 92px;
  color: palette(tertiary-main);
  white-space: nowrap;
}

.storyTitleCell {
  width: 360px;
  min-width: 290px;
  max-width: 390px !important;
}

.storyTitleCell > a {
  display: block;
  color: palette(dark-main);
  @ds-typo (caption);
  font-size: 12px;
  font-weight: 750;
  line-height: 1.4;
  text-decoration: none;
}

.storyTitleCell > a:hover {
  text-decoration: underline;
  text-underline-offset: 3px;
}

.storyTitleCell > small {
  display: -webkit-box;
  margin-top: space(2);
  overflow: hidden;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 10px;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.sourceCell {
  min-width: 130px;
  color: palette(primary-dark);
  font-weight: 650;
}

.numericColumn,
.scoreCell {
  width: 72px;
  text-align: right !important;
}

.scoreCell {
  color: palette(primary-dark);
  font-variant-numeric: tabular-nums;
  font-weight: 750;
}

.accentScoreCell {
  color: palette(info-dark);
}

.tableRiskFlags {
  display: flex;
  flex-wrap: wrap;
  gap: density(1);
  margin-top: space(2);
}

.tableRiskFlags span {
  padding: density(1);
  border-radius: 5px;
  background: palette(light-light);
  color: palette(error-main);
  @ds-typo (caption);
  font-size: 9px;
}

.storySourceLink {
  display: flex;
  max-width: 100%;
  align-items: center;
  gap: density(1);
  margin-top: space(2);
  color: palette(primary-main);
  @ds-typo (caption);
  font-size: 9px;
  line-height: 1.3;
  text-decoration: none;
}

.storySourceLink span {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.storySourceLink strong {
  flex: 0 0 auto;
  @ds-typo (caption);
  font-size: 10px;
}

.storySourceLink:hover {
  color: palette(primary-dark);
  text-decoration: underline;
  text-underline-offset: 2px;
}

.tableBadge {
  display: inline-flex;
  padding: density(1) density(2);
  border-radius: 7px;
  @ds-typo (caption);
  font-size: 9px;
  font-weight: 750;
  line-height: 1;
  white-space: nowrap;
}

.tableBadgeNeutral {
  background: palette(light-light);
  color: palette(tertiary-main);
}

.tableBadgePositive {
  background: palette(surface-light);
  color: palette(primary-dark);
}

.tableBadgeWarning {
  background: palette(warning-light);
  color: palette(warning-dark);
}

.tableBadgeNegative {
  background: palette(error-light);
  color: palette(error-main);
}

.publicationStatusCell {
  min-width: 154px;
}

.publicationStatusChips {
  display: flex;
  flex-wrap: wrap;
  gap: density(1);
}

.publicationNotTracked {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 10px;
  font-weight: 650;
  white-space: nowrap;
}

.publicationQuickControl {
  display: grid;
  width: 126px;
  gap: density(1);
}

.publicationQuickControl label {
  display: grid;
  gap: density(1);
}

.publicationQuickControl span,
.publicationQuickControl small {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 9px;
  font-weight: 700;
}

.publicationQuickControl select {
  @ds-input(outlined primary 2);
  width: 100%;
  min-height: 32px;
  padding: 0 density(2);
  border: 1px solid palette(surface-light);
  border-radius: 8px;
  background: palette(light-light);
  color: palette(primary-dark);
  font: inherit;
  @ds-typo (caption);
  font-size: 10px;
  font-weight: 700;
  cursor: pointer;
}

.publicationQuickControl select:focus {
  outline: 2px solid palette(primary-dark, 0.23);
  outline-offset: 1px;
  border-color: palette(primary-main);
}

.publicationQuickControl select:disabled {
  cursor: not-allowed;
  opacity: 0.52;
}

.contentStatusCell,
.contentActionsCell {
  display: flex;
  align-items: flex-start;
  flex-direction: column;
  gap: density(1);
}

.contentStatusCell small {
  max-width: 150px;
  overflow: hidden;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 9px;
  line-height: 1.35;
  text-overflow: ellipsis;
}

.contentStatusCell .enrichmentComplete {
  color: palette(primary-dark);
}

.contentStatusCell .enrichmentProblem {
  color: palette(error-main);
}

.contentActionsCell {
  min-width: 126px;
}

.prepareTableButton,
.viewContentButton,
.creativeStudioButton,
.promoteStoryButton {
  @ds-button(contained primary 2);
  min-height: 32px;
  padding: 0 density(2);
  border-radius: 8px;
  font: inherit;
  @ds-typo (caption);
  font-size: 10px;
  font-weight: 700;
  white-space: nowrap;
  cursor: pointer;
  transition: transform 150ms ease, opacity 150ms ease;
}

.prepareTableButton {
  border: 1px solid palette(primary-dark);
  background: palette(primary-dark);
  color: palette(light-light);
}

.viewContentButton {
  border: 1px solid palette(surface-light);
  background: palette(light-light);
  color: palette(primary-dark);
}

.creativeStudioButton {
  border: 1px solid palette(warning-dark);
  background: palette(warning-light);
  color: palette(warning-dark);
}

.promoteStoryButton {
  border: 1px solid palette(info-main);
  background: palette(light-light);
  color: palette(info-dark);
}

.prepareTableButton:hover:not(:disabled),
.viewContentButton:hover:not(:disabled),
.creativeStudioButton:hover:not(:disabled),
.promoteStoryButton:hover:not(:disabled) {
  transform: translateY(-1px);
}

.prepareTableButton:disabled,
.viewContentButton:disabled,
.creativeStudioButton:disabled,
.promoteStoryButton:disabled {
  cursor: not-allowed;
  opacity: 0.45;
}

.contentViewerBackdrop {
  position: fixed;
  z-index: 50;
  display: grid;
  padding: density(5);
  background: palette(dark-main, 0.48);
  inset: 0;
  place-items: center;
  backdrop-filter: blur(6px);
}

.contentViewer {
  display: flex;
  width: min(820px, 100%);
  max-height: min(820px, calc(100svh - 48px));
  overflow: hidden;
  border: 1px solid palette(light-light, 0.68);
  border-radius: 20px;
  background: palette(light-light);
  flex-direction: column;
  box-shadow: 0 30px 90px palette(dark-main, 0.3);
}

.contentViewerHeader {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: space(6);
  padding: density(5) density(5) density(4);
  border-bottom: 1px solid palette(surface-light);
}

.contentViewerHeader p,
.contentViewerHeader h2 {
  margin: 0;
}

.contentViewerHeader p {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 10px;
  font-weight: 750;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.contentViewerHeader h2 {
  max-width: 680px;
  margin-top: space(2);
  color: palette(dark-main);
  @ds-typo (h2);
  font-size: 21px;
  line-height: 1.28;
  letter-spacing: -0.035em;
}

.contentViewerHeader button {
  display: grid;
  width: 34px;
  height: 34px;
  flex: 0 0 auto;
  border: 1px solid palette(surface-light);
  border-radius: 50%;
  background: palette(light-light);
  color: palette(primary-dark);
  @ds-typo (h3);
  font-size: 22px;
  line-height: 1;
  cursor: pointer;
  place-items: center;
}

.contentViewerMeta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: density(1);
  padding: density(3) density(5);
  border-bottom: 1px solid palette(surface-light);
  background: palette(light-light);
}

.contentViewerMeta > span:not(.tableBadge) {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 10px;
}

.contentViewerBody {
  overflow: auto;
  padding: density(5);
}

.contentViewerBody > p {
  margin: 0;
  color: palette(dark-main);
  @ds-typo (small);
  font-size: 14px;
  line-height: 1.75;
  white-space: pre-wrap;
}

.contentViewerFooter {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: space(5);
  padding: density(4) density(5);
  border-top: 1px solid palette(surface-light);
  background: palette(light-light);
}

.contentViewerFooter a {
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 11px;
  font-weight: 750;
  text-decoration: none;
}

.contentViewerFooter a:hover {
  text-decoration: underline;
  text-underline-offset: 3px;
}

.contentViewerFooter span {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 10px;
}

.dangerPanel {
  display: grid;
  grid-template-columns: 1fr minmax(360px, 0.8fr);
  gap: space(9);
  margin-top: space(5);
  border-color: palette(error-main, 0.2);
  background: palette(light-light, 0.86);
}

.dangerCopy h2 {
  margin-top: space(3);
}

.dangerCopy > p:last-child {
  max-width: 530px;
  margin: space(3) 0 0;
  color: palette(error-main);
  @ds-typo (small);
  font-size: 13px;
  line-height: 1.6;
}

.dangerActions .field {
  margin-top: 0;
}

.dangerButton {
  border: 1px solid palette(error-light);
  background: palette(light-light);
  color: palette(error-main);
}

.regenerateButton {
  flex: 1;
  border: 1px solid palette(error-main);
  background: palette(error-main);
  color: palette(light-light);
}

@media (max-width: 960px) {
  .sidebar {
    position: fixed;
    left: 0;
    transform: translateX(-105%);
    transition: transform 180ms ease;
  }

  .sidebarOpen {
    transform: translateX(0);
  }

  .sidebarBackdrop {
    position: fixed;
    inset: 0;
    z-index: 15;
    display: block;
    width: 100%;
    border: 0;
    background: palette(dark-main, 0.42);
    cursor: pointer;
  }

  .closeSidebarButton,
  .menuButton {
    display: block;
  }

  .menuButton {
    display: grid;
    width: 34px;
    height: 34px;
    align-content: center;
    gap: space(2);
    padding: density(3);
    border: 1px solid palette(surface-light);
    border-radius: 9px;
    background: palette(light-light);
  }

  .menuButton span {
    display: block;
    width: 100%;
    height: 1.5px;
    border-radius: 999px;
    background: palette(primary-dark);
  }

  .topbar {
    padding-right: density(5);
    padding-left: density(5);
  }
}

@media (max-width: 800px) {
  .topbar {
    align-items: stretch;
    flex-direction: column;
    gap: space(4);
  }

  .topbarLeft,
  .currentTopic,
  .topbarTools {
    width: 100%;
  }

  .topbarLeft {
    align-items: flex-start;
    gap: space(4);
  }

  .currentTopic {
    min-width: 0;
    flex: 1;
    align-items: stretch;
    flex-direction: column;
    gap: density(1);
    margin-left: space(2);
  }

  .topicSelectWrap { width: 100%; min-width: 0; }

  .topbarTools { justify-content: flex-start; }

  .secretControl {
    display: grid;
    width: 100%;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
  }

  .secretField {
    min-width: 0;
    display: grid;
    gap: density(1);
  }

  .secretField input { width: 100%; flex: none; }

  .page {
    padding: density(5) density(4) density(7);
  }

  .header {
    margin-bottom: space(7);
  }

  .hero,
  .mainGrid,
  .dangerPanel,
  .efficiencyGrid,
  .preferencesGrid {
    grid-template-columns: 1fr;
  }

  .reviewToolbar {
    align-items: stretch;
    flex-wrap: wrap;
  }

  .storyFilterBar {
    align-items: stretch;
  }

  .storyFilterFields {
    flex-basis: 100%;
  }

  .storyWorkspaceHeader,
  .tableViewHeading {
    align-items: stretch;
    flex-direction: column;
  }

  .storyTabs {
    align-self: stretch;
  }

  .storyTabs button {
    flex: 1;
    justify-content: center;
  }

  .reviewActions {
    width: 100%;
    margin-left: 0;
  }

  .reviewActions button {
    flex: 1;
  }

  .optimizationMetrics {
    grid-template-columns: repeat(2, 1fr);
  }

  .aiMetrics {
    grid-template-columns: repeat(2, 1fr);
  }

  .hero {
    gap: space(6);
  }

  .heroMetric {
    padding: density(4) 0 0;
    border-top: 1px solid palette(dark-main, 0.14);
    border-left: 0;
  }

  .heroMetric strong {
    @ds-typo (h2);
    font-size: 34px;
  }

  .mainGrid,
  .dangerPanel {
    gap: space(4);
  }

  .dangerPanel {
    margin-top: space(4);
  }

  .optimizationPanel {
    margin-top: space(4);
  }

  .preferencesPanel {
    margin-top: space(4);
  }

  .editorialPanel {
    margin-top: space(4);
  }

  .contentViewerBackdrop {
    padding: density(4);
  }

  .contentViewer {
    max-height: calc(100svh - 24px);
    border-radius: 16px;
  }

  .contentViewerHeader,
  .contentViewerBody {
    padding: density(5);
  }

  .contentViewerMeta,
  .contentViewerFooter {
    padding-right: density(5);
    padding-left: density(5);
  }
}

@media (max-width: 520px) {
  .panel {
    padding: density(6);
    border-radius: 17px;
  }

  .buttonRow {
    align-items: stretch;
    flex-direction: column;
  }

  .buttonRow button {
    width: 100%;
  }

  .optimizationMetrics {
    grid-template-columns: 1fr;
  }

  .preferencesIntro,
  .preferencesFooter,
  .editorialIntro {
    align-items: stretch;
    flex-direction: column;
  }

  .preferencesIntro > span {
    align-self: flex-start;
  }

  .savePreferencesButton {
    width: 100%;
  }

  .evaluateButton {
    width: 100%;
  }

  .storyTabs {
    flex-direction: column;
  }

  .storyFilterFields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .storyFilterField,
  .storyFilterField select,
  .storyFilterField input {
    width: 100%;
    min-width: 0;
  }

  .topicFloorControl,
  .clearStoryFiltersButton {
    min-height: 38px;
  }

  .contentViewerHeader h2 {
    @ds-typo (h2);
    font-size: 17px;
  }

  .contentViewerFooter {
    align-items: flex-start;
    flex-direction: column;
  }

  .aiMetrics {
    grid-template-columns: 1fr;
  }
}
