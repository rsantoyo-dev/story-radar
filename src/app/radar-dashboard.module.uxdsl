.appShell {
  display: flex;
  min-height: 100svh;
  background: palette(light-light);
}

.sidebar {
  /* Was a max-width:960px override; snapped to this project's lg breakpoint. */
  position: xs(fixed) lg(sticky);
  top: 0;
  left: xs(0) lg(auto);
  z-index: 20;
  display: flex;
  flex: 0 0 248px;
  width: 248px;
  height: 100svh;
  flex-direction: column;
  padding: density(6) density(5);
  overflow-y: auto;
  background: palette(dark-main);
  color: palette(light-light);
  box-shadow: shadow(3);
  transform: xs(translateX(-105%)) lg(none);
  transition: xs(transform 180ms ease) lg(none);
}

/* Toggled by the mobile menu button; translateX(0) is the identity transform
 * at every width, so this is safe to leave unconditional above lg too. */
.sidebarOpen {
  transform: translateX(0);
}

.sidebarHeader {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: density(4);
  padding: 0 density(3);
}

.sidebar .brand {
  gap: density(4);
}

.sidebar .brand h1 {
  color: palette(light-light);
  @ds-typo (h1);
  font-size: space(5);
}

.sidebar .eyebrow {
  color: palette(primary-main);
  @ds-typo (caption);
  font-size: 0.625rem;
}

.sidebar .logo {
  width: 36px;
  height: 36px;
  background: palette(dark-main);
  box-shadow: none;
}

.sidebar .logo::before {
  width: 21px;
  height: 21px;
}

.sidebar .logo::after {
  width: 12px;
  height: 12px;
}

.closeSidebarButton,
.menuButton {
  display: xs(block) lg(none);
  border: 0;
  background: transparent;
  color: inherit;
  cursor: pointer;
}

.closeSidebarButton {
  padding: 0 density(2);
  color: palette(primary-light);
  @ds-typo (body);
  font-size: space(6);
  line-height: 1;
}

.menuButton {
  /* The shared rule above sets display:block; this one wins for .menuButton
   * specifically, same as the original max-width:960px override did. */
  display: xs(grid) lg(none);
  width: 34px;
  height: 34px;
  align-content: center;
  gap: density(2);
  padding: density(3);
  border: 1px solid palette(surface-light);
  border-radius: 9px;
  background: palette(light-light);
}

.menuButton span {
  display: block;
  width: 100%;
  height: 1.5px;
  border-radius: 999px;
  background: palette(primary-dark);
}

.sidebarNav {
  display: grid;
  gap: density(1);
  margin-top: density(10);
}

.navLabel {
  margin: density(5) density(3) density(3);
  color: palette(primary-main);
  @ds-typo (caption);
  font-size: 0.625rem;
  font-weight: 750;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.navLabel:first-child { margin-top: 0; }

.sidebarNav a {
  display: flex;
  align-items: center;
  gap: density(4);
  min-height: 2.75rem;
  padding: 0 density(4);
  border: 1px solid transparent;
  border-radius: radius(2);
  color: palette(primary-light);
  @ds-typo (small);
  font-size: 0.8125rem;
  font-weight: 620;
  text-decoration: none;
  transition: background 150ms ease, border-color 150ms ease, color 150ms ease;
}

.sidebarNav a:hover,
.sidebarNav a:focus-visible {
  border-color: palette(primary-light, 0.14);
  outline: 0;
  background: palette(primary-light, 0.11);
  color: palette(light-light);
}

.navIcon {
  display: grid;
  width: 19px;
  height: 19px;
  place-items: center;
  color: palette(primary-light);
  @ds-typo (body);
  font-size: space(5);
  line-height: 1;
}

.sidebarNav a.navSubItem {
  min-height: 2.25rem;
  margin-left: density(6);
  padding-left: density(3);
  border-left: 2px solid palette(primary-light, 0.16);
  border-radius: 0 radius(2) radius(2) 0;
  color: palette(primary-light, 0.82);
  font-size: 0.75rem;
  font-weight: 600;
}

.sidebarNav a.navSubItem .navIcon {
  width: 14px;
  height: 14px;
  font-size: space(3);
}

.sidebarNav a.navSubItem:hover,
.sidebarNav a.navSubItem:focus-visible {
  border-left-color: palette(secondary-main);
}

.sidebarNav a.navActive,
.sidebarNav a.navSubItem.navActive {
  border-color: palette(secondary-main, 0.42);
  background: palette(primary-light, 0.14);
  color: palette(light-light);
}

.sidebarNav a.navSubItem.navActive {
  border-left-color: palette(secondary-main);
}

.navBadge {
  margin-left: auto;
  display: inline-grid;
  min-width: 18px;
  height: 18px;
  padding: 0 density(1);
  place-items: center;
  border-radius: radius(full);
  background: palette(secondary-main);
  color: palette(secondary-contrast);
  @ds-typo (caption);
  font-size: 10px;
  font-weight: 750;
}

.navGroup {
  display: grid;
  gap: density(1);
}

.navGroupSummary {
  display: flex;
  align-items: center;
  /* The link only takes its own content width (not flex:1), so the rest of
   * this row is plain <summary> background: clicking it still toggles the
   * native <details>, giving the collapse action a wide, reliable target
   * instead of the single glyph the ::after chevron alone would offer. */
  justify-content: space-between;
  border-radius: radius(2);
  cursor: pointer;
  list-style: none;
  transition: background 150ms ease;
}

.navGroupSummary::-webkit-details-marker {
  display: none;
}

.navGroupSummary:hover,
.navGroupSummary:focus-visible {
  background: palette(primary-light, 0.06);
}

.navGroupSummary a,
.navGroupTitle {
  min-width: 0;
}

.navGroupTitle {
  display: flex;
  align-items: center;
  gap: density(4);
  min-height: 2.75rem;
  padding: 0 density(4);
  color: palette(primary-light);
  @ds-typo(small);
  font-size: 0.8125rem;
  font-weight: 620;
}

.navGroupSummary::after {
  padding: density(2) density(4);
  color: palette(primary-light, 0.55);
  @ds-typo (caption);
  font-size: space(4);
  content: "⌄";
}

.navGroup[open] > .navGroupSummary::after {
  content: "⌃";
}

/* Production nav items that show their pipeline stages as a caption
 * (Stories, Ready to produce) — same row as a normal item, but the label
 * and caption stack so the icon stays aligned with every other entry. */
.navItemWithCaption {
  align-items: flex-start;
  min-height: auto;
  padding-block: density(3);
}

.navItemWithCaption .navIcon {
  margin-top: 2px;
}

.navItemBody {
  display: grid;
  min-width: 0;
  gap: 2px;
}

.navItemLabel {
  display: flex;
  align-items: center;
  gap: density(2);
}

.navItemCaption {
  overflow: hidden;
  color: palette(primary-light, 0.55);
  @ds-typo (caption);
  font-size: 0.625rem;
  font-weight: 560;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebarNav a.navItemWithCaption:hover .navItemCaption,
.sidebarNav a.navItemWithCaption.navActive .navItemCaption {
  color: palette(light-light, 0.72);
}

.sidebarFooter {
  margin-top: auto;
  padding: density(5) density(3) 0;
  border-top: 1px solid palette(primary-light, 0.14);
}

.sidebarFooter .environment {
  border-color: palette(primary-light, 0.16);
  background: palette(light-light, 0.06);
  color: palette(primary-light);
}

.sidebarFooter p {
  margin: density(4) density(1) 0;
  color: palette(primary-main);
  @ds-typo (caption);
  font-size: 0.6875rem;
  line-height: 1.5;
}

.sidebarBackdrop {
  display: xs(block) lg(none);
  position: fixed;
  inset: 0;
  z-index: 15;
  width: 100%;
  border: 0;
  background: palette(dark-main, 0.42);
  cursor: pointer;
}

.appMain {
  min-width: 0;
  flex: 1;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: grid;
  gap: density(1);
  padding: xs(density(2) density(4)) md(density(2) density(5));
  border-bottom: 1px solid palette(dark-main, 0.08);
  background: palette(light-light, 0.9);
  backdrop-filter: blur(18px);
}

.topbarPrimary {
  display: grid;
  align-items: center;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: xs(density(2)) sm(density(3));
}

.topbarLeft,
.currentTopic,
.topicSelectWrap {
  display: flex;
  align-items: center;
}

.topbarLeft {
  min-width: 0;
  gap: density(3);
}

.topbarActions {
  display: grid;
  grid-template-columns: xs(repeat(2, minmax(0, 1fr))) sm(auto auto);
  gap: density(2);
  width: xs(100%) sm(max-content);
  justify-self: end;
}

.topbarUtility {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
  padding-top: density(2);
  border-top: 1px solid palette(dark-main, 0.06);
}

.secretControl {
  display: grid;
  min-width: 0;
  align-items: center;
  gap: density(2);
  width: xs(100%) sm(auto);
  grid-column: xs(1 / -1) sm(auto);
  grid-template-columns: minmax(0, 1fr) auto auto;
  justify-self: end;
}

.topbarSession {
  display: inline-flex;
  align-items: center;
  gap: density(2);
  justify-self: end;
}

.disconnectButton {
  @ds-button(outlined primary 2);
  display: inline-grid;
  width: 30px;
  height: 30px;
  padding: 0;
  border-color: palette(dark-main, 0.12);
  background: transparent;
  color: palette(primary-dark);
  cursor: pointer;
  place-items: center;
  transition: background 150ms ease, border-color 150ms ease, color 150ms ease;
}

.disconnectButton:hover:not(:disabled) {
  border-color: palette(error-main, 0.45);
  background: palette(error-main, 0.08);
  color: palette(error-dark);
}

.disconnectButton:disabled {
  cursor: not-allowed;
  opacity: 0.45;
}

.secretConnectButton {
  @ds-button(outlined primary 2);
  min-height: 30px;
  padding: 0 density(3);
  border-color: palette(primary-main, 0.45);
  background: transparent;
  color: palette(primary-dark);
  @ds-typo(caption);
  font-size: 0.6875rem;
  font-weight: 700;
  white-space: nowrap;
  cursor: pointer;
  transition: background 150ms ease, border-color 150ms ease, opacity 150ms ease;
}

.secretConnectButton:hover:not(:disabled) {
  border-color: palette(primary-main);
  background: palette(primary-main, 0.08);
}

.secretConnectButton:disabled {
  cursor: not-allowed;
  opacity: 0.45;
}

.secretField {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: density(3);
}

.secretField > span {
  display: xs(none) sm(inline);
  color: palette(tertiary-main);
  @ds-typo(caption);
  font-size: 0.625rem;
  font-weight: 750;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  white-space: nowrap;
}

.secretField input {
  @ds-input(outlined primary 2);
  box-sizing: border-box;
  min-width: 0;
  flex: 1;
  width: xs(100%) sm(200px);
  min-height: 30px;
  padding: 0 density(3);
  border-color: palette(dark-main, 0.12);
  background: palette(light-light);
  color: palette(dark-main);
  @ds-typo(caption);
  font-size: 0.75rem;
}

.secretField input:focus-visible {
  border-color: palette(primary-main);
  box-shadow: 0 0 0 4px palette(primary-main, 0.12);
}

.topbarStatus {
  flex: none;
  white-space: nowrap;
}

.currentTopic {
  align-items: center;
  flex-direction: row;
  gap: density(3);
  min-width: 0;
  flex: 1;
}

.topbarLabel {
  display: xs(none) md(inline);
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 0.625rem;
  font-weight: 750;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  white-space: nowrap;
}

.topicSelectWrap {
  position: relative;
  min-width: 0;
  width: xs(100%) md(220px);
  max-width: xs(none) md(220px);
}

.topicSelectWrap::before {
  position: absolute;
  z-index: 1;
  top: 50%;
  left: density(3);
  width: 8px;
  height: 8px;
  border-radius: radius(5);
  background: palette(primary-main);
  box-shadow: 0 0 0 3px palette(primary-main, 0.14);
  content: "";
  pointer-events: none;
  transform: translateY(-50%);
}

.topicSelectWrap select {
  @ds-input(outlined primary 2);
  appearance: none;
  width: 100%;
  min-height: 32px;
  padding: 0 density(9) 0 density(7);
  border-color: palette(dark-main, 0.12);
  background: palette(light-light);
  color: palette(dark-main);
  @ds-typo (small);
  font-size: 0.75rem;
  font-weight: 650;
  cursor: pointer;
}

.topicSelectWrap select:focus-visible {
  border-color: palette(primary-main);
  box-shadow: 0 0 0 4px palette(primary-main, 0.12);
}

.topicSelectWrap select:disabled {
  cursor: not-allowed;
  opacity: 0.58;
}

.topicSelectWrap > span {
  position: absolute;
  top: 50%;
  right: density(4);
  color: palette(primary-main);
  @ds-typo (h4);
  font-size: 16px;
  pointer-events: none;
  transform: translateY(-55%);
}

.topicLoadingIndicator {
  animation: topic-spin 700ms linear infinite;
}

@keyframes topic-spin {
  from { transform: translateY(-55%) rotate(0deg); }
  to { transform: translateY(-55%) rotate(360deg); }
}

.page {
  min-height: calc(100svh - 76px);
  /* Was a max-width:800px override (a physical `padding` shorthand); ported
   * in the same logical properties the base already uses. */
  padding-block: xs(density(5) density(7)) md(density(9) density(11));
  padding-inline: xs(density(4)) md(density(5));
  color: palette(dark-main);
  background:
    radial-gradient(circle at 8% 0%, palette(primary-light, 0.62), transparent 30rem),
    radial-gradient(circle at 94% 14%, palette(info-light, 0.68), transparent 34rem),
    palette(light-light);
}

.shell {
  width: min(1240px, 100%);
  margin: 0 auto;
  transition: opacity 160ms ease, filter 160ms ease;
}

.topicSwitching {
  filter: saturate(0.82);
  opacity: 0.58;
  pointer-events: none;
}

.anchorTarget {
  scroll-margin-top: density(10);
}

.anchorTarget + .anchorTarget {
  margin-top: density(3);
}

.brand,
.panelHeading,
.buttonRow,
.notice {
  display: flex;
  align-items: center;
}

.brand {
  gap: density(4);
}

.brand h1 {
  margin: density(1) 0 0;
  @ds-typo (h1);
  font-size: space(5);
  line-height: 1;
  letter-spacing: -0.04em;
}

.eyebrow,
.kicker,
.sectionNumber {
  margin: 0;
  color: palette(primary-main);
  @ds-typo (caption);
  font-size: 0.6875rem;
  font-weight: 750;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.logo {
  position: relative;
  display: grid;
  width: 42px;
  height: 42px;
  place-items: center;
  border-radius: 50%;
  background: palette(dark-main);
  box-shadow: shadow(3);
}

.logo::before,
.logo::after,
.logo span {
  position: absolute;
  border: 1.5px solid palette(primary-light);
  border-radius: 50%;
  content: "";
}

.logo::before {
  width: 24px;
  height: 24px;
  border-left-color: transparent;
}

.logo::after {
  width: 14px;
  height: 14px;
  border-bottom-color: transparent;
}

.logo span {
  width: 4px;
  height: 4px;
  border: 0;
  background: palette(primary-main);
}

.environment,
.online,
.idle {
  display: inline-flex;
  align-items: center;
  gap: density(3);
  padding: density(3) density(4);
  border: 1px solid palette(dark-main, 0.1);
  border-radius: radius(pill);
  background: palette(light-light, 0.58);
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 0.75rem;
  font-weight: 650;
  backdrop-filter: blur(10px);
}

.environment::before,
.online::before,
.idle::before {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: palette(primary-main);
  content: "";
  box-shadow: 0 0 0 3px palette(primary-main, 0.15);
}

.idle::before {
  background: palette(surface-dark);
  box-shadow: none;
}

.topbarStatus.online,
.topbarStatus.idle {
  box-sizing: border-box;
  display: block;
  width: 10px;
  height: 10px;
  min-height: 0;
  margin-inline: density(1);
  padding: 0;
  border: 0;
  border-radius: 50%;
  backdrop-filter: none;
}

.topbarStatus.online::before,
.topbarStatus.idle::before {
  content: none;
}

.topbarStatus.online {
  background: palette(success-main);
  box-shadow: 0 0 0 3px palette(success-main, 0.2);
}

.topbarStatus.idle {
  background: palette(error-main);
  box-shadow: 0 0 0 3px palette(error-main, 0.18);
}

.hero {
  display: grid;
  grid-template-columns: xs(1fr) md(1fr auto);
  gap: xs(density(6)) md(density(10));
  align-items: end;
  margin-bottom: density(7);
}

.hero h2 {
  max-width: 43rem;
  margin: density(3) 0 density(4);
  color: palette(dark-main);
  @ds-typo (h2);
  font-size: clamp(38px, 6vw, 70px);
  font-weight: 620;
  line-height: 0.98;
  letter-spacing: -0.062em;
}

.hero > div > p:last-child {
  max-width: 39rem;
  margin: 0;
  color: palette(primary-main);
  @ds-typo (body);
  font-size: space(5);
  line-height: 1.65;
}

.heroMetric {
  min-width: 9.375rem;
  padding: xs(density(4) 0 0) md(0 0 density(3) density(6));
  border-left: xs(0) md(1px solid palette(dark-main, 0.14));
  border-top: xs(1px solid palette(dark-main, 0.14)) md(0);
}

.heroMetric span,
.heroMetric small {
  display: block;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 0.75rem;
}

.heroMetric strong {
  display: block;
  margin: density(2) 0;
  @ds-typo (body);
  font-size: xs(34px) md(space(8));
  font-weight: 600;
  letter-spacing: -0.06em;
}

.mainGrid {
  display: grid;
  grid-template-columns: xs(1fr) md(minmax(0, 1.08fr) minmax(360px, 0.92fr));
  gap: xs(density(4)) md(density(3));
}

.panel {
  @ds-surface(contained surface 3);
  padding: density(6);
  border: 1px solid palette(dark-main, 0.1);
  /* Was a max-width:520px override of the mixin's own radius(3). */
  border-radius: xs(17px) sm(radius(3));
  background: palette(light-light, 0.8);
  box-shadow: shadow(4);
  backdrop-filter: blur(18px);
}

.panelHeading {
  justify-content: space-between;
  margin-bottom: density(6);
}

.panel h2 {
  margin: density(2) 0 0;
  @ds-typo (h2);
  font-size: space(5);
  font-weight: 650;
  letter-spacing: -0.03em;
}

.field {
  display: block;
  margin-top: density(5);
}

.field > span {
  display: block;
  margin-bottom: density(3);
  color: palette(primary-dark);
  @ds-typo (small);
  font-size: 0.8125rem;
  font-weight: 650;
}

.field input {
  @ds-input(outlined primary 2);
  height: 48px;
  padding: 0 density(4);
  border-color: palette(surface-dark);
  background: palette(light-light, 0.84);
  color: palette(dark-main);
  transition: border-color 160ms ease, box-shadow 160ms ease;
}

.field input:focus {
  border-color: palette(primary-main);
  box-shadow: 0 0 0 4px palette(primary-main, 0.12);
}

.field small {
  display: block;
  margin-top: density(3);
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 0.6875rem;
}

.inputSuffix {
  position: relative;
}

.inputSuffix input {
  padding-right: density(10);
}

.inputSuffix > span {
  position: absolute;
  top: 50%;
  right: density(4);
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 0.75rem;
  transform: translateY(-50%);
}

.buttonRow {
  align-items: xs(stretch) sm(center);
  flex-direction: xs(column) sm(row);
  gap: density(2);
  margin-top: density(6);
}

.buttonRow button {
  @ds-button(contained primary 2);
  width: xs(100%) sm(auto);
  min-height: 45px;
  padding: 0 density(5);
  @ds-typo (small);
  font-size: 0.8125rem;
  font-weight: 700;
  cursor: pointer;
  transition: transform 150ms ease, opacity 150ms ease, box-shadow 150ms ease;
}

.buttonRow button:hover:not(:disabled) {
  transform: translateY(-1px);
}

.buttonRow button:disabled {
  cursor: not-allowed;
  opacity: 0.42;
}

.primaryButton {
  @ds-button(contained dark 2);
  flex: 1;
  box-shadow: shadow(3);
}

.secondaryButton {
  @ds-button(outlined primary 2);
}

.statsGrid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: density(2);
}

.metric {
  @ds-surface(contained light 2);
  padding: density(5);
  border: 1px solid palette(dark-main, 0.08);
  background: palette(light-light);
}

.metric span,
.lastRun span {
  display: block;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 0.6875rem;
}

.metric strong {
  display: block;
  margin-top: density(3);
  @ds-typo (body);
  font-size: space(6);
  font-weight: 620;
  letter-spacing: -0.05em;
}

.statusList {
  margin-top: density(6);
}

.statusList > p {
  margin: 0 0 density(3);
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 0.6875rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.statusList > div:not(.emptyState) {
  display: flex;
  justify-content: space-between;
  padding: density(3) density(1);
  border-bottom: 1px solid palette(light-light);
  color: palette(primary-dark);
  @ds-typo (small);
  font-size: 0.8125rem;
}

.statusList strong {
  color: palette(dark-main);
}

.emptyState {
  padding: density(5) 0;
  color: palette(tertiary-main);
  @ds-typo (small);
  font-size: 0.8125rem;
}

.lastRun {
  @ds-surface(contained dark 2);
  margin-top: density(5);
  padding: density(4) density(5);
  color: palette(light-light);
}

.lastRun span,
.lastRun small {
  color: palette(surface-dark);
}

.lastRun strong,
.lastRun small {
  display: block;
  margin-top: density(2);
}

.lastRun strong {
  @ds-typo (small);
  font-size: 0.875rem;
}

.lastRun small {
  @ds-typo (caption);
  font-size: 0.6875rem;
}

.notice {
  @ds-surface(outlined surface 2);
  gap: density(4);
  margin-top: density(3);
  padding: density(5) density(6);
}

.notice > span {
  display: grid;
  flex: 0 0 density(6);
  width: density(6);
  height: density(6);
  place-items: center;
  border-radius: 50%;
  font-weight: 800;
}

.notice strong,
.notice p {
  display: block;
  margin: 0;
  @ds-typo (small);
  font-size: 0.8125rem;
}

.notice p {
  margin-top: density(1);
  opacity: 0.78;
}

.noticeSuccess {
  border-color: palette(primary-light);
  background: palette(light-light);
  color: palette(dark-main);
}

.noticeSuccess > span {
  background: palette(primary-light);
}

.noticeError {
  border-color: palette(error-light);
  background: palette(light-light);
  color: palette(error-dark);
}

.noticeError > span {
  background: palette(error-light);
}

.preferencesPanel {
  margin-top: xs(density(4)) md(density(3));
}

.savedBadge,
.unsavedBadge {
  padding: density(1) density(2);
  border: 1px solid;
  border-radius: 999px;
  @ds-typo (caption);
  font-size: 11px;
  font-weight: 700;
}

.savedBadge {
  border-color: palette(primary-light);
  background: palette(light-light);
  color: palette(primary-dark);
}

.unsavedBadge {
  border-color: palette(warning-light);
  background: palette(light-light);
  color: palette(warning-dark);
}

.preferencesIntro,
.preferencesFooter {
  display: flex;
  align-items: xs(stretch) sm(center);
  flex-direction: xs(column) sm(row);
  justify-content: space-between;
  gap: density(5);
}

.preferencesIntro {
  margin: calc(density(3) * -1) 0 density(5);
}

.preferencesIntro p {
  max-width: 670px;
  margin: 0;
  color: palette(tertiary-main);
  @ds-typo (small);
  font-size: 13px;
  line-height: 1.55;
}

.preferencesIntro > span {
  flex: 0 0 auto;
  align-self: xs(flex-start) sm(auto);
  padding: density(1) density(2);
  border-radius: 8px;
  background: palette(light-light);
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 11px;
  font-weight: 750;
}

.preferencesGrid {
  display: grid;
  grid-template-columns: xs(1fr) md(repeat(2, minmax(0, 1fr)));
  gap: density(4);
}

.termField {
  @ds-surface(flat surface 4);
  display: block;
  padding: density(4);
  border: 1px solid palette(surface-light);
  border-radius: 15px;
  background: palette(light-light);
}

.termField > span {
  display: flex;
  align-items: center;
  gap: density(1);
  margin-bottom: density(3);
  color: palette(primary-dark);
  @ds-typo (small);
  font-size: 13px;
  font-weight: 700;
}

.termField > span::before {
  display: inline-grid;
  width: 20px;
  height: 20px;
  place-items: center;
  border-radius: 6px;
  @ds-typo (small);
  font-size: 13px;
  content: "+";
}

.favoredLabel::before {
  background: palette(primary-light);
  color: palette(primary-dark);
}

.termField > .unfavoredLabel::before {
  background: palette(error-light);
  color: palette(error-main);
  content: "−";
}

.termField textarea {
  @ds-input(outlined primary 3);
  width: 100%;
  min-height: 154px;
  padding: density(3);
  resize: vertical;
  border: 1px solid palette(surface-light);
  border-radius: 11px;
  outline: 0;
  background: palette(light-light);
  color: palette(dark-main);
  font: inherit;
  @ds-typo (small);
  font-size: 13px;
  line-height: 1.55;
  transition: border-color 160ms ease, box-shadow 160ms ease;
}

.termField textarea:focus {
  border-color: palette(primary-main);
  box-shadow: 0 0 0 4px palette(primary-main, 0.12);
}

.termField small {
  display: block;
  margin-top: density(3);
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 11px;
}

.preferencesFooter {
  margin-top: density(5);
}

.preferencesFooter > small {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 11px;
}

.savePreferencesButton {
  @ds-button(contained primary 3);
  width: xs(100%) sm(auto);
  min-height: 43px;
  padding: 0 density(4);
  border: 1px solid palette(primary-dark);
  border-radius: 11px;
  background: palette(primary-dark);
  color: palette(light-light);
  font: inherit;
  @ds-typo (small);
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 9px 22px palette(primary-dark, 0.14);
  transition: transform 150ms ease, opacity 150ms ease;
}

.savePreferencesButton:hover:not(:disabled) {
  transform: translateY(-1px);
}

.savePreferencesButton:disabled {
  cursor: not-allowed;
  opacity: 0.42;
}

.optimizationPanel {
  margin-top: xs(density(4)) md(density(5));
  overflow: hidden;
}

.runBadge {
  padding: density(1) density(2);
  border: 1px solid palette(surface-light);
  border-radius: 999px;
  background: palette(light-light);
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 11px;
  font-weight: 700;
}

.optimizationMetrics {
  display: grid;
  grid-template-columns: xs(1fr) sm(repeat(2, 1fr)) md(repeat(4, 1fr));
  gap: density(3);
}

.optimizationMetric {
  min-width: 0;
  padding: density(4);
  border: 1px solid palette(dark-main, 0.08);
  border-radius: 14px;
  background: linear-gradient(145deg, palette(light-light), palette(light-light));
}

.optimizationMetric span,
.optimizationMetric small {
  display: block;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 11px;
}

.optimizationMetric strong {
  display: block;
  margin: density(2) 0 density(2);
  color: palette(dark-main);
  @ds-typo (h2);
  font-size: 28px;
  font-weight: 620;
  letter-spacing: -0.055em;
}

.optimizationMetric small {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.efficiencyGrid {
  display: grid;
  grid-template-columns: xs(1fr) md(repeat(2, 1fr));
  gap: density(3);
  margin-top: density(4);
}

.efficiencyItem {
  padding: density(4);
  border-radius: 15px;
  background: palette(dark-main);
  color: palette(light-light);
}

.efficiencyItem > div:first-child {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: density(5);
}

.efficiencyItem span {
  color: palette(primary-light);
  @ds-typo (caption);
  font-size: 12px;
  font-weight: 650;
}

.efficiencyItem strong {
  color: palette(primary-main);
  @ds-typo (h3);
  font-size: 22px;
  font-weight: 650;
  letter-spacing: -0.04em;
}

.efficiencyItem small {
  display: block;
  margin-top: density(3);
  color: palette(primary-main);
  @ds-typo (caption);
  font-size: 11px;
}

.progressTrack {
  height: 6px;
  margin-top: density(4);
  overflow: hidden;
  border-radius: 99px;
  background: palette(light-light, 0.12);
}

.progressTrack span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, palette(primary-main), palette(primary-main));
  transition: width 500ms ease;
}

.relevanceStrip {
  display: flex;
  flex-wrap: wrap;
  gap: density(1);
  margin-top: density(4);
}

.relevanceStrip span {
  padding: density(1) density(2);
  border: 1px solid palette(surface-light);
  border-radius: 9px;
  background: palette(light-light);
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 11px;
}

.relevanceStrip strong {
  color: palette(dark-main);
  @ds-typo (caption);
  font-size: 12px;
}

.optimizationEmpty {
  padding: density(6) density(4);
  border: 1px dashed palette(surface-light);
  border-radius: 14px;
  color: palette(tertiary-main);
  text-align: center;
  @ds-typo (small);
  font-size: 13px;
}

.editorialPanel {
  margin-top: xs(density(4)) md(density(5));
}

.aiBadge {
  padding: density(1) density(2);
  border: 1px solid palette(info-light);
  border-radius: 999px;
  background: palette(light-light);
  color: palette(info-main);
  @ds-typo (caption);
  font-size: 11px;
  font-weight: 700;
}

.editorialIntro {
  display: flex;
  align-items: xs(stretch) sm(center);
  flex-direction: xs(column) sm(row);
  justify-content: space-between;
  gap: density(6);
  margin: calc(density(3) * -1) 0 density(5);
}

.editorialIntro p,
.editorialIntro small {
  display: block;
  margin: 0;
  color: palette(tertiary-main);
  @ds-typo (small);
  font-size: 13px;
  line-height: 1.55;
}

.editorialIntro small {
  margin-top: density(2);
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 11px;
}

.evaluateButton {
  @ds-button(contained primary 3);
  flex: 0 0 auto;
  width: xs(100%) sm(auto);
  min-height: 44px;
  padding: 0 density(4);
  border: 1px solid palette(info-dark);
  border-radius: 11px;
  background: palette(info-dark);
  color: palette(light-light);
  font: inherit;
  @ds-typo (small);
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 9px 22px palette(info-dark, 0.18);
  transition: transform 150ms ease, opacity 150ms ease;
}

.evaluateButton:hover:not(:disabled) {
  transform: translateY(-1px);
}

.evaluateButton:disabled {
  cursor: not-allowed;
  opacity: 0.42;
}

.evaluationActions {
  display: flex;
  flex: 0 0 auto;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: density(2);
  width: xs(100%) sm(auto);
}

.reevaluateButton {
  @ds-button(outlined neutral 3);
  width: xs(100%) sm(auto);
  min-height: 44px;
  padding: 0 density(4);
  border: border(1, palette(info-dark), solid);
  border-radius: radius(3);
  background: palette(light-light);
  color: palette(info-dark);
  @ds-typo (small);
  font-weight: 700;
  cursor: pointer;
}

.reevaluateButton:disabled {
  cursor: not-allowed;
  opacity: 0.42;
}

.aiMetrics {
  display: grid;
  grid-template-columns: xs(1fr) sm(repeat(2, 1fr)) md(repeat(4, 1fr));
  gap: density(3);
}

.aiRunSummary {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: density(2) density(5);
  margin-top: density(3);
  padding: density(3);
  border: 1px solid palette(surface-light);
  border-radius: 11px;
  background: palette(light-light);
  color: palette(info-main);
  @ds-typo (caption);
  font-size: 11px;
}

.aiRunSummary strong {
  color: palette(info-dark);
  text-transform: capitalize;
}

.reviewToolbar {
  display: flex;
  align-items: xs(stretch) md(center);
  flex-wrap: xs(wrap) md(nowrap);
  gap: density(3);
  margin-bottom: density(3);
  padding: density(3);
  border: 1px solid palette(surface-light);
  border-radius: 13px;
  background: palette(light-light);
}

.selectAllControl,
.reviewActions {
  display: flex;
  align-items: center;
}

.selectAllControl {
  gap: density(1);
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}

.selectAllControl input,
.storyCheckbox {
  width: 17px;
  height: 17px;
  accent-color: palette(primary-dark);
  cursor: pointer;
}

.selectionCount {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 11px;
}

.reviewActions {
  gap: density(1);
  margin-left: xs(0) md(auto);
  width: xs(100%) md(auto);
}

.reviewActions button {
  @ds-button(contained primary 2);
  flex: xs(1) md(0 1 auto);
  min-height: 37px;
  padding: 0 density(3);
  border-radius: 9px;
  font: inherit;
  @ds-typo (caption);
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: transform 150ms ease, opacity 150ms ease;
}

.reviewActions button:hover:not(:disabled) {
  transform: translateY(-1px);
}

.reviewActions button:disabled {
  cursor: not-allowed;
  opacity: 0.42;
}

.rejectStoriesButton {
  border: 1px solid palette(error-light);
  background: palette(light-light);
  color: palette(error-main);
}

.approveStoriesButton {
  border: 1px solid palette(primary-dark);
  background: palette(primary-dark);
  color: palette(light-light);
  box-shadow: 0 7px 18px palette(primary-dark, 0.14);
}

.selectedTableActions {
  display: flex;
  align-items: center;
  justify-content: xs(space-between) md(flex-end);
  gap: density(2);
  width: xs(100%) md(auto);
}

.clearSelectedStoriesButton,
.unselectStoryButton {
  @ds-button(outlined neutral 2);
  min-height: density(7);
  padding: 0 density(3);
  border-color: palette(secondary-main);
  color: palette(secondary-dark);
  @ds-typo(caption);
  font-weight: 750;
  cursor: pointer;
}

.clearSelectedStoriesButton:disabled,
.unselectStoryButton:disabled {
  cursor: not-allowed;
  opacity: 0.5;
}

.storyWorkspaceHeader,
.tableViewHeading {
  display: flex;
  align-items: xs(stretch) md(end);
  flex-direction: xs(column) md(row);
  justify-content: space-between;
  gap: density(5);
}

.storyWorkspaceHeader {
  margin-top: density(7);
  padding-top: density(6);
  border-top: 1px solid palette(surface-light);
}

.storyWorkspaceHeader h3,
.storyWorkspaceHeader p,
.tableViewHeading h3,
.tableViewHeading p {
  margin: 0;
}

.storyWorkspaceHeader h3,
.tableViewHeading h3 {
  color: palette(dark-main);
  @ds-typo (h3);
  font-size: 16px;
  letter-spacing: -0.025em;
}

.storyWorkspaceHeader p,
.tableViewHeading p {
  margin-top: density(2);
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 11px;
  line-height: 1.45;
}

.storyTabs {
  display: inline-flex;
  flex: 0 0 auto;
  /* Was two overrides (max-width:800px align-self, max-width:520px
   * flex-direction), snapped to md/sm. */
  align-self: xs(stretch) md(auto);
  flex-direction: xs(column) sm(row);
  gap: density(1);
  padding: density(1);
  border: 1px solid palette(surface-light);
  border-radius: 12px;
  background: palette(light-light);
}

.storyTabs button {
  display: inline-flex;
  align-items: center;
  flex: xs(1) md(0 1 auto);
  justify-content: xs(center) md(flex-start);
  gap: density(1);
  min-height: 36px;
  padding: 0 density(3);
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: palette(tertiary-main);
  font: inherit;
  @ds-typo (caption);
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}

.storyTabs button span {
  display: inline-grid;
  min-width: 21px;
  height: 21px;
  padding: 0 density(1);
  place-items: center;
  border-radius: 999px;
  background: palette(dark-main, 0.08);
  @ds-typo (caption);
  font-size: 10px;
}

.storyTabs .activeStoryTab {
  background: palette(light-light);
  color: palette(dark-main);
  box-shadow: 0 3px 10px palette(dark-main, 0.09);
}

.quickViews {
  display: flex;
  flex-wrap: wrap;
  gap: density(1);
  margin-top: density(4);
}

.quickViews button {
  display: inline-flex;
  align-items: center;
  gap: density(1);
  min-height: 32px;
  padding: 0 density(3);
  border: 1px solid palette(surface-light);
  border-radius: radius(full);
  background: palette(light-light);
  color: palette(tertiary-main);
  font: inherit;
  @ds-typo (caption);
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: border-color 150ms ease, background 150ms ease, color 150ms ease;
}

.quickViews button:hover,
.quickViews button:focus-visible {
  border-color: palette(secondary-main, 0.5);
  outline: 0;
}

.quickViews button span {
  display: inline-grid;
  min-width: 19px;
  height: 19px;
  padding: 0 density(1);
  place-items: center;
  border-radius: radius(full);
  background: palette(dark-main, 0.08);
  @ds-typo (caption);
  font-size: 10px;
}

.quickViews .quickViewActive {
  border-color: palette(secondary-main);
  background: palette(secondary-main);
  color: palette(secondary-contrast);
}

.quickViews .quickViewActive span {
  background: palette(secondary-contrast, 0.22);
  color: palette(secondary-contrast);
}

.tableViewHeading {
  margin: density(5) 0 density(3);
}

.tableViewHeading > span {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 11px;
  font-weight: 700;
}

.storyFilterBar {
  display: flex;
  align-items: xs(stretch) md(end);
  flex-wrap: wrap;
  gap: density(2);
  margin-bottom: density(3);
  padding: density(3);
  border: 1px solid palette(surface-light);
  border-radius: 13px;
  background: palette(light-light);
}

.storyFilterFields {
  /* Was two separate overrides (max-width:800px flex-basis, max-width:520px
   * grid layout); merged using this project's sm/md breakpoints. */
  display: xs(grid) sm(flex);
  grid-template-columns: repeat(2, minmax(0, 1fr));
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: xs(100%) md(540px);
  flex-wrap: wrap;
  gap: density(2);
}

.storyFilterField {
  display: grid;
  min-width: xs(0) sm(104px);
  width: xs(100%) sm(auto);
  gap: density(1);
}

.storyFilterField > span {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 10px;
  font-weight: 700;
}

.storyFilterField select,
.storyFilterField input {
  @ds-input(outlined primary 2);
  box-sizing: border-box;
  min-height: 34px;
  border: 1px solid palette(surface-light);
  border-radius: 8px;
  background: palette(light-light);
  color: palette(dark-main);
  font: inherit;
  @ds-typo (caption);
  font-size: 12px;
}

.storyFilterField select {
  min-width: xs(0) sm(134px);
  width: xs(100%) sm(auto);
  padding: 0 density(2);
}

.storyFilterField input {
  min-width: xs(0) sm(auto);
  width: xs(100%) sm(86px);
  padding: 0 density(2);
}

.storyFilterField select:focus,
.storyFilterField input:focus {
  outline: 2px solid palette(primary-dark, 0.23);
  outline-offset: 1px;
  border-color: palette(primary-main);
}

.topicFloorControl {
  display: inline-flex;
  align-items: center;
  gap: density(1);
  min-height: xs(38px) sm(34px);
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 11px;
  font-weight: 700;
  white-space: nowrap;
  cursor: pointer;
}

.topicFloorControl input {
  width: 16px;
  height: 16px;
  margin: 0;
  accent-color: palette(primary-dark);
  cursor: pointer;
}

.clearStoryFiltersButton {
  @ds-button(outlined primary 2);
  min-height: xs(38px) sm(34px);
  padding: 0 density(2);
  border: 1px solid palette(surface-light);
  border-radius: 8px;
  background: palette(light-light);
  color: palette(tertiary-main);
  font: inherit;
  @ds-typo (caption);
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
}

.clearStoryFiltersButton:hover {
  filter: brightness(0.98);
}

.storyFilterCount {
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 11px;
  font-weight: 750;
  white-space: nowrap;
}

.storyFilterHint {
  flex-basis: 100%;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 10px;
}

.storyTableShell {
  max-width: 100%;
  overflow: auto;
  border: 1px solid palette(surface-light);
  border-radius: 14px;
  background: palette(light-light);
  box-shadow: inset 0 1px 0 palette(light-light, 0.7);
}

.storyTable {
  width: 100%;
  min-width: 1815px;
  border-collapse: separate;
  border-spacing: 0;
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 11px;
}

.storyTable th {
  position: sticky;
  top: 0;
  z-index: 1;
  padding: 0;
  border-bottom: 1px solid palette(surface-light);
  background: palette(light-light);
  color: palette(tertiary-main);
  text-align: left;
  white-space: nowrap;
}

.tableHeaderLabel {
  display: flex;
  min-height: 43px;
  align-items: center;
  padding: 0 density(2);
  font-weight: 750;
}

.numericColumn .tableHeaderLabel {
  justify-content: flex-end;
}

.storyTable td {
  max-width: 180px;
  padding: density(3) density(2);
  border-bottom: 1px solid palette(light-light);
  background: palette(light-light);
  vertical-align: top;
}

.storyTable tbody tr:last-child td {
  border-bottom: 0;
}

.storyTable tbody tr:hover td {
  background: palette(light-light);
}

.storyTable .selectedTableRow td {
  background: palette(light-light);
}

.selectionColumn {
  width: 42px;
  min-width: 42px;
  text-align: center;
}

.unavailableSelection {
  color: palette(surface-dark);
}

.dateCell {
  width: 92px;
  color: palette(tertiary-main);
  white-space: nowrap;
}

.storyTitleCell {
  width: 360px;
  min-width: 290px;
  max-width: 390px !important;
}

.storyTitleCell > a {
  display: block;
  color: palette(dark-main);
  @ds-typo (caption);
  font-size: 12px;
  font-weight: 750;
  line-height: 1.4;
  text-decoration: none;
}

.storyTitleCell > a:hover {
  text-decoration: underline;
  text-underline-offset: 3px;
}

.aiResearchStoryBadge {
  margin-top: density(1);
  background: palette(primary-main);
  color: palette(primary-contrast);
}

.storyTitleCell > small {
  display: -webkit-box;
  margin-top: density(2);
  overflow: hidden;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 10px;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.sourceCell {
  min-width: 130px;
  color: palette(primary-dark);
  font-weight: 650;
}

.sourceCellContent {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: density(1);
}

.numericColumn,
.scoreCell {
  width: 72px;
  text-align: right !important;
}

.scoreCell {
  color: palette(primary-dark);
  font-variant-numeric: tabular-nums;
  font-weight: 750;
}

.accentScoreCell {
  color: palette(info-dark);
}

.growthScoreCell {
  width: 106px;
  min-width: 106px;
  white-space: normal;
}

.growthScoreSummary {
  display: grid;
  justify-items: end;
  gap: density(1);
}

.growthScoreSummary > strong {
  color: palette(primary-dark);
  font-variant-numeric: tabular-nums;
}

.growthScoreDetails {
  position: relative;
}

.growthScoreDetails summary {
  display: inline-flex;
  align-items: center;
  gap: density(1);
  color: palette(primary-main);
  @ds-typo (caption);
  font-size: 9px;
  font-weight: 750;
  cursor: pointer;
  list-style: none;
}

.growthScoreDetails summary::-webkit-details-marker {
  display: none;
}

.growthScoreDetails summary::after {
  color: palette(tertiary-main);
  content: "⌄";
}

.growthScoreDetails[open] summary::after {
  content: "⌃";
}

.growthScorePopover {
  @ds-surface(contained light 3);
  border-radius: radius(2);
  box-shadow: shadow(3);
  position: absolute;
  z-index: 4;
  top: calc(100% + density(1));
  right: 0;
  width: 220px;
  padding: density(3);
  border: border(1, palette(surface-light), solid);
  border-radius: radius(2);
  box-shadow: shadow(3);
  color: palette(dark-main);
  text-align: left;
}

.growthScorePopover p {
  margin: 0 0 density(2);
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 10px;
  line-height: 1.45;
}

.growthScorePopover dl {
  display: grid;
  gap: density(1);
  margin: 0;
}

.growthScorePopover dl > div {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: density(2);
}

.growthScorePopover dt,
.growthScorePopover dd {
  margin: 0;
  @ds-typo (caption);
  font-size: 10px;
}

.growthScorePopover dt {
  color: palette(tertiary-main);
}

.growthScorePopover dd {
  color: palette(primary-dark);
  font-variant-numeric: tabular-nums;
  font-weight: 750;
}

.tableRiskFlags {
  display: flex;
  flex-wrap: wrap;
  gap: density(1);
  margin-top: density(2);
}

.tableRiskFlags span {
  padding: density(1);
  border-radius: 5px;
  background: palette(light-light);
  color: palette(error-main);
  @ds-typo (caption);
  font-size: 9px;
}

.storySourceLink {
  display: flex;
  max-width: 100%;
  align-items: center;
  gap: density(1);
  margin-top: density(2);
  color: palette(primary-main);
  @ds-typo (caption);
  font-size: 9px;
  line-height: 1.3;
  text-decoration: none;
}

.storySourceLink span {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.storySourceLink strong {
  flex: 0 0 auto;
  @ds-typo (caption);
  font-size: 10px;
}

.storySourceLink:hover {
  color: palette(primary-dark);
  text-decoration: underline;
  text-underline-offset: 2px;
}

.tableBadge {
  display: inline-flex;
  padding: density(1) density(2);
  border-radius: 7px;
  @ds-typo (caption);
  font-size: 9px;
  font-weight: 750;
  line-height: 1;
  white-space: nowrap;
}

.tableBadgeNeutral {
  background: palette(light-light);
  color: palette(tertiary-main);
}

.tableBadgePositive {
  background: palette(surface-light);
  color: palette(primary-dark);
}

.tableBadgeWarning {
  background: palette(warning-light);
  color: palette(warning-dark);
}

.tableBadgeNegative {
  background: palette(error-light);
  color: palette(error-main);
}

.publicationStatusCell {
  min-width: 154px;
}

.publicationStatusChips {
  display: flex;
  flex-wrap: wrap;
  gap: density(1);
}

.publicationNotTracked {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 10px;
  font-weight: 650;
  white-space: nowrap;
}

.publicationQuickControl {
  display: grid;
  width: 126px;
  gap: density(1);
}

.publicationQuickControl label {
  display: grid;
  gap: density(1);
}

.publicationQuickControl span,
.publicationQuickControl small {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 9px;
  font-weight: 700;
}

.publicationQuickControl select {
  @ds-input(outlined primary 2);
  width: 100%;
  min-height: 32px;
  padding: 0 density(2);
  border: 1px solid palette(surface-light);
  border-radius: 8px;
  background: palette(light-light);
  color: palette(primary-dark);
  font: inherit;
  @ds-typo (caption);
  font-size: 10px;
  font-weight: 700;
  cursor: pointer;
}

.publicationQuickControl select:focus {
  outline: 2px solid palette(primary-dark, 0.23);
  outline-offset: 1px;
  border-color: palette(primary-main);
}

.publicationQuickControl select:disabled {
  cursor: not-allowed;
  opacity: 0.52;
}

.contentStatusCell,
.contentActionsCell {
  display: flex;
  align-items: flex-start;
  flex-direction: column;
  gap: density(1);
}

.contentStatusCell small {
  max-width: 150px;
  overflow: hidden;
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 9px;
  line-height: 1.35;
  text-overflow: ellipsis;
}

.contentStatusCell .enrichmentComplete {
  color: palette(primary-dark);
}

.contentStatusCell .enrichmentProblem {
  color: palette(error-main);
}

.contentActionsCell {
  min-width: 126px;
}

.prepareTableButton,
.viewContentButton,
.creativeStudioButton,
.promoteStoryButton,
.clearDuplicateButton {
  @ds-button(contained primary 2);
  min-height: 32px;
  padding: 0 density(2);
  border-radius: 8px;
  font: inherit;
  @ds-typo (caption);
  font-size: 10px;
  font-weight: 700;
  white-space: nowrap;
  cursor: pointer;
  transition: transform 150ms ease, opacity 150ms ease;
}

.prepareTableButton {
  border: 1px solid palette(primary-dark);
  background: palette(primary-dark);
  color: palette(light-light);
}

.viewContentButton {
  border: 1px solid palette(surface-light);
  background: palette(light-light);
  color: palette(primary-dark);
}

.creativeStudioButton {
  border: 1px solid palette(warning-dark);
  background: palette(warning-light);
  color: palette(warning-dark);
}

.promoteStoryButton {
  border: 1px solid palette(info-main);
  background: palette(light-light);
  color: palette(info-dark);
}

.clearDuplicateButton {
  border: 1px solid palette(neutral-dark);
  background: palette(light-light);
  color: palette(neutral-dark);
}

.prepareTableButton:hover:not(:disabled),
.viewContentButton:hover:not(:disabled),
.creativeStudioButton:hover:not(:disabled),
.promoteStoryButton:hover:not(:disabled),
.clearDuplicateButton:hover:not(:disabled) {
  transform: translateY(-1px);
}

.prepareTableButton:disabled,
.viewContentButton:disabled,
.creativeStudioButton:disabled,
.promoteStoryButton:disabled,
.clearDuplicateButton:disabled {
  cursor: not-allowed;
  opacity: 0.45;
}

.contentViewerBackdrop {
  position: fixed;
  z-index: 50;
  display: grid;
  padding: xs(density(4)) md(density(5));
  background: palette(dark-main, 0.48);
  inset: 0;
  place-items: center;
  backdrop-filter: blur(6px);
}

.contentViewer {
  display: flex;
  width: min(820px, 100%);
  max-height: xs(calc(100svh - 24px)) md(min(820px, calc(100svh - 48px)));
  overflow: hidden;
  border: 1px solid palette(light-light, 0.68);
  border-radius: xs(16px) md(20px);
  background: palette(light-light);
  flex-direction: column;
  box-shadow: 0 30px 90px palette(dark-main, 0.3);
}

.contentViewerHeader {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: density(6);
  padding: xs(density(5)) md(density(5) density(5) density(4));
  border-bottom: 1px solid palette(surface-light);
}

.contentViewerHeader p,
.contentViewerHeader h2 {
  margin: 0;
}

.contentViewerHeader p {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 10px;
  font-weight: 750;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.contentViewerHeader h2 {
  max-width: 680px;
  margin-top: density(2);
  color: palette(dark-main);
  @ds-typo (h2);
  font-size: xs(17px) sm(21px);
  line-height: 1.28;
  letter-spacing: -0.035em;
}

.contentViewerHeader button {
  display: grid;
  width: 34px;
  height: 34px;
  flex: 0 0 auto;
  border: 1px solid palette(surface-light);
  border-radius: 50%;
  background: palette(light-light);
  color: palette(primary-dark);
  @ds-typo (h3);
  font-size: 22px;
  line-height: 1;
  cursor: pointer;
  place-items: center;
}

.contentViewerMeta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: density(1);
  padding: density(3) density(5);
  border-bottom: 1px solid palette(surface-light);
  background: palette(light-light);
}

.contentViewerMeta > span:not(.tableBadge) {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 10px;
}

.contentViewerWarning {
  display: flex;
  gap: density(1);
  padding: density(3) density(5);
  border-bottom: border(1, palette(warning-main), solid);
  background: palette(warning-light);
  color: palette(warning-dark);
  flex-direction: column;
}

.contentViewerWarning strong {
  @ds-typo (small);
  font-size: 12px;
}

.contentViewerWarning span {
  @ds-typo (caption);
  font-size: 11px;
  line-height: 1.45;
}

.contentViewerBody {
  overflow: auto;
  padding: density(5);
}

.contentViewerBody > p {
  margin: 0;
  color: palette(dark-main);
  @ds-typo (small);
  font-size: 14px;
  line-height: 1.75;
  white-space: pre-wrap;
}

.contentViewerFooter {
  display: flex;
  align-items: xs(flex-start) sm(center);
  flex-direction: xs(column) sm(row);
  justify-content: space-between;
  gap: density(5);
  padding: density(4) density(5);
  border-top: 1px solid palette(surface-light);
  background: palette(light-light);
}

.contentViewerFooter a {
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 11px;
  font-weight: 750;
  text-decoration: none;
}

.contentViewerFooter a:hover {
  text-decoration: underline;
  text-underline-offset: 3px;
}

.contentViewerFooter span {
  color: palette(tertiary-main);
  @ds-typo (caption);
  font-size: 10px;
}

.dangerPanel {
  display: grid;
  grid-template-columns: xs(1fr) md(1fr minmax(360px, 0.8fr));
  gap: xs(density(4)) md(density(9));
  margin-top: xs(density(4)) md(density(5));
  border-color: palette(error-main, 0.2);
  background: palette(light-light, 0.86);
}

.dangerCopy h2 {
  margin-top: density(3);
}

.dangerCopy > p:last-child {
  max-width: 530px;
  margin: density(3) 0 0;
  color: palette(error-main);
  @ds-typo (small);
  font-size: 13px;
  line-height: 1.6;
}

.dangerActions .field {
  margin-top: 0;
}

.dangerButton {
  border: 1px solid palette(error-light);
  background: palette(light-light);
  color: palette(error-main);
}

.regenerateButton {
  flex: 1;
  border: 1px solid palette(error-main);
  background: palette(error-main);
  color: palette(light-light);
}


/* Topic Overview — FEAT-OVW-001 / OVW-02 ---------------------------------- */

.ovwRoot {
  display: flex;
  flex-direction: column;
  gap: density(4);
}

.ovwHeader {
  display: flex;
  flex-direction: xs(column) md(row);
  align-items: xs(stretch) md(flex-end);
  justify-content: space-between;
  gap: density(4);
  padding-bottom: density(4);
  border-bottom: 1px solid palette(dark-main, 0.12);
}

.ovwHeaderMain {
  display: flex;
  flex-direction: column;
  gap: density(2);
  min-width: 0;
}

.ovwTitle {
  margin: 0;
  color: palette(primary-main);
  @ds-typo (h2);
  letter-spacing: -0.04em;
}

.ovwDescription {
  margin: 0;
  max-width: 46rem;
  color: palette(dark-main, 0.78);
  @ds-typo (body);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.ovwHeaderMeta {
  display: flex;
  flex-direction: column;
  align-items: xs(flex-start) md(flex-end);
  gap: density(2);
  flex: none;
}

.ovwPeriod {
  display: inline-flex;
  gap: density(2);
}

.ovwPeriodButton {
  @ds-button(flat neutral 2);
  @ds-typo (caption);
  font-weight: 650;
  cursor: pointer;
}

.ovwPeriodButton:disabled {
  opacity: 0.55;
  cursor: default;
}

.ovwPeriodButtonActive {
  @ds-button(contained primary 2);
  @ds-typo (caption);
  font-weight: 650;
}

.ovwFreshness {
  margin: 0;
  color: palette(tertiary-main);
  @ds-typo (caption);
}

.ovwHeaderActions {
  display: inline-flex;
  gap: density(2);
  align-items: center;
}

.ovwRefreshButton {
  @ds-button(outlined neutral 2);
  border-radius: radius(pill);
  @ds-typo (caption);
  font-weight: 650;
  cursor: pointer;
}

.ovwRefreshButton:disabled {
  opacity: 0.55;
  cursor: default;
}

.ovwConfigLink {
  color: palette(primary-main);
  @ds-typo (caption);
  font-weight: 650;
  text-decoration: none;
}

.ovwConfigLink:hover {
  text-decoration: underline;
}

.ovwMetrics {
  display: grid;
  grid-template-columns: xs(1fr) sm(repeat(2, minmax(0, 1fr))) md(repeat(4, minmax(0, 1fr)));
  gap: density(3);
}

.ovwMetricCard {
  @ds-surface(contained surface 3);
  display: flex;
  flex-direction: column;
  gap: density(1);
  padding: density(4);
  border: 1px solid palette(dark-main, 0.1);
  background: palette(light-light, 0.82);
  box-shadow: shadow(1);
}

.ovwMetricHeader {
  display: flex;
  align-items: center;
  gap: density(2);
}

.ovwMetricIcon {
  display: inline-grid;
  place-items: center;
  width: density(5);
  height: density(5);
  border-radius: radius(2);
  background: palette(primary-main, 0.14);
  color: palette(primary-dark);
  @ds-typo (caption);
}

.ovwMetricLabel {
  color: palette(dark-main, 0.7);
  @ds-typo (caption);
  font-weight: 650;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.ovwMetricValue {
  color: palette(dark-main);
  @ds-typo (h2);
  letter-spacing: -0.05em;
}

.ovwMetricScope {
  color: palette(tertiary-main);
  @ds-typo (caption);
}

.ovwMetricLink {
  color: palette(primary-main);
  @ds-typo (caption);
  font-weight: 650;
  text-decoration: none;
}

.ovwMetricLink:hover {
  text-decoration: underline;
}

.ovwMetricBreakdown {
  margin: density(1) 0 0;
  color: palette(dark-main, 0.68);
  @ds-typo (caption);
}

.ovwSections {
  display: grid;
  grid-template-columns: xs(1fr) lg(repeat(2, minmax(0, 1fr)));
  gap: density(3);
}

.ovwSection {
  @ds-surface(contained surface 3);
  display: flex;
  flex-direction: column;
  gap: density(3);
  padding: density(5);
  border: 1px solid palette(dark-main, 0.1);
  background: palette(light-light, 0.82);
  box-shadow: shadow(1);
}

.ovwSectionTitle {
  margin: 0;
  color: palette(dark-main);
  @ds-typo (h4);
  font-weight: 650;
}

.ovwSectionBody {
  display: flex;
  flex-direction: column;
  gap: density(2);
}

.ovwSkeleton {
  display: flex;
  flex-direction: column;
  gap: density(3);
}

.ovwSkeletonLine {
  height: density(5);
  border-radius: radius(2);
  background: linear-gradient(
    90deg,
    palette(dark-main, 0.06),
    palette(dark-main, 0.12),
    palette(dark-main, 0.06)
  );
}

.ovwSkeletonLine:nth-child(2) {
  width: 72%;
}

.ovwSkeletonLine:nth-child(3) {
  width: 54%;
}

.ovwEmpty {
  margin: 0;
  color: palette(tertiary-main);
  @ds-typo (small);
}

.ovwError {
  display: flex;
  flex-direction: xs(column) sm(row);
  align-items: xs(flex-start) sm(center);
  gap: density(2);
  padding: density(3);
  border: 1px solid palette(error-main, 0.4);
  border-radius: radius(2);
  background: palette(error-light, 0.16);
  color: palette(error-dark);
  @ds-typo (small);
}

.ovwRetryButton {
  @ds-button(flat primary 1);
  @ds-typo (caption);
  font-weight: 700;
  cursor: pointer;
}

.ovwRetryButton:hover {
  text-decoration: underline;
}

.ovwList {
  display: flex;
  flex-direction: column;
  gap: density(2);
  margin: 0;
  padding: 0;
  list-style: none;
}

.ovwListItem {
  display: flex;
  flex-direction: column;
  gap: density(1);
  padding-bottom: density(2);
  border-bottom: 1px solid palette(dark-main, 0.08);
}

.ovwListItem:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.ovwListPrimary {
  color: palette(dark-main);
  @ds-typo (small);
  font-weight: 600;
}

.ovwListMeta {
  color: palette(tertiary-main);
  @ds-typo (caption);
}

.ovwListLink {
  color: palette(primary-main);
  font-weight: 650;
  text-decoration: none;
}

.ovwListLink:hover {
  text-decoration: underline;
}

.ovwStages {
  display: grid;
  grid-template-columns: xs(repeat(2, minmax(0, 1fr))) sm(repeat(5, minmax(0, 1fr)));
  gap: density(2);
}

.ovwStage {
  display: flex;
  flex-direction: column;
  gap: density(1);
  padding: density(2);
  border-radius: radius(2);
  background: palette(dark-main, 0.04);
}

.ovwStageValue {
  color: palette(dark-main);
  @ds-typo (h4);
  font-weight: 640;
}

.ovwStageLabel {
  color: palette(tertiary-main);
  @ds-typo (caption);
}

.ovwBadge {
  display: inline-flex;
  align-items: center;
  padding: density(1) density(2);
  border-radius: radius(pill);
  background: palette(primary-main, 0.14);
  color: palette(primary-dark);
  @ds-typo (caption);
  font-weight: 650;
}

.ovwBadgeMuted {
  background: palette(dark-main, 0.08);
  color: palette(dark-main, 0.7);
}

.storyMaterials {
  @ds-surface(flat neutral);
  border-radius: radius(2);
  padding: density(3);
  display: grid;
  gap: density(2);
  min-width: 0;
  color: palette(neutral-main);
}
.storyMaterialForm {
  display: grid;
  gap: density(3);
}
.storyMaterialForm label, .storyPhotoCard label {
  display: grid;
  gap: density(1);
  @ds-typo(body);
}
.storyMaterialForm input:not([type="checkbox"]), .storyMaterialForm textarea, .storyPhotoCard select {
  @ds-input(outlined neutral);
  padding: density(2);
  border-radius: radius(2);
  width: 100%;
}
.storyMaterials button, .storyMaterialForm button {
  @ds-button(outlined primary);
  padding: density(2);
  border-radius: radius(2);
}
.storyPhotoGrid {
  display: grid;
  grid-template-columns: xs(1fr) md(repeat(2, minmax(0, 1fr))) xl(repeat(3, minmax(0, 1fr)));
  gap: density(2);
}
.storyPhotoCard {
  @ds-surface(contained light);
  border-radius: radius(2);
  box-shadow: shadow(1);
  color: palette(dark-main);
  padding: density(2);
  display: grid;
  align-content: start;
  gap: density(2);
  overflow-wrap: anywhere;
}
.storyPhotoPreview {
  width: 100%;
  height: auto;
  aspect-ratio: 3 / 2;
  object-fit: contain;
  border-radius: radius(2);
}

.storyMaterialForm :focus-visible, .storyMaterials :focus-visible {
  outline: border(2, palette(primary-main), solid);
  outline-offset: density(1);
}
.storyMaterials button:disabled, .storyMaterialForm button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.dailyPlanner {
  @ds-surface(contained light);
  padding: density(5);
  margin-bottom: density(4);
  border: border(1, palette(neutral-light), solid);
  border-radius: radius(3);
  color: palette(neutral-main);
  display: grid;
  gap: density(3);
}
.dailyPlanner h2 { @ds-typo(h5); color: palette(primary-main); }
.dailyPlanner h3 { @ds-typo(h6); }
.dailyPlanner p, .dailyPlanner li { @ds-typo(body); }
.dailyPlanner small { @ds-typo(caption); }
.dailyPlannerHeader {
  display: grid;
  grid-template-columns: xs(1fr) lg(2fr 1fr);
  gap: density(4);
  align-items: start;
}
.dailyPlannerControls { display: grid; gap: density(2); }
.dailyPlannerControls label { display: grid; gap: density(1); @ds-typo(body); }
.dailyPlannerControls input, .dailyPlannerControls select { @ds-input(outlined neutral); padding: density(2); border-radius: radius(2); width: 100%; }
.dailyPlannerChoices { display: grid; grid-template-columns: xs(1fr) md(repeat(3, 1fr)); gap: density(3); }
.dailyPlannerChoice {
  @ds-surface(flat primary);
  border: border(1, palette(primary-light), solid);
  padding: density(3);
  border-radius: radius(2);
  display: flex;
  flex-direction: column;
  gap: density(2);
  min-width: 0;
}
.dailyPlannerActions {
  display: flex;
  flex-wrap: wrap;
  gap: density(2);
  margin-top: auto;
}

/* Compact chip row: 10 steps need to read as one clear sequence, not a wall
   of large cards. Each chip is a single line (number/check + short title);
   the full running status lives in .dailyPreparationStatusLine below. */
.dailyPreparationSteps {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: density(2);
  padding: density(1) 0;
  list-style: none;
}
.dailyPreparationSteps li {
  display: contents;
}
.dailyPreparationStepButton {
  @ds-button(outlined primary);
  @ds-typo(caption);
  display: inline-flex;
  align-items: center;
  gap: density(2);
  padding: density(2) density(3);
  border-radius: radius(full);
  font-weight: 650;
  white-space: nowrap;
  cursor: pointer;
  box-shadow: none;
  transition: box-shadow 0.15s ease, transform 0.15s ease, background 0.15s ease;
}
.dailyPreparationStepButton span {
  display: inline-grid;
  min-width: 16px;
  height: 16px;
  place-items: center;
  border-radius: radius(full);
  background: palette(primary-light, 0.16);
  font-size: 10px;
  line-height: 1;
}
/* A step in progress still gets the current-step highlight around the chip. */
.dailyPreparationSteps li[aria-current="step"] .dailyPreparationStepButton {
  box-shadow: shadow(2);
}
.dailyPreparationStepButton:hover:not(:disabled) {
  box-shadow: shadow(2);
  transform: translateY(-1px);
}
.dailyPreparationStepButton:active:not(:disabled) {
  transform: translateY(0);
  box-shadow: none;
}
.dailyPreparationStepButton:disabled {
  cursor: not-allowed;
  box-shadow: none;
  opacity: 0.55;
}
/* Color by status — matches the four states daily-preparation-panel.tsx
   computes (data-step-status): finished with something to review, finished
   with nothing further to open, actively running, and needing a retry.
   "done"/"done-open" deliberately use palette(primary-*), the active Topic's
   brand color (see src/design/topic-themes.ts), instead of the universal
   success-green most design systems use for a checkmark — an explicit choice
   to have completed steps read as "this Topic's work", not a generic done
   state. Trade-off, on the record: for any Topic whose own primary is
   itself blue/teal (several are, per today's live palette check), "done"
   and "running" (palette(info-*), always blue) can look close to each other
   at a glance — accepted knowingly, not missed. */
.dailyPreparationStepButton[data-step-status="done-open"] {
  border-color: palette(primary-main);
  background: palette(primary-light, 0.18);
  color: palette(primary-dark);
}
.dailyPreparationStepButton[data-step-status="done"] {
  border-color: palette(primary-light);
  background: palette(primary-light, 0.08);
  color: palette(primary-dark);
}
.dailyPreparationStepButton[data-step-status="running"] {
  border-color: palette(info-main);
  background: palette(info-light, 0.18);
  color: palette(info-dark);
}
.dailyPreparationStepButton[data-step-status="attention"] {
  border-color: palette(warning-main);
  background: palette(warning-light, 0.2);
  color: palette(warning-dark);
}
.dailyPreparationStepButton[data-step-status="todo"] {
  border-color: palette(primary-light);
}

/* The one place that always spells out exactly what's happening right now —
   compact chips above trade their old subtitle line for this. */
.dailyPreparationStatusLine {
  @ds-typo(body);
  padding: density(3) density(4);
  border-radius: radius(2);
  font-weight: 650;
  border: border(1, palette(info-light), solid);
  background: palette(info-light, 0.12);
  color: palette(info-dark);
}
.dailyPreparationStatusLine[data-run-status="completed"] {
  border-color: palette(success-light);
  background: palette(success-light, 0.14);
  color: palette(success-dark);
}
.dailyPreparationStatusLine[data-run-status="needs-review"] {
  border-color: palette(warning-main);
  background: palette(warning-light, 0.2);
  color: palette(warning-dark);
}
.dailyPreparationStatusLine[data-run-status="failed"] {
  border-color: palette(error-main);
  background: palette(error-light, 0.16);
  color: palette(error-dark);
}

.acquisitionLenses {
  @ds-surface(contained 4);
  display: grid;
  gap: density(4);
  border: 1px solid palette(surface-dark);
}

.acquisitionLenses header {
  display: grid;
  gap: density(1);
}

.acquisitionLenses header h2 {
  @ds-typo(h3);
  margin: 0;
  color: palette(primary-dark);
}

.acquisitionLenses header p {
  @ds-typo(body);
  margin: 0;
  color: palette(tertiary-dark);
}

.acquisitionLenses header small,
.acquisitionLensSummary {
  @ds-typo(small);
  color: palette(tertiary-main);
}

.acquisitionLenses [role="alert"] {
  @ds-typo(small);
  margin: 0;
  color: palette(error-dark);
}

.acquisitionLenses [role="status"] {
  @ds-typo(small);
  margin: 0;
  color: palette(success-dark);
}

.acquisitionLensList {
  display: grid;
  gap: density(3);
  margin: 0;
  padding: 0;
  list-style: none;
}

.acquisitionLensList li {
  @ds-surface(flat light 3);
  display: grid;
  gap: density(2);
  border: 1px solid palette(surface-light);
}

.acquisitionLensList li[data-enabled="no"] {
  opacity: 0.6;
}

.acquisitionLensHead {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: density(3);
}

.acquisitionLensHead code {
  @ds-typo(code);
  color: palette(primary-main);
}

.acquisitionLensHead label,
.acquisitionLensMeta label,
.acquisitionLensList li > label {
  @ds-typo(small);
  display: grid;
  gap: density(1);
  color: palette(tertiary-dark);
}

.acquisitionLensHead label {
  display: flex;
  align-items: center;
  gap: density(1);
}

.acquisitionLensMeta {
  display: grid;
  grid-template-columns: xs(1fr) md(repeat(2, 1fr));
  gap: density(3);
}

.acquisitionLensList input,
.acquisitionLensList textarea,
.acquisitionLensList select {
  @ds-input(outlined neutral 2);
  width: 100%;
  font: inherit;
}

.acquisitionLensHead input[type="checkbox"],
.acquisitionLensHead input[type="radio"] {
  width: auto;
  appearance: auto;
}

/* ---------------------------------------------------------------------------
 * Global "New story" entry point (FEAT-SRC-001, SRC-01).
 * The dialog reuses .contentViewerBackdrop / .contentViewer / .contentViewerHeader
 * and .field; these classes only add the form layout and the top-bar button.
 * ------------------------------------------------------------------------- */

.newStoryButton {
  @ds-button(outlined primary 2);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: density(1);
  width: 100%;
  min-height: 32px;
  padding: 0 density(3);
  border-color: palette(primary-main, 0.28);
  background: palette(primary-main, 0.1);
  color: palette(primary-dark);
  @ds-typo (caption);
  font-size: 0.75rem;
  font-weight: 650;
  white-space: nowrap;
  cursor: pointer;
  transition: background 150ms ease, border-color 150ms ease, opacity 150ms ease;
}

.newStoryButton:hover:not(:disabled) {
  border-color: palette(primary-main, 0.5);
  background: palette(primary-main, 0.16);
}

.addSourceButton {
  border-color: palette(dark-main, 0.12);
  background: transparent;
}

.addSourceButton:hover:not(:disabled) {
  border-color: palette(dark-main, 0.2);
  background: palette(dark-main, 0.04);
}

.newStoryButton:disabled {
  cursor: not-allowed;
  opacity: 0.45;
}

.newStoryButton > span {
  @ds-typo (caption);
  font-size: 0.875rem;
  line-height: 1;
  opacity: 0.8;
}

.newStoryForm {
  display: flex;
  min-height: 0;
  flex: 1 1 auto;
  flex-direction: column;
  gap: density(4);
  padding: xs(density(4)) md(density(5));
  overflow: auto;
}

.newStoryHint,
.newStoryError {
  margin: 0;
  @ds-typo (small);
  font-size: 0.8125rem;
  line-height: 1.5;
}

.newStoryHint {
  color: palette(tertiary-main);
}

.newStoryError {
  padding: density(3) density(4);
  border: 1px solid palette(error-main, 0.35);
  border-radius: radius(2);
  background: palette(error-light);
  color: palette(error-dark);
}

.newStoryGrid {
  display: grid;
  grid-template-columns: xs(minmax(0, 1fr)) md(repeat(2, minmax(0, 1fr)));
  gap: xs(density(3)) md(density(4));
}

.newStoryGrid .field {
  margin-top: 0;
  min-width: 0;
}

.newStoryWide {
  grid-column: xs(auto) md(1 / -1);
}

.newStoryGrid select,
.newStoryGrid textarea {
  @ds-input(outlined primary 2);
  width: 100%;
  border-color: palette(surface-dark);
  background: palette(light-light, 0.84);
  color: palette(dark-main);
  transition: border-color 160ms ease, box-shadow 160ms ease;
}

.newStoryGrid select {
  height: 48px;
  padding: 0 density(4);
}

.newStoryGrid textarea {
  min-height: 180px;
  padding: density(3) density(4);
  resize: vertical;
  line-height: 1.5;
}

.newStoryGrid select:focus,
.newStoryGrid textarea:focus {
  border-color: palette(primary-main);
  box-shadow: 0 0 0 4px palette(primary-main, 0.12);
  outline: none;
}

.newStoryFooter {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: density(3);
  margin-top: density(2);
  padding-top: density(4);
  border-top: 1px solid palette(surface-light);
}

.newStoryFooter button {
  min-height: 45px;
  padding: 0 density(5);
  @ds-typo (small);
  font-size: 0.8125rem;
  font-weight: 700;
  cursor: pointer;
}

.newStoryFooter .primaryButton {
  flex: 0 0 auto;
}

.newStoryFooter button:disabled {
  cursor: not-allowed;
  opacity: 0.42;
}

.sourceDropZone {
  @ds-typo(small);
  display: grid;
  gap: density(2);
  border: border(1, surface-dark, dashed);
  border-radius: radius(3);
  background: palette(light-light);
  padding: density(4);
  color: palette(dark-main);
}

.sourceDropZone input { @ds-input(outlined primary 2); width: 100%; }

.sourceTopicChoices {
  display: flex;
  flex-wrap: wrap;
  gap: density(3);
  border: border(1, surface-dark, solid);
  border-radius: radius(3);
  padding: density(3);
}

.sourceTopicChoices legend { @ds-typo(caption); color: palette(tertiary-main); }
.sourceTopicChoices label { @ds-typo(small); display: flex; align-items: center; gap: density(2); color: palette(dark-main); }
.sourceTopicChoices input[type="checkbox"] { accent-color: palette(primary-main); }

.sourcePreview {
  @ds-surface(outlined surface 3);
  display: grid;
  gap: density(2);
  padding: density(4);
}

.sourcePreview strong { @ds-typo(body); color: palette(dark-main); }
.sourcePreview span,
.sourcePreview p,
.sourcePreview small { @ds-typo(small); margin: 0; overflow-wrap: anywhere; color: palette(tertiary-main); }
