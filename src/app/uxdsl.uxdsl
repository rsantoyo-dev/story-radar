/* Global palette, spacing, and font tokens are emitted from uxdsl.config.js. */

/*
 * Document-level reset. This lives in the theme entry — not a separate
 * hand-written stylesheet — so the app's only non-component-scoped CSS still
 * goes through the same uxdsl pipeline as every panel, using its Palette
 * functions instead of hand-typed --uxdsl__* variable names.
 */
:root {
  --background: palette(light-main);
  --foreground: palette(dark-main);
}

html,
body {
  min-height: 100%;
}

html {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  @ds-typo (document);
  margin: 0;
  display: flex;
  flex-direction: column;
  background: var(--background);
  color: var(--foreground);
  /* Next/font's own variable, with the same fallback chain the theme's `ui`
   * font family already resolves to — kept explicit since no uxdsl function
   * wraps a bare font-family the way palette()/density() wrap a token. */
}

* {
  box-sizing: border-box;
}

/*
 * One focus treatment for every focusable element. Button and Input roles
 * carry the same ring in their own focus-visible state; components that show
 * focus another way (a fill, a field ring) set it explicitly and win, since
 * :where() adds no specificity.
 */
:where(a, button, summary, select, textarea, input, [tabindex]):focus-visible {
  outline: border(focus);
  outline-offset: space(1);
}

button,
input {
  font: inherit;
}
