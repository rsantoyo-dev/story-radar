{
  "name": "press-craftor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run uxdsl:build && concurrently --kill-others-on-fail \"npm run uxdsl:watch\" \"next dev\"",
    "dev:https": "npm run uxdsl:build && concurrently --kill-others-on-fail \"npm run uxdsl:watch\" \"next dev --experimental-https\"",
    "build": "npm run uxdsl:build && next build --webpack",
    "start": "next start",
    "worker:instagram": "node scripts/instagram-publication-worker.mjs",
    "postinstall": "patch-package",
    "test": "node --import tsx --test src/app/modules/stories/*.test.ts src/app/modules/documents/*.test.ts src/app/modules/meta/*.test.ts src/app/modules/topics/*.test.ts src/app/modules/sources/*.test.ts src/design/*.test.ts src/design/*/*.test.ts",
    "uxdsl:build": "uxdsl build",
    "uxdsl:watch": "uxdsl watch",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "worker:daily": "node scripts/daily-preparation-worker.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@better-auth/drizzle-adapter": "^1.7.6",
    "@fal-ai/client": "^1.10.1",
    "@google/genai": "^2.17.1",
    "@mozilla/readability": "^0.6.0",
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.7.6",
    "cloudflare": "^7.1.0",
    "drizzle-orm": "^0.45.2",
    "groq-sdk": "^1.6.0",
    "jsdom": "^27.2.0",
    "next": "^16.3.5",
    "openai": "^6.49.0",
    "pdfjs-dist": "^5.4.624",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@next/env": "^16.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.4",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "patch-package": "^8.0.1",
    "postcss-uxdsl": "0.5.0-beta.6",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "uxdsl-cli": "0.5.0-beta.6",
    "uxdsl-core": "0.5.0-beta.6",
    "vite-plugin-uxdsl": "0.5.0-beta.6"
  }
}
