{
  "name": "press-craftor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run uxdsl:build && concurrently --kill-others-on-fail \"npm run uxdsl:watch\" \"next dev\"",
    "build": "npm run uxdsl:build && next build",
    "start": "next start",
    "test": "tsx --test src/app/modules/stories/*.test.ts src/app/modules/documents/*.test.ts",
    "uxdsl:build": "npm run uxdsl:build:theme && npm run uxdsl:build:dashboard && npm run uxdsl:build:creative && npm run uxdsl:build:editorial && npm run uxdsl:build:topic",
    "uxdsl:build:theme": "uxdsl build --config uxdsl.theme.config.cjs",
    "uxdsl:build:dashboard": "uxdsl build --config uxdsl.config.cjs",
    "uxdsl:build:creative": "uxdsl build --config uxdsl.creative.config.cjs",
    "uxdsl:build:editorial": "uxdsl build --config uxdsl.editorial.config.cjs",
    "uxdsl:build:topic": "uxdsl build --config uxdsl.topic.config.cjs",
    "uxdsl:watch": "concurrently --kill-others-on-fail \"npm run uxdsl:watch:theme\" \"npm run uxdsl:watch:dashboard\" \"npm run uxdsl:watch:creative\" \"npm run uxdsl:watch:editorial\" \"npm run uxdsl:watch:topic\"",
    "uxdsl:watch:theme": "uxdsl watch --config uxdsl.theme.config.cjs",
    "uxdsl:watch:dashboard": "uxdsl watch --config uxdsl.config.cjs",
    "uxdsl:watch:creative": "uxdsl watch --config uxdsl.creative.config.cjs",
    "uxdsl:watch:editorial": "uxdsl watch --config uxdsl.editorial.config.cjs",
    "uxdsl:watch:topic": "uxdsl watch --config uxdsl.topic.config.cjs",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@fal-ai/client": "^1.10.1",
    "@google/genai": "^2.17.1",
    "@mozilla/readability": "^0.6.0",
    "@neondatabase/serverless": "^1.1.0",
    "cloudflare": "^7.1.0",
    "drizzle-orm": "^0.45.2",
    "groq-sdk": "^1.6.0",
    "jsdom": "^27.2.0",
    "next": "16.3.0",
    "openai": "^6.49.0",
    "pdfjs-dist": "^5.4.624",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@next/env": "^16.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "postcss-uxdsl": "^0.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "uxdsl-cli": "^0.3.0",
    "uxdsl-core": "^0.3.0",
    "vite-plugin-uxdsl": "^0.3.0"
  }
}
